#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ЕстьВыдачаПоПродаже(ДокументПродажа) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Выдача.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВыдачаТовара КАК Выдача
	|ГДЕ
	|	Выдача.ДокументПродажа = &ДокументПродажа
	|	И НЕ Выдача.ПометкаУдаления";
	Запрос.УстановитьПараметр("ДокументПродажа", ДокументПродажа);
	Возврат НЕ Запрос.Выполнить().Пустой();
КонецФункции

// Параметры:
// Ссылка - ДокументСсылка.ВыдачаТовара
// Возвращаемое значение:
// ТаблицаЗначений
&НаСервере
Функция Печать(Ссылка) Экспорт
	Акт=ПечатьАкта(Ссылка.ПолучитьОбъект());
	Талон=ПечатьГарантийногоТалона(Ссылка.ПолучитьОбъект());
	ДокументыДляПечати = МодульПечати.СоздатьКоллекциюДокументовДляПечати();
	Документ = ДокументыДляПечати.Добавить();
	Документ.ИмяДокумента = "Акт приема-передачи";
	Документ.Документ = Акт;
	Документ = ДокументыДляПечати.Добавить();
	Документ.ИмяДокумента = "Гарантийный талон";
	Документ.Документ = Талон;
	Возврат ДокументыДляПечати;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры:
// ДокументОбъект - ДокументОбъект.ВыдачаТовара
Функция ПечатьГарантийногоТалона(ДокументОбъект) Экспорт
	Макет = Документы.ВыдачаТовара.ПолучитьМакет("ГарантийныйТалон");
	ТабличныйДокумент = Новый ТабличныйДокумент;
	Продажа = ДокументОбъект.ДокументПродажа;
	Покупатель = "";
	Склад = "";
	ДокументПродажи = "";
	Если ЗначениеЗаполнено(Продажа) Тогда
		ДокументПродажи = Строка(Продажа);
		Склад = Строка(Продажа.Склад);
		Если ЗначениеЗаполнено(Продажа.Контрагент) Тогда
			Покупатель = Строка(Продажа.Контрагент);
		КонецЕсли;
	КонецЕсли;
	Продавец = "Магазин электроники";
	Если ЗначениеЗаполнено(Склад) Тогда
		Продавец = Продавец + ", " + Склад;
	КонецЕсли;
	Шапка = Макет.ПолучитьОбласть("Шапка");
	Шапка.Параметры.Номер = ДокументОбъект.Номер;
	Шапка.Параметры.Дата = Формат(ДокументОбъект.Дата, "ДЛФ=D");
	Шапка.Параметры.Продавец = Продавец;
	Шапка.Параметры.Покупатель = Покупатель;
	Шапка.Параметры.ДокументПродажи = ДокументПродажи;
	ТабличныйДокумент.Вывести(Шапка);
	ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("ШапкаТаблицы"));
	НомерСтроки = 0;
	Для Каждого СтрокаТовара Из ДокументОбъект.Товары Цикл
		НомерСтроки = НомерСтроки + 1;
		СрокГарантии = 0;
		Если ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
			СрокГарантии = СтрокаТовара.Номенклатура.СрокГарантии;
		КонецЕсли;
		ОбластьСтроки = Макет.ПолучитьОбласть("Строка");
		ОбластьСтроки.Параметры.НомерСтроки = НомерСтроки;
		ОбластьСтроки.Параметры.Номенклатура = Строка(СтрокаТовара.Номенклатура);
		ОбластьСтроки.Параметры.Количество = СтрокаТовара.Количество;
		ОбластьСтроки.Параметры.СрокГарантии = СрокГарантии;
		ТабличныйДокумент.Вывести(ОбластьСтроки);
	КонецЦикла;
	Подвал = Макет.ПолучитьОбласть("Подвал");
	Подвал.Параметры.Покупатель = Покупатель;
	Подвал.Параметры.Кладовщик = Строка(ДокументОбъект.Кладовщик);
	ТабличныйДокумент.Вывести(Подвал);
	Возврат ТабличныйДокумент;
КонецФункции

// Параметры:
// ДокументОбъект - ДокументОбъект.ВыдачаТовара
Функция ПечатьАкта(ДокументОбъект)
	Макет = Документы.ВыдачаТовара.ПолучитьМакет("АктПриемаПередачи");
	ТабличныйДокумент = Новый ТабличныйДокумент;
	Продажа = ДокументОбъект.ДокументПродажа;
	Контрагент = "";
	Склад = "";
	Представитель = "";
	Если ЗначениеЗаполнено(Продажа) Тогда
		Склад = Строка(Продажа.Склад);
		Если ЗначениеЗаполнено(Продажа.Контрагент) Тогда
			Контрагент = Строка(Продажа.Контрагент);
			Представитель = Продажа.Контрагент.ФИОРуководителя;
		КонецЕсли;
	КонецЕсли;
	Шапка = Макет.ПолучитьОбласть("Шапка");
	Шапка.Параметры.Дата = Формат(ТекущаяДатаСеанса(), "ДЛФ=D");
	Шапка.Параметры.Контрагент = Контрагент;
	Шапка.Параметры.Склад = Склад;
	ТабличныйДокумент.Вывести(Шапка);
	Итого = 0;
	НомерСтроки = 0;
	Для Каждого СтрокаТовара Из ДокументОбъект.Товары Цикл
		НомерСтроки = НомерСтроки + 1;
		СуммаСтроки = СтрокаТовара.Количество * СтрокаТовара.Цена;
		Итого = Итого + СуммаСтроки;
		ОбластьСтроки = Макет.ПолучитьОбласть("Строка");
		ОбластьСтроки.Параметры.НомерСтроки = НомерСтроки;
		ОбластьСтроки.Параметры.Номенклатура = Строка(СтрокаТовара.Номенклатура);
		ОбластьСтроки.Параметры.Количество = СтрокаТовара.Количество;
		ОбластьСтроки.Параметры.Цена = Формат(СтрокаТовара.Цена, "ЧДЦ=2");
		ОбластьСтроки.Параметры.Сумма = Формат(СуммаСтроки, "ЧДЦ=2");
		ТабличныйДокумент.Вывести(ОбластьСтроки);
	КонецЦикла;
	Подвал = Макет.ПолучитьОбласть("Подвал");
	Подвал.Параметры.Итого = Формат(Итого, "ЧДЦ=2");
	Подвал.Параметры.Кладовщик = Строка(ДокументОбъект.Кладовщик);
	Подвал.Параметры.Представитель = Представитель;
	ТабличныйДокумент.Вывести(Подвал);
	Возврат ТабличныйДокумент;
КонецФункции

#КонецОбласти

#КонецЕсли
