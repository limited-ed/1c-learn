#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Если НЕ ЗначениеЗаполнено(Кладовщик) Тогда
		Кладовщик = Документы.Продажа.РаботникТекущегоПользователя();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДокументПродажа) Тогда
		Отказ = Истина;
		СообщитьПользователю("Укажите документ продажи.");
		Возврат;
	КонецЕсли;
	Если Товары.Количество() = 0 Тогда
		Отказ = Истина;
		СообщитьПользователю("Заполните товары.");
		Возврат;
	КонецЕсли;
	Магазин = ДокументПродажа.Магазин;
	Если НЕ ЗначениеЗаполнено(Магазин) Тогда
		Отказ = Истина;
		СообщитьПользователю("В документе продажи не заполнен Магазин.");
		Возврат;
	КонецЕсли;
	КоличествоПоНоменклатуре = Новый Соответствие;
	Для Каждого СтрокаТовара Из Товары Цикл
		Если СтрокаТовара.Количество <= 0 Тогда
			Отказ = Истина;
			СообщитьПользователю("Количество в строке должно быть больше нуля.");
			Возврат;
		КонецЕсли;
		УжеЕсть = КоличествоПоНоменклатуре.Получить(СтрокаТовара.Номенклатура);
		Если УжеЕсть = Неопределено Тогда
			УжеЕсть = 0;
		КонецЕсли;
		КоличествоПоНоменклатуре.Вставить(СтрокаТовара.Номенклатура, УжеЕсть + СтрокаТовара.Количество);
	КонецЦикла;
	Остатки = ОстаткиРезерва(Магазин);
	Для Каждого КлючИЗначение Из КоличествоПоНоменклатуре Цикл
		СтрокаОстатка = Остатки.Найти(КлючИЗначение.Ключ, "Номенклатура");
		Остаток = 0;
		Если СтрокаОстатка <> Неопределено Тогда
			Остаток = СтрокаОстатка.КоличествоОстаток;
		КонецЕсли;
		Если КлючИЗначение.Значение > Остаток Тогда
			Отказ = Истина;
			СообщитьПользователю(СтрШаблон(
				"По номенклатуре %1 в резерве продажи на Магазине %2 остаток %3, к выдаче %4.",
				КлючИЗначение.Ключ,
				Магазин,
				Остаток,
				КлючИЗначение.Значение));
		КонецЕсли;
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Движения.РезервНоменклатуры.Записывать = Истина;
	Контрагент = ДокументПродажа.Контрагент;
	Для Каждого СтрокаТовара Из Товары Цикл
		Движение = Движения.ВыдачаНоменклатуры.Добавить();
		Движение.Период = Дата;
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Номенклатура = СтрокаТовара.Номенклатура;
		Движение.Магазин = Магазин;
		Движение.ДокументПродажа = ДокументПродажа;
		Движение.Контрагент = Контрагент;
		Движение.Количество = СтрокаТовара.Количество;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОстаткиРезерва(Магазин)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ВыдачаНоменклатуры.Остатки(
	|		&Момент,
	|		ДокументПродажа = &ДокументПродажа
	|			И Магазин = &Магазин
	|			И Номенклатура В (&Номенклатура)) КАК Остатки";
	Запрос.УстановитьПараметр("Момент", Новый Граница(МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ДокументПродажа", ДокументПродажа);
	Запрос.УстановитьПараметр("Магазин", Магазин);
	Запрос.УстановитьПараметр("Номенклатура", Товары.ВыгрузитьКолонку("Номенклатура"));
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура СообщитьПользователю(ТекстСообщения)
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
КонецПроцедуры

#КонецОбласти

#КонецЕсли
