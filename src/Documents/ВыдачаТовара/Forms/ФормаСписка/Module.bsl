#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПечатьДокументов(Команда)
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите документ для печати.");
		Возврат;
	КонецЕсли;
	ДокументыДляПечати = ПечатьНаСервере(ТекущиеДанные.Номер);
	МодульПечати.ВывестиДокументы(ДокументыДляПечати);

КонецПроцедуры




#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПечатьНаСервере(Номер)
	Ссылка = Документы.ВыдачаТовара.НайтиПоНомеру(Номер).Ссылка;
	Возврат Документы.ВыдачаТовара.Печать(Ссылка);
КонецФункции

#КонецОбласти
