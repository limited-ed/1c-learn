#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПечатьАкта(Команда)
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите документ для печати.");
		Возврат;
	КонецЕсли;
	ТабличныйДокумент = ПечатьНаСервере(ТекущиеДанные.Номер);
	ТабличныйДокумент.Показать("Акт приема-передачи");
КонецПроцедуры



#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПечатьНаСервере(Номер)
	Ссылка = Документы.ВыдачаТовара.НайтиПоНомеру(Номер).Ссылка;
	Возврат Документы.ВыдачаТовара.Печать(Ссылка);
КонецФункции

#КонецОбласти
