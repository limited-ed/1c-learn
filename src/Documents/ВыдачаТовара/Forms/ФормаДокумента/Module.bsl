#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ПоказатьАкт();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПечатьАкта(Команда)
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Запишите документ перед печатью.");
		Возврат;
	КонецЕсли;
	ПоказатьАкт();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьАкт()
	ТабличныйДокумент = ПечатьНаСервере();
	ТабличныйДокумент.Показать("Акт приема-передачи");
КонецПроцедуры

&НаСервере
Функция ПечатьНаСервере()
	Возврат Документы.ВыдачаТовара.Печать(Объект.Ссылка);
КонецФункции

#КонецОбласти
