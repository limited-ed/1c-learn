#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если ЗначениеЗаполнено(ДатаНачала) И ЗначениеЗаполнено(ДатаОкончания) И ДатаНачала > ДатаОкончания Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Дата окончания больничного раньше даты начала.";
		Сообщение.Поле = "ДатаОкончания";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Если СменыКОплате > 3 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Оплпачивается не более 3 рабочих дней";
		Сообщение.Поле = "СменыКОплате";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ЗапросСреднее = Новый Запрос("ВЫБРАТЬ
								 |	Начисления.Сотрудник КАК Сотрудник,
								 |	ВЫРАЗИТЬ(СУММА(Начисления.Результат) / СУММА(Начисления.ОтработаноЧасов) КАК ЧИСЛО(15, 2)) КАК СреднееЗаЧас
								 |ИЗ
								 |	РегистрРасчета.Начисления КАК Начисления
								 |ГДЕ
								 |	Начисления.ПериодРегистрации МЕЖДУ НАЧАЛОПЕРИОДА(&НачалоПериода, МЕСЯЦ) И КОНЕЦПЕРИОДА(&КонецПериода, МЕСЯЦ)
								 |	И Начисления.Сторно = ЛОЖЬ
								 |	И Начисления.Сотрудник = &Сотрудник
								 |СГРУППИРОВАТЬ ПО
								 |	Начисления.Сотрудник");

	ЗапросСреднее.Параметры.Вставить("НачалоПериода", ДобавитьМесяц(НачалоДня(ДатаНачала), -6));
	ЗапросСреднее.Параметры.Вставить("КонецПериода", НачалоДня(ДатаНачала));
	ЗапросСреднее.Параметры.Вставить("Сотрудник", Сотрудник);
	Данные = ЗапросСреднее.Выполнить().Выгрузить();

	Если Данные.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Невозможно посчитать среднее зарплаты, заполните табель работника";
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	

	Движения.Начисления.Записывать = Истина;
	Движение = Движения.Начисления.Добавить();
	Движение.ВидРасчета = ПланыВидовРасчета.Начисления.БольничныйЛист;
	Движение.Сотрудник = Сотрудник;
	Движение.Результат = Данные[0].СреднееЗаЧас * Сотрудник.Должность.ГрафикРаботы.ЧасыРаботы*СменыКОплате;
	Движение.ОтработаноЧасов = 0;
	Движение. Тариф = 0;
	Движение.ПериодРегистрации = ДатаНачала;
	Движение.ПериодДействияНачало = ДатаНачала;
	Движение.ПериодДействияКонец = ДатаОкончания;
	Движение.БазовыйПериодНачало = ДатаНачала;
	Движение.БазовыйПериодКонец = ДатаОкончания;

КонецПроцедуры

#КонецОбласти

#КонецЕсли