#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Премия.Количество() = 0 Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Добавьте хотя бы одну строку премии.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	НомерСтроки = 0;
	Для Каждого СтрокаПремии Из Премия Цикл
		НомерСтроки = НомерСтроки + 1;
		Если Не ЗначениеЗаполнено(СтрокаПремии.Сотрудник) Или СтрокаПремии.Сумма <= 0 Тогда
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "В строке " + НомерСтроки + " укажите сотрудника и сумму больше нуля.";
			Сообщение.Сообщить();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.Начисления.Записывать = Истина;
	Начало = НачалоМесяца(Дата);
	Конец = КонецМесяца(Дата);
	Для Каждого СтрокаПремии Из Премия Цикл
		Движение = Движения.Начисления.Добавить();
		Движение.ВидРасчета = ПланыВидовРасчета.Начисления.РазоваяПремия;
		Движение.Сотрудник = СтрокаПремии.Сотрудник;
		Движение.Результат = СтрокаПремии.Сумма;
		Движение.Тариф = СтрокаПремии.Сумма;
		Движение.ПериодРегистрации = Начало;
		Движение.ПериодДействияНачало = Начало;
		Движение.ПериодДействияКонец = Конец;
		Движение.БазовыйПериодНачало = Начало;
		Движение.БазовыйПериодКонец = Конец;
	КонецЦикла;
	
КонецПроцедуры

