// @strict-types


#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Если НЕ ПроверитьЗаполнениеДокумента() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Нехватка = НехваткаНаСкладеОтправителе();
	Если Нехватка.Количество() > 0 Тогда
		Отказ = Истина;
		Для Каждого СтрокаНехватки Из Нехватка Цикл
			СообщитьПользователю(СтрШаблон(
				"По номенклатуре %1 на складе %2 нужно %3, остаток %4.",
				СтрокаНехватки.Номенклатура,
				Отправитель,
				СтрокаНехватки.Количество,
				СтрокаНехватки.Остаток));
		КонецЦикла;
		Возврат;
	КонецЕсли;

	Движения.НакопленияНоменклатуры.Записывать = Истина;
	Движения.ПеремещениеНоменклатуры.Записывать = Истина;
	Для Каждого СтрокаТовара Из СписокНоменклатуры Цикл
		ДвижениеРасход = Движения.НакопленияНоменклатуры.Добавить();
		ДвижениеРасход.Период = Дата;
		ДвижениеРасход.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвижениеРасход.Номенклатура = СтрокаТовара.Номенклатура;
		ДвижениеРасход.Магазин = Отправитель;
		ДвижениеРасход.Количество = СтрокаТовара.Количество;

		ДвижениеПриход = Движения.ПеремещениеНоменклатуры.Добавить();
		ДвижениеПриход.Период = Дата;
		ДвижениеПриход.ВидДвижения = ВидДвиженияНакопления.Приход;
		ДвижениеПриход.Номенклатура = СтрокаТовара.Номенклатура;
		ДвижениеПриход.ДокументПеремещение = Ссылка;
		ДвижениеПриход.Магазин = Получатель;
		ДвижениеПриход.Количество = СтрокаТовара.Количество;
	КонецЦикла;

	СоздатьИлиОбновитьПриход(Отказ);
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	Приходы = ПриходыПоОснованию(Ссылка);
	Для Каждого СтрокаПрихода Из Приходы Цикл
		Если СтрокаПрихода.Проведен Тогда
			Отказ = Истина;
			СообщитьПользователю("Сначала отмените проведение прихода по этому перемещению.");
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаПрихода Из Приходы Цикл
		Если СтрокаПрихода.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		ПриходОбъект = СтрокаПрихода.Ссылка.ПолучитьОбъект();
		ПриходОбъект.УстановитьПометкуУдаления(Истина);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверитьЗаполнениеДокумента()
	ОшибокНет = Истина;
	Если НЕ ЗначениеЗаполнено(Отправитель) Тогда
		ОшибокНет = Ложь;
		СообщитьПользователю("Укажите склад-отправитель.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Получатель) Тогда
		ОшибокНет = Ложь;
		СообщитьПользователю("Укажите склад-получатель.");
	КонецЕсли;
	Если ЗначениеЗаполнено(Отправитель) И Отправитель = Получатель Тогда
		ОшибокНет = Ложь;
		СообщитьПользователю("Склад-отправитель и склад-получатель должны быть разными.");
	КонецЕсли;
	Если СписокНоменклатуры.Количество() = 0 Тогда
		ОшибокНет = Ложь;
		СообщитьПользователю("Заполните список номенклатуры.");
		Возврат ОшибокНет;
	КонецЕсли;
	Для Каждого СтрокаТовара Из СписокНоменклатуры Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
			ОшибокНет = Ложь;
			СообщитьПользователю("В строке не заполнена номенклатура.");
		КонецЕсли;
		Если СтрокаТовара.Количество <= 0 Тогда
			ОшибокНет = Ложь;
			СообщитьПользователю("Количество в строке должно быть больше нуля.");
		КонецЕсли;
	КонецЦикла;
	Возврат ОшибокНет;
КонецФункции

Функция НехваткаНаСкладеОтправителе()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Количество КАК Количество
	|ПОМЕСТИТЬ ВТТоварыДокумента
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТТоварыДокумента.Номенклатура КАК Номенклатура,
	|	СУММА(ВТТоварыДокумента.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТТовары
	|ИЗ
	|	ВТТоварыДокумента КАК ВТТоварыДокумента
	|СГРУППИРОВАТЬ ПО
	|	ВТТоварыДокумента.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТТовары.Номенклатура КАК Номенклатура,
	|	ВТТовары.Количество КАК Количество,
	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Остаток
	|ИЗ
	|	ВТТовары КАК ВТТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НакопленияНоменклатуры.Остатки(&Момент, Магазин = &Склад) КАК Остатки
	|		ПО ВТТовары.Номенклатура = Остатки.Номенклатура
	|ГДЕ
	|	ВТТовары.Количество > ЕСТЬNULL(Остатки.КоличествоОстаток, 0)";
	Запрос.УстановитьПараметр("Товары", СписокНоменклатуры.Выгрузить(, "Номенклатура, Количество"));
	Запрос.УстановитьПараметр("Момент", Новый Граница(МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Склад", Отправитель);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура СоздатьИлиОбновитьПриход(Отказ)
	Приходы = ПриходыПоОснованию(Ссылка);
	Для Каждого СтрокаПрихода Из Приходы Цикл
		Если СтрокаПрихода.Проведен Тогда
			Отказ = Истина;
			СообщитьПользователю("По этому перемещению уже проведен приход. Сначала отмените его проведение.");
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ПриходОбъект = Неопределено;
	Если Приходы.Количество() > 0 Тогда
		ПриходОбъект = Приходы[0].Ссылка.ПолучитьОбъект();
		ПриходОбъект.ПометкаУдаления = Ложь;
	Иначе
		ПриходОбъект = Документы.Приход.СоздатьДокумент();
	КонецЕсли;

	ПриходОбъект.Заполнить(Ссылка);
	Если НЕ ЗначениеЗаполнено(ПриходОбъект.Дата) ИЛИ ПриходОбъект.Дата <= Дата Тогда
		ПриходОбъект.Дата = Дата + 1;
	КонецЕсли;

	Попытка
		ПриходОбъект.Записать(РежимЗаписиДокумента.Запись);
		Если ПриходОбъект.ЭтоНовый() Тогда
			Отказ = Истина;
			СообщитьПользователю("Не удалось создать приход.");
		КонецЕсли;
	Исключение
		Отказ = Истина;
		СообщитьПользователю("Не удалось создать приход: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

Функция ПриходыПоОснованию(Основание)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Приход.Ссылка КАК Ссылка,
	|	Приход.Проведен КАК Проведен,
	|	Приход.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Документ.Приход КАК Приход
	|ГДЕ
	|	Приход.ДокументОснование = &Основание";
	Запрос.УстановитьПараметр("Основание", Основание);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура СообщитьПользователю(ТекстСообщения)
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
КонецПроцедуры

#КонецОбласти

#КонецЕсли
