#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс


// Параметры:
// ССылка - ДокументСсылка.ПриказУвольнение
Функция ПечатнаяФорма(Ссылка) Экспорт

	ДокументОбъект = Ссылка.ПолучитьОбъект();
	ТабличныйДокумент = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет("ФормаТ8");
	Область = Макет.ПолучитьОбласть("Приказ");
	Область.Параметры.Организация = Константы.НаименованиеОрганизации.Получить();
	Область.Параметры.Номер = ДокументОбъект.Номер;
	Область.Параметры.Дата = Формат(ДокументОбъект.Дата, "ДЛФ=D");
	ТрудовойДоговор = Справочники.ТрудовыеДоговора.НайтиПоРеквизиту("Сотрудник", ДокументОбъект.Сотрудник);
	Если ЗначениеЗаполнено(ТрудовойДоговор) Тогда
		ДатаСост = СтрРазделить(Формат(ТрудовойДоговор.Дата, "ДЛФ=DD;"), " ");
		Область.Параметры.ДЧисло = ДатаСост[0];
		Область.Параметры.ДМесяц = ДатаСост[1];
		Область.Параметры.ДГод = Сред(ДатаСост[2], 3, 2);
		Область.Параметры.ДНомер = ТрудовойДоговор.Код;
	КонецЕсли;
	
	ДатаСост = СтрРазделить(Формат(ДокументОбъект.Дата, "ДЛФ=DD;"), " ");
	Область.Параметры.Число = ДатаСост[0];
	Область.Параметры.Месяц = ДатаСост[1];
	Область.Параметры.Год = Сред(ДатаСост[2], 3, 2);

	Область.Параметры.ФИО = ДокументОбъект.Сотрудник.Наименование;
	Область.Параметры.Подразделение = ДокументОбъект.Сотрудник.Подразделение.Наименование;
	Область.Параметры.Должность = ДокументОбъект.Сотрудник.Должность.Наименование;
	
	Область.Параметры.Основание = ДокументОбъект.Основание;
	Область.Параметры.ДокументОснование = ДокументОбъект.ДокументОснование;
	
	Руководитель = Справочники.Сотрудники.НайтиПоРеквизиту("Руководитель", Истина);
	Если ЗначениеЗаполнено(Руководитель) Тогда
		Область.Параметры.РуководительДолжность = Руководитель.Должность.Наименование;
		Область.Параметры.РуководительФИО = Руководитель.Наименование;
	КонецЕсли;

	
	Если ЗначениеЗаполнено(ДокументОбъект.Сотрудник) Тогда
		Область.Параметры.Подразделение = ДокументОбъект.Сотрудник.Подразделение;
		Область.Параметры.Должность = ДокументОбъект.Сотрудник.Должность;
		Область.Параметры.ТабельныйНомер = ДокументОбъект.Сотрудник.ТабельныйНомер;
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(Область);
	Возврат ТабличныйДокумент;

КонецФункции

#КонецОбласти

#КонецЕсли