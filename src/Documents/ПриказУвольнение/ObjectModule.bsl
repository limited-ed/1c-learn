#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(ДатаУвольнения) Тогда
		ДатаУвольнения = ТекущаяДатаСеанса();
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЗначениеЗаполнено(Руководитель) И Не Руководитель.Руководитель Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Руководителя нужно выбрать из сотрудников с признаком «Руководитель».";
		Сообщение.Поле = "Руководитель";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	СотрудникОбъект = Сотрудник.ПолучитьОбъект();
	ИзменитьДоступПользователяИБ(СотрудникОбъект.ИдентификаторПользователяИБ, Ложь, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	СотрудникОбъект.Статус = Перечисления.СтатусыСотрудников.Уволен;
	СотрудникОбъект.Записать();
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	СотрудникОбъект = Сотрудник.ПолучитьОбъект();
	ИзменитьДоступПользователяИБ(СотрудникОбъект.ИдентификаторПользователяИБ, Истина, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	СотрудникОбъект.Статус = Перечисления.СтатусыСотрудников.ПринятНаРаботу;
	СотрудникОбъект.Записать();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ИзменитьДоступПользователяИБ(Идентификатор, РазрешитьВход, Отказ)
	
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат;
	КонецЕсли;
	
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Идентификатор);
	Если ПользовательИБ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПользовательИБ.АутентификацияСтандартная = РазрешитьВход;
	Если Не РазрешитьВход Тогда
		ПользовательИБ.АутентификацияОС = Ложь;
	КонецЕсли;
	
	Попытка
		ПользовательИБ.Записать();
	Исключение
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось изменить доступ пользователя информационной базы. Нужны права администратора информационной базы.";
		Сообщение.Сообщить();
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
