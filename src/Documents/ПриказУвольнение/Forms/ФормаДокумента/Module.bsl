#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	Если ПодтвержденоУвольнение Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияУвольнения", ЭтотОбъект);
	ОткрытьФорму("Документ.ПриказУвольнение.Форма.ФормаПодтверждения", , ЭтотОбъект, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ПодтвержденоУвольнение = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Печать(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Перед печатью запишите документ.");
		Возврат;
	КонецЕсли;
	
	Коллекция = МодульПечати.СоздатьКоллекциюДокументовДляПечати();
	СтрокаПечати = Коллекция.Добавить();
	СтрокаПечати.ИмяДокумента = "Приказ об увольнении (форма № Т-8)";
	СтрокаПечати.Документ = ПечатнаяФормаНаСервере();
	МодульПечати.ВывестиДокументы(Коллекция);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеПодтвержденияУвольнения(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Истина Тогда
		Возврат;
	КонецЕсли;
	
	ПодтвержденоУвольнение = Истина;
	ПараметрыЗаписи = Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение);
	Записать(ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Функция ПечатнаяФормаНаСервере()
	Возврат Документы.ПриказУвольнение.ПечатнаяФорма(Объект.Ссылка);
КонецФункции

#КонецОбласти
