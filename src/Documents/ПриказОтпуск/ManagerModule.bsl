#Область ПрограммныйИнтерфейс

Функция ПечатнаяФорма(Ссылка) Экспорт
	
	ДокументОбъект = Ссылка.ПолучитьОбъект();
	Макет = Документы.ПриказОтпуск.ПолучитьМакет("Приказ");
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	Область = Макет.ПолучитьОбласть("Приказ");
	Область.Параметры.Номер = ДокументОбъект.Номер;
	Область.Параметры.Дата = Формат(ДокументОбъект.Дата, "ДЛФ=D");
	Область.Параметры.Сотрудник = Строка(ДокументОбъект.Сотрудник);
	Область.Параметры.Должность = Строка(ДокументОбъект.Сотрудник.Должность);
	Область.Параметры.Подразделение = Строка(ДокументОбъект.Сотрудник.Подразделение);
	Область.Параметры.ТипОтпуска = Строка(ДокументОбъект.ТипОтпуска);
	Область.Параметры.ДатаНачала = Формат(ДокументОбъект.НачалоПериода, "ДЛФ=D");
	Область.Параметры.ДатаОкончания = Формат(ДокументОбъект.КонецПериода, "ДЛФ=D");
	Область.Параметры.Дней = ДокументОбъект.КоличествоДней;
	Область.Параметры.Средний = Формат(ДокументОбъект.СреднийДневнойЗаработок, "ЧДЦ=2");
	Область.Параметры.Сумма = Формат(ДокументОбъект.Сумма, "ЧДЦ=2");
	ТабличныйДокумент.Вывести(Область);
	Возврат ТабличныйДокумент;
	
КонецФункции

