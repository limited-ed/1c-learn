#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Рассчитать(Команда)
	
	РассчитатьНаСервере();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура Печать(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Запишите приказ перед печатью.");
		Возврат;
	КонецЕсли;
	ДокументыДляПечати = МодульПечати.СоздатьКоллекциюДокументовДляПечати();
	СтрокаПечати = ДокументыДляПечати.Добавить();
	СтрокаПечати.ИмяДокумента = "Приказ на отпуск";
	СтрокаПечати.Документ = ПечатьНаСервере();
	МодульПечати.ВывестиДокументы(ДокументыДляПечати);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура РассчитатьНаСервере()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.РассчитатьОтпускные();
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
КонецПроцедуры

&НаСервере
Функция ПечатьНаСервере()
	
	Возврат Документы.ПриказОтпуск.ПечатнаяФорма(Объект.Ссылка);
	
КонецФункции

#КонецОбласти
