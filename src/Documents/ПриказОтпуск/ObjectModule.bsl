#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура РассчитатьОтпускные() Экспорт
	
	Данные = РасчетЗарплаты.РассчитатьОтпуск(Сотрудник, НачалоПериода, КонецПериода);
	КоличествоДней = Данные.Дней;
	СреднийДневнойЗаработок = Данные.СреднийДневнойЗаработок;
	Сумма = Данные.Сумма;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЗначениеЗаполнено(НачалоПериода) И ЗначениеЗаполнено(КонецПериода) И НачалоПериода > КонецПериода Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Дата окончания отпуска раньше даты начала.";
		Сообщение.Поле = "КонецПериода";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Или РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Возврат;
	КонецЕсли;
	РассчитатьОтпускные();
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если Сумма = 0 Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Сумма отпускных равна нулю. Проверьте период и заработок предыдущего месяца.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	Движения.Начисления.Записывать = Истина;
	Движение = Движения.Начисления.Добавить();
	Движение.ВидРасчета = ПланыВидовРасчета.Начисления.Отпускные;
	Движение.Сотрудник = Сотрудник;
	Движение.Результат = Сумма;
	Движение.Тариф = СреднийДневнойЗаработок;
	Движение.ОтработаноЧасов = КоличествоДней;
	Движение.ПериодДействияНачало = НачалоДня(НачалоПериода);
	Движение.ПериодДействияКонец = КонецДня(КонецПериода);
	Движение.БазовыйПериодНачало = НачалоМесяца(ДобавитьМесяц(НачалоПериода, -1));
	Движение.БазовыйПериодКонец = КонецМесяца(Движение.БазовыйПериодНачало);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
