#Область ПрограммныйИнтерфейс

Функция РаботникТекущегоПользователя() Экспорт
	Идентификатор = ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сотрудники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.ИдентификаторПользователяИБ = &Идентификатор
	|	И НЕ Сотрудники.ПометкаУдаления";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Сотрудники.ПустаяСсылка();
КонецФункции

Функция ЦенаНоменклатуры(Номенклатура, Период) Экспорт
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат 0;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Период) Тогда
		Период = ТекущаяДатаСеанса();
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цены.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Период, Номенклатура = &Номенклатура) КАК Цены";
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цена;
	КонецЕсли;
	Возврат 0;
КонецФункции

// Параметры:
// Ссылка - ДокументСсылка.Продажа 
// Возвращаемое значение:
// ТаблицаЗначений
&НаСервере
Функция Печать(Ссылка) Экспорт
	Счет=ПечатьСчета(Ссылка.ПолучитьОбъект());
	ДокументыДляПечати = МодульПечати.СоздатьКоллекциюДокументовДляПечати();
	Документ = ДокументыДляПечати.Добавить();
	Документ.ИмяДокумента = "Счет";
	Документ.Документ = Счет;
	Возврат ДокументыДляПечати;
КонецФункции

Функция АнализОбеспечения(Склад, Товары, ДатаДокумента, ДокументПродажа) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Позиции = НоваяТаблицаПозиций();
	Подбор = НоваяТаблицаПодбора();
	Результат = Новый Структура;
	Результат.Вставить("ДостаточноВсего", Истина);
	Результат.Вставить("НужноПеремещение", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ТекстНехваткиНаСкладе", "");
	Результат.Вставить("ТекстВопроса", "");
	Результат.Вставить("Позиции", Позиции);
	Результат.Вставить("Подбор", Подбор);

	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		Результат.ДостаточноВсего = Ложь;
		Результат.ТекстОшибки = "Укажите склад.";
		Возврат Результат;
	КонецЕсли;
	Если Товары.Количество() = 0 Тогда
		Результат.ДостаточноВсего = Ложь;
		Результат.ТекстОшибки = "Заполните товары.";
		Возврат Результат;
	КонецЕсли;

	ДатаОстатков = ДатаДокумента;
	Если НЕ ЗначениеЗаполнено(ДатаОстатков) Тогда
		ДатаОстатков = ТекущаяДатаСеанса();
	КонецЕсли;
	Если ДокументЗаписан(ДокументПродажа) Тогда
		Момент = Новый Граница(Новый МоментВремени(ДатаОстатков, ДокументПродажа), ВидГраницы.Исключая);
	Иначе
		Момент = Новый Граница(ДатаОстатков, ВидГраницы.Включая);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Количество КАК Количество
	|ПОМЕСТИТЬ ВТТовары
	|ИЗ
	|	&Товары КАК Товары
	|ГДЕ
	|	Товары.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И Товары.Количество > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТТовары.Номенклатура КАК Номенклатура,
	|	СУММА(ВТТовары.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТНужно
	|ИЗ
	|	ВТТовары КАК ВТТовары
	|СГРУППИРОВАТЬ ПО
	|	ВТТовары.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(Наличие.Номенклатура, Резерв.Номенклатура) КАК Номенклатура,
	|	ЕСТЬNULL(Наличие.Магазин, Резерв.Магазин) КАК Магазин,
	|	ЕСТЬNULL(Наличие.КоличествоОстаток, 0) - ЕСТЬNULL(Резерв.КоличествоОстаток, 0) КАК Свободно
	|ИЗ
	|	РегистрНакопления.НакопленияНоменклатуры.Остатки(
	|			&Момент,
	|			Номенклатура В
	|				(ВЫБРАТЬ
	|					ВТНужно.Номенклатура
	|				ИЗ
	|					ВТНужно КАК ВТНужно)) КАК Наличие
	|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления.РезервНоменклатуры.Остатки(
	|				&Момент,
	|				Номенклатура В
	|					(ВЫБРАТЬ
	|						ВТНужно.Номенклатура
	|					ИЗ
	|						ВТНужно КАК ВТНужно)) КАК Резерв
	|		ПО Наличие.Номенклатура = Резерв.Номенклатура
	|			И Наличие.Магазин = Резерв.Магазин
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	СУММА(Остатки.КоличествоОстаток) КАК Количество
	|ИЗ
	|	РегистрНакопления.ПеремещениеНоменклатуры.Остатки(
	|			&Момент,
	|			Магазин = &Склад
	|				И Номенклатура В
	|					(ВЫБРАТЬ
	|						ВТНужно.Номенклатура
	|					ИЗ
	|						ВТНужно КАК ВТНужно)) КАК Остатки
	|ГДЕ
	|	Остатки.ДокументПеремещение.ПозЗаказ
	|	И Остатки.ДокументПеремещение.ДокументПродажа = &ДокументПродажа
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТНужно.Номенклатура КАК Номенклатура,
	|	ВТНужно.Количество КАК Количество
	|ИЗ
	|	ВТНужно КАК ВТНужно";
	Запрос.УстановитьПараметр("Товары", Товары);
	Запрос.УстановитьПараметр("Момент", Момент);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("ДокументПродажа", ДокументПродажа);
	Пакет = Запрос.ВыполнитьПакет();
	Свободные = Пакет[2].Выгрузить();
	ВПути = Пакет[3].Выгрузить();
	Нужно = Пакет[4].Выгрузить();

	ТекстНехваткиКомпании = Новый Массив;
	ТекстНехваткиСклада = Новый Массив;
	ТекстВопроса = Новый Массив;
	ТекстВопроса.Добавить("На складе магазина не хватает свободного остатка (наличие минус резерв).");

	Для Каждого СтрокаНужно Из Нужно Цикл
		СвободноЗдесь = 0;
		СвободноВсего = 0;
		Для Каждого СтрокаОстатка Из Свободные Цикл
			Если СтрокаОстатка.Номенклатура <> СтрокаНужно.Номенклатура Или СтрокаОстатка.Свободно <= 0 Тогда
				Продолжить;
			КонецЕсли;
			СвободноВсего = СвободноВсего + СтрокаОстатка.Свободно;
			Если СтрокаОстатка.Магазин = Склад Тогда
				СвободноЗдесь = СвободноЗдесь + СтрокаОстатка.Свободно;
			КонецЕсли;
		КонецЦикла;
		СтрокаВПути = ВПути.Найти(СтрокаНужно.Номенклатура, "Номенклатура");
		КоличествоВПути = 0;
		Если СтрокаВПути <> Неопределено Тогда
			КоличествоВПути = СтрокаВПути.Количество;
		КонецЕсли;
		Нехватка = СтрокаНужно.Количество - СвободноЗдесь - КоличествоВПути;
		Если Нехватка < 0 Тогда
			Нехватка = 0;
		КонецЕсли;
		КРезерву = Мин(СтрокаНужно.Количество, СвободноЗдесь);

		Позиция = Позиции.Добавить();
		Позиция.Номенклатура = СтрокаНужно.Номенклатура;
		Позиция.Нужно = СтрокаНужно.Количество;
		Позиция.СвободноЗдесь = СвободноЗдесь;
		Позиция.СвободноВсего = СвободноВсего;
		Позиция.ВПути = КоличествоВПути;
		Позиция.Нехватка = Нехватка;
		Позиция.КРезерву = КРезерву;

		Если СтрокаНужно.Количество > СвободноВсего + КоличествоВПути Тогда
			Результат.ДостаточноВсего = Ложь;
			ТекстНехваткиКомпании.Добавить(СтрШаблон(
				"По номенклатуре %1 нужно %2, свободный остаток по всем складам %3.",
				СтрокаНужно.Номенклатура,
				СтрокаНужно.Количество,
				СвободноВсего));
		КонецЕсли;
		Если Нехватка > 0 Тогда
			Результат.НужноПеремещение = Истина;
			ТекстНехваткиСклада.Добавить(СтрШаблон(
				"По номенклатуре %1 на складе %2 свободно %3, нужно переместить %4.",
				СтрокаНужно.Номенклатура,
				Склад,
				СвободноЗдесь,
				Нехватка));
			ТекстВопроса.Добавить(СтрШаблон("%1 — не хватает %2.", СтрокаНужно.Номенклатура, Нехватка));
			Для Каждого СтрокаОстатка Из Свободные Цикл
				Если СтрокаОстатка.Номенклатура <> СтрокаНужно.Номенклатура
					Или СтрокаОстатка.Магазин = Склад
					Или СтрокаОстатка.Свободно <= 0 Тогда
					Продолжить;
				КонецЕсли;
				СтрокаПодбора = Подбор.Добавить();
				СтрокаПодбора.Номенклатура = СтрокаНужно.Номенклатура;
				СтрокаПодбора.Склад = СтрокаОстатка.Магазин;
				СтрокаПодбора.Наличие = СтрокаОстатка.Свободно;
				СтрокаПодбора.Нужно = Нехватка;
				СтрокаПодбора.Количество = 0;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Подбор.Сортировать("Номенклатура, Наличие Убыв");
	Если НЕ Результат.ДостаточноВсего Тогда
		Результат.НужноПеремещение = Ложь;
		Результат.ТекстОшибки = СтрСоединить(ТекстНехваткиКомпании, Символы.ПС);
	ИначеЕсли Результат.НужноПеремещение Тогда
		ТекстНехваткиСклада.Добавить("Оформите документ из формы продажи и создайте перемещения.");
		Результат.ТекстНехваткиНаСкладе = СтрСоединить(ТекстНехваткиСклада, Символы.ПС);
		ТекстВопроса.Добавить("Создать перемещения автоматически со складов с наибольшим наличием?");
		ТекстВопроса.Добавить("Да — автоматически. Нет — выбрать склады и количество. Отмена — не проводить.");
		Результат.ТекстВопроса = СтрСоединить(ТекстВопроса, Символы.ПС);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция СоздатьАвтоперемещения(Склад, ДатаДокумента, ДокументПродажа, Товары) Экспорт
	Анализ = АнализОбеспечения(Склад, Товары, ДатаДокумента, ДокументПродажа);
	Если НЕ Анализ.ДостаточноВсего Тогда
		Возврат Анализ.ТекстОшибки;
	КонецЕсли;
	Если НЕ Анализ.НужноПеремещение Тогда
		Возврат "";
	КонецЕсли;
	Строки = РаспределитьАвтоматически(Анализ.Подбор, Анализ.Позиции);
	Если Строки = Неопределено Тогда
		Возврат "Не удалось распределить нехватку по складам.";
	КонецЕсли;
	Возврат СоздатьПеремещенияПодЗаказ(Склад, ДатаДокумента, ДокументПродажа, Строки, Товары);
КонецФункции

Функция СоздатьПеремещенияПодЗаказ(Получатель, ДатаДокумента, ДокументПродажа, Строки, ТоварыПродажи) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Таблица = ТаблицаСтрокПеремещения(Строки);
	Если Таблица.Количество() = 0 Тогда
		Возврат "Не указано количество для перемещения.";
	КонецЕсли;
	ДатаПеремещения = ДатаДокумента;
	Если НЕ ЗначениеЗаполнено(ДатаПеремещения) Тогда
		ДатаПеремещения = ТекущаяДатаСеанса();
	КонецЕсли;
	Анализ = АнализОбеспечения(Получатель, ТоварыПродажи, ДатаПеремещения, ДокументПродажа);
	Если НЕ Анализ.ДостаточноВсего Тогда
		Возврат Анализ.ТекстОшибки;
	КонецЕсли;
	ТекстОшибки = ПроверитьСтрокиПеремещения(Таблица, Анализ);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат ТекстОшибки;
	КонецЕсли;

	Созданные = Новый Массив;
	Склады = Таблица.Скопировать(, "Склад");
	Склады.Свернуть("Склад");
	Попытка
		Для Каждого СтрокаСклада Из Склады Цикл
			ДокументПеремещения = Документы.Перемещение.СоздатьДокумент();
			ДокументПеремещения.Дата = ДатаПеремещения - 1;
			ДокументПеремещения.Отправитель = СтрокаСклада.Склад;
			ДокументПеремещения.Получатель = Получатель;
			ДокументПеремещения.ПозЗаказ = Истина;
			ДокументПеремещения.ДокументПродажа = ДокументПродажа;
			Найденные = Таблица.НайтиСтроки(Новый Структура("Склад", СтрокаСклада.Склад));
			КоличествоПоНоменклатуре = Новый Соответствие;
			Для Каждого Найденная Из Найденные Цикл
				УжеЕсть = КоличествоПоНоменклатуре.Получить(Найденная.Номенклатура);
				Если УжеЕсть = Неопределено Тогда
					УжеЕсть = 0;
				КонецЕсли;
				КоличествоПоНоменклатуре.Вставить(Найденная.Номенклатура, УжеЕсть + Найденная.Количество);
			КонецЦикла;
			Для Каждого КлючИЗначение Из КоличествоПоНоменклатуре Цикл
				НоваяСтрока = ДокументПеремещения.СписокНоменклатуры.Добавить();
				НоваяСтрока.Номенклатура = КлючИЗначение.Ключ;
				НоваяСтрока.Количество = КлючИЗначение.Значение;
			КонецЦикла;
			ДокументПеремещения.Записать(РежимЗаписиДокумента.Проведение);
			Созданные.Добавить(ДокументПеремещения.Ссылка);
		КонецЦикла;
	Исключение
		ОтменитьПеремещения(Созданные);
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат "";
КонецФункции

Функция ТекстОшибкиПодбора(Склад, ДатаДокумента, ДокументПродажа, ТоварыПродажи, Строки) Экспорт
	Анализ = АнализОбеспечения(Склад, ТоварыПродажи, ДатаДокумента, ДокументПродажа);
	Если НЕ Анализ.ДостаточноВсего Тогда
		Возврат Анализ.ТекстОшибки;
	КонецЕсли;
	Если НЕ Анализ.НужноПеремещение Тогда
		Возврат "Перемещение уже не требуется.";
	КонецЕсли;
	Возврат ПроверитьСтрокиПеремещения(ТаблицаСтрокПеремещения(Строки), Анализ);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоваяТаблицаПозиций()
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Квалификатор = Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный);
	ТипЧисла = Новый ОписаниеТипов("Число", Квалификатор);
	Таблица.Колонки.Добавить("Нужно", ТипЧисла);
	Таблица.Колонки.Добавить("СвободноЗдесь", ТипЧисла);
	Таблица.Колонки.Добавить("СвободноВсего", ТипЧисла);
	Таблица.Колонки.Добавить("ВПути", ТипЧисла);
	Таблица.Колонки.Добавить("Нехватка", ТипЧисла);
	Таблица.Колонки.Добавить("КРезерву", ТипЧисла);
	Возврат Таблица;
КонецФункции

Функция НоваяТаблицаПодбора()
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Таблица.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	Квалификатор = Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный);
	ТипЧисла = Новый ОписаниеТипов("Число", Квалификатор);
	Таблица.Колонки.Добавить("Наличие", ТипЧисла);
	Таблица.Колонки.Добавить("Нужно", ТипЧисла);
	Таблица.Колонки.Добавить("Количество", ТипЧисла);
	Возврат Таблица;
КонецФункции

Функция ДокументЗаписан(ДокументПродажа)
	Если НЕ ЗначениеЗаполнено(ДокументПродажа) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Продажа.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Продажа КАК Продажа
	|ГДЕ
	|	Продажа.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ДокументПродажа);
	Возврат НЕ Запрос.Выполнить().Пустой();
КонецФункции

Функция РаспределитьАвтоматически(Подбор, Позиции)
	Результат = НоваяТаблицаПодбора();
	Для Каждого Позиция Из Позиции Цикл
		Если Позиция.Нехватка <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Осталось = Позиция.Нехватка;
		СтрокиСклада = Подбор.Скопировать(Новый Структура("Номенклатура", Позиция.Номенклатура));
		СтрокиСклада.Сортировать("Наличие Убыв");
		Для Каждого СтрокаСклада Из СтрокиСклада Цикл
			Взять = Мин(Осталось, СтрокаСклада.Наличие);
			Если Взять <= 0 Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.Номенклатура = Позиция.Номенклатура;
			НоваяСтрока.Склад = СтрокаСклада.Склад;
			НоваяСтрока.Наличие = СтрокаСклада.Наличие;
			НоваяСтрока.Нужно = Позиция.Нехватка;
			НоваяСтрока.Количество = Взять;
			Осталось = Осталось - Взять;
			Если Осталось = 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Осталось > 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ТаблицаСтрокПеремещения(Строки)
	Таблица = НоваяТаблицаПодбора();
	Если ТипЗнч(Строки) = Тип("ТаблицаЗначений") Тогда
		Для Каждого Строка Из Строки Цикл
			Если Строка.Количество <= 0 Тогда
				Продолжить;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Строка);
		КонецЦикла;
		Возврат Таблица;
	КонецЕсли;
	Для Каждого Строка Из Строки Цикл
		Если Строка.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Номенклатура = Строка.Номенклатура;
		НоваяСтрока.Склад = Строка.Склад;
		НоваяСтрока.Количество = Строка.Количество;
	КонецЦикла;
	Возврат Таблица;
КонецФункции

Функция ПроверитьСтрокиПеремещения(Таблица, Анализ)
	Для Каждого Строка Из Таблица Цикл
		Если Строка.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Доступно = 0;
		СтрокиСклада = Анализ.Подбор.НайтиСтроки(Новый Структура("Номенклатура, Склад", Строка.Номенклатура, Строка.Склад));
		Если СтрокиСклада.Количество() > 0 Тогда
			Доступно = СтрокиСклада[0].Наличие;
		КонецЕсли;
		УжеРаспределено = 0;
		Для Каждого ДругаяСтрока Из Таблица Цикл
			Если ДругаяСтрока.Номенклатура = Строка.Номенклатура И ДругаяСтрока.Склад = Строка.Склад Тогда
				УжеРаспределено = УжеРаспределено + ДругаяСтрока.Количество;
			КонецЕсли;
		КонецЦикла;
		Если УжеРаспределено > Доступно Тогда
			Возврат СтрШаблон(
				"По номенклатуре %1 на складе %2 свободно %3, к перемещению указано %4.",
				Строка.Номенклатура,
				Строка.Склад,
				Доступно,
				УжеРаспределено);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Позиция Из Анализ.Позиции Цикл
		Если Позиция.Нехватка <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Указано = 0;
		Для Каждого Строка Из Таблица Цикл
			Если Строка.Номенклатура = Позиция.Номенклатура Тогда
				Указано = Указано + Строка.Количество;
			КонецЕсли;
		КонецЦикла;
		Если Указано < Позиция.Нехватка Тогда
			Возврат СтрШаблон(
				"По номенклатуре %1 нужно переместить %2, указано %3.",
				Позиция.Номенклатура,
				Позиция.Нехватка,
				Указано);
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Процедура ОтменитьПеремещения(Созданные)
	Индекс = Созданные.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Попытка
			ДокументОбъект = Созданные[Индекс].ПолучитьОбъект();
			Если ДокументОбъект <> Неопределено Тогда
				Если ДокументОбъект.Проведен Тогда
					ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				КонецЕсли;
				ДокументОбъект.УстановитьПометкуУдаления(Истина);
			КонецЕсли;
		Исключение
			Возврат;
		КонецПопытки;
		Индекс = Индекс - 1;
	КонецЦикла;
КонецПроцедуры

Функция ПечатьСчета(ДокументОбъект)
	Макет = Документы.Продажа.ПолучитьМакет("Счет");
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Покупатель = ОписаниеПокупателя(ДокументОбъект);
	Ставка = СтавкаНДС();
	Шапка = Макет.ПолучитьОбласть("Шапка");
	Шапка.Параметры.Номер = ДокументОбъект.Номер;
	Шапка.Параметры.Дата = Формат(ДокументОбъект.Дата, "ДЛФ=D");
	Шапка.Параметры.Поставщик = "Магазин электроники";
	Шапка.Параметры.Покупатель = Покупатель.Наименование;
	Шапка.Параметры.ИннКпп = Покупатель.ИннКпп;
	Шапка.Параметры.Адрес = Покупатель.Адрес;
	Шапка.Параметры.Работник = Строка(ДокументОбъект.Работник);
	ТабличныйДокумент.Вывести(Шапка);
	ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("ШапкаТаблицы"));
	НомерСтроки = 0;
	ИтогоНДС = 0;
	Для Каждого СтрокаТовара Из ДокументОбъект.Товары Цикл
		НомерСтроки = НомерСтроки + 1;
		СуммаСНДС = СтрокаТовара.Количество * СтрокаТовара.Цена;
		СуммаНДС = МодульФункций.СуммаНДС(СуммаСНДС, Ставка);
		ИтогоНДС = ИтогоНДС + СуммаНДС;
		ОбластьСтроки = Макет.ПолучитьОбласть("Строка");
		ОбластьСтроки.Параметры.НомерСтроки = НомерСтроки;
		ОбластьСтроки.Параметры.Номенклатура = Строка(СтрокаТовара.Номенклатура);
		ОбластьСтроки.Параметры.Количество = СтрокаТовара.Количество;
		ОбластьСтроки.Параметры.Цена = Формат(СтрокаТовара.Цена, "ЧДЦ=2");
		ОбластьСтроки.Параметры.Сумма = Формат(СуммаСНДС, "ЧДЦ=2");
		ОбластьСтроки.Параметры.Ставка = МодульФункций.ПредставлениеСтавкиНДС(Ставка);
		ОбластьСтроки.Параметры.СуммаНДС = Формат(СуммаНДС, "ЧДЦ=2");
		ТабличныйДокумент.Вывести(ОбластьСтроки);
	КонецЦикла;
	Подвал = Макет.ПолучитьОбласть("Подвал");
	Подвал.Параметры.Итого = Формат(ДокументОбъект.СуммаДокумента, "ЧДЦ=2");
	Подвал.Параметры.СуммаНДС = Формат(ИтогоНДС, "ЧДЦ=2");
	Подвал.Параметры.КоличествоПозиций = НомерСтроки;
	ТабличныйДокумент.Вывести(Подвал);
	Возврат ТабличныйДокумент;
КонецФункции

Функция СтавкаНДС()
	Ставка = МодульФункций.ПолучитьНДС();
	Если ТипЗнч(Ставка) <> Тип("Число") Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Ставка;
КонецФункции

Функция ПоказателиСтроки(Количество, ЦенаСНДС, Ставка)
	СуммаСНДС = Количество * ЦенаСНДС;
	СуммаНДС = МодульФункций.СуммаНДС(СуммаСНДС, Ставка);
	СуммаБезНДС = СуммаСНДС - СуммаНДС;
	ЦенаБезНДС = 0;
	Если Количество <> 0 Тогда
		ЦенаБезНДС = Окр(СуммаБезНДС / Количество, 2);
	КонецЕсли;
	Возврат Новый Структура("СуммаСНДС, СуммаНДС, СуммаБезНДС, ЦенаБезНДС", СуммаСНДС, СуммаНДС, СуммаБезНДС,
		ЦенаБезНДС);
КонецФункции

Функция ОписаниеПокупателя(ДокументОбъект)
	Результат = Новый Структура("Наименование, ИннКпп, Адрес", "Физическое лицо", "—", "—");
	Если Не ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
		Возврат Результат;
	КонецЕсли;
	Контрагент = ДокументОбъект.Контрагент;
	Результат.Наименование = Строка(Контрагент);
	Инн = СокрЛП(Контрагент.ИНН);
	Кпп = СокрЛП(Контрагент.КПП);
	Если ЗначениеЗаполнено(Инн) И ЗначениеЗаполнено(Кпп) Тогда
		Результат.ИннКпп = Инн + " / " + Кпп;
	ИначеЕсли ЗначениеЗаполнено(Инн) Тогда
		Результат.ИннКпп = Инн;
	КонецЕсли;
	Если ЗначениеЗаполнено(Контрагент.ЮридическийАдрес) Тогда
		Результат.Адрес = Контрагент.ЮридическийАдрес;
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

#КонецЕсли