#Область ПрограммныйИнтерфейс

Функция РаботникТекущегоПользователя() Экспорт
	Идентификатор = ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сотрудники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.ИдентификаторПользователяИБ = &Идентификатор
	|	И НЕ Сотрудники.ПометкаУдаления";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Сотрудники.ПустаяСсылка();
КонецФункции

Функция ЦенаНоменклатуры(Номенклатура, Период) Экспорт
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат 0;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Период) Тогда
		Период = ТекущаяДатаСеанса();
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цены.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Период, Номенклатура = &Номенклатура) КАК Цены";
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цена;
	КонецЕсли;
	Возврат 0;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПечатьСчета(ДокументОбъект) Экспорт
	Макет = Документы.Продажа.ПолучитьМакет("Счет");
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Покупатель = ОписаниеПокупателя(ДокументОбъект);
	Ставка = СтавкаНДС();
	Шапка = Макет.ПолучитьОбласть("Шапка");
	Шапка.Параметры.Номер = ДокументОбъект.Номер;
	Шапка.Параметры.Дата = Формат(ДокументОбъект.Дата, "ДЛФ=D");
	Шапка.Параметры.Поставщик = "Магазин электроники";
	Шапка.Параметры.Покупатель = Покупатель.Наименование;
	Шапка.Параметры.ИннКпп = Покупатель.ИннКпп;
	Шапка.Параметры.Адрес = Покупатель.Адрес;
	Шапка.Параметры.Работник = Строка(ДокументОбъект.Работник);
	ТабличныйДокумент.Вывести(Шапка);
	ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("ШапкаТаблицы"));
	НомерСтроки = 0;
	ИтогоНДС = 0;
	Для Каждого СтрокаТовара Из ДокументОбъект.Товары Цикл
		НомерСтроки = НомерСтроки + 1;
		СуммаСНДС = СтрокаТовара.Количество * СтрокаТовара.Цена;
		СуммаНДС = МодульФункций.СуммаНДС(СуммаСНДС, Ставка);
		ИтогоНДС = ИтогоНДС + СуммаНДС;
		ОбластьСтроки = Макет.ПолучитьОбласть("Строка");
		ОбластьСтроки.Параметры.НомерСтроки = НомерСтроки;
		ОбластьСтроки.Параметры.Номенклатура = Строка(СтрокаТовара.Номенклатура);
		ОбластьСтроки.Параметры.Количество = СтрокаТовара.Количество;
		ОбластьСтроки.Параметры.Цена = Формат(СтрокаТовара.Цена, "ЧДЦ=2");
		ОбластьСтроки.Параметры.Сумма = Формат(СуммаСНДС, "ЧДЦ=2");
		ОбластьСтроки.Параметры.Ставка = МодульФункций.ПредставлениеСтавкиНДС(Ставка);
		ОбластьСтроки.Параметры.СуммаНДС = Формат(СуммаНДС, "ЧДЦ=2");
		ТабличныйДокумент.Вывести(ОбластьСтроки);
	КонецЦикла;
	Подвал = Макет.ПолучитьОбласть("Подвал");
	Подвал.Параметры.Итого = Формат(ДокументОбъект.СуммаДокумента, "ЧДЦ=2");
	Подвал.Параметры.СуммаНДС = Формат(ИтогоНДС, "ЧДЦ=2");
	Подвал.Параметры.КоличествоПозиций = НомерСтроки;
	ТабличныйДокумент.Вывести(Подвал);
	Возврат ТабличныйДокумент;
КонецФункции

Функция СтавкаНДС()
	Ставка = МодульФункций.ПолучитьНДС();
	Если ТипЗнч(Ставка) <> Тип("Число") Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Ставка;
КонецФункции

Функция ПоказателиСтроки(Количество, ЦенаСНДС, Ставка)
	СуммаСНДС = Количество * ЦенаСНДС;
	СуммаНДС = МодульФункций.СуммаНДС(СуммаСНДС, Ставка);
	СуммаБезНДС = СуммаСНДС - СуммаНДС;
	ЦенаБезНДС = 0;
	Если Количество <> 0 Тогда
		ЦенаБезНДС = Окр(СуммаБезНДС / Количество, 2);
	КонецЕсли;
	Возврат Новый Структура("СуммаСНДС, СуммаНДС, СуммаБезНДС, ЦенаБезНДС", СуммаСНДС, СуммаНДС, СуммаБезНДС, ЦенаБезНДС);
КонецФункции

Функция ОписаниеПокупателя(ДокументОбъект)
	Результат = Новый Структура("Наименование, ИннКпп, Адрес", "Физическое лицо", "—", "—");
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
		Возврат Результат;
	КонецЕсли;
	Контрагент = ДокументОбъект.Контрагент;
	Результат.Наименование = Строка(Контрагент);
	Инн = СокрЛП(Контрагент.ИНН);
	Кпп = СокрЛП(Контрагент.КПП);
	Если ЗначениеЗаполнено(Инн) И ЗначениеЗаполнено(Кпп) Тогда
		Результат.ИннКпп = Инн + " / " + Кпп;
	ИначеЕсли ЗначениеЗаполнено(Инн) Тогда
		Результат.ИннКпп = Инн;
	КонецЕсли;
	Если ЗначениеЗаполнено(Контрагент.ЮридическийАдрес) Тогда
		Результат.Адрес = Контрагент.ЮридическийАдрес;
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

#КонецЕсли
