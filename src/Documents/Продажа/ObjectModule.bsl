#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(Работник) Тогда
		Работник = Документы.Продажа.РаботникТекущегоПользователя();
	КонецЕсли;
	
	Дата = ТекущаяДатаСеанса();

	Если НЕ ЗначениеЗаполнено(СрокРезерва) Тогда
		СрокРезерва = ТекущаяДата()+ (5 * 86400);
	КонецЕсли;

	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	ПересчитатьСуммы();
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Если ТекущаяДата() > СрокРезерва Тогда
		Отказ = Истина;
		СообщитьПользователю("Срок резерва меньше текущей даты");
		Возврат;		
	КонецЕсли;
	
	Если Товары.Количество() = 0 Тогда
		Отказ = Истина;
		СообщитьПользователю("Заполните товары.");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Магазин) Тогда
		Отказ = Истина;
		СообщитьПользователю("Укажите Магазин.");
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаТовара Из Товары Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Или СтрокаТовара.Количество <= 0 Тогда
			Отказ = Истина;
			СообщитьПользователю("В каждой строке укажите номенклатуру и количество больше нуля.");
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Анализ = Документы.Продажа.АнализОбеспечения(
		Магазин, Товары.Выгрузить(, "Номенклатура, Количество"), Дата, Ссылка);
//	Если НЕ Анализ.ДостаточноВсего Тогда
//		Отказ = Истина;
//		СообщитьПользователю(Анализ.ТекстОшибки);
//		Возврат;
//	КонецЕсли;
//	Если Анализ.НужноПеремещение Тогда
//		Отказ = Истина;
//		СообщитьПользователю(Анализ.ТекстНехваткиНаМагазине);
//		Возврат;
//	КонецЕсли;

	Движения.НакопленияНоменклатуры.Записывать = Истина;
	Движения.НакопленияНоменклатуры.Очистить();
	Движения.РезервНоменклатуры.Записывать = Истина;
	Для Каждого Позиция Из Анализ.Позиции Цикл
		Если Позиция.КРезерву <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Движение = Движения.РезервНоменклатуры.Добавить();
		Движение.Период = Дата;
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Номенклатура = Позиция.Номенклатура;
		Движение.Магазин = Магазин;
		Движение.Количество = Позиция.КРезерву;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

 
Процедура ПересчитатьСуммы()
	СуммаДокумента = 0;
	Для Каждого СтрокаТовара Из Товары Цикл
		СтрокаТовара.Сумма = СтрокаТовара.Количество * СтрокаТовара.Цена;
		СуммаДокумента = СуммаДокумента + СтрокаТовара.Сумма;
	КонецЦикла;
КонецПроцедуры

Процедура СообщитьПользователю(ТекстСообщения)
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
КонецПроцедуры

#КонецОбласти

#КонецЕсли
