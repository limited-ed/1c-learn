#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(Работник) Тогда
		Работник = Документы.Продажа.РаботникТекущегоПользователя();
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	ПроверитьВидКонтрагента(Отказ);
	ПересчитатьСуммы();
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Если Товары.Количество() = 0 Тогда
		Отказ = Истина;
		СообщитьПользователю("Заполните товары.");
		Возврат;
	КонецЕсли;
	Нехватка = НехваткаПоВсемСкладам();
	Если Нехватка.Количество() > 0 Тогда
		Отказ = Истина;
		Для Каждого СтрокаНехватки Из Нехватка Цикл
			СообщитьПользователю(СтрШаблон(
				"По номенклатуре %1 нужно %2, на всех складах остаток %3.",
				СтрокаНехватки.Номенклатура,
				СтрокаНехватки.Количество,
				СтрокаНехватки.Остаток));
		КонецЦикла;
		Возврат;
	КонецЕсли;
	Движения.РегистрНакопленияНоменклатуры.Записывать = Истина;
	Движения.РезервНоменклатуры.Записывать = Истина;
	Остатки = ОстаткиПоСкладам();
	Для Каждого СтрокаТовара Из Товары Цикл
		Если СтрокаТовара.Количество <= 0 Тогда
			Отказ = Истина;
			СообщитьПользователю("Количество в строке должно быть больше нуля.");
			Возврат;
		КонецЕсли;
		Нужно = СтрокаТовара.Количество;
		Для Каждого СтрокаОстатка Из Остатки Цикл
			Если СтрокаОстатка.Номенклатура <> СтрокаТовара.Номенклатура
				Или СтрокаОстатка.КоличествоОстаток <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Списать = Мин(Нужно, СтрокаОстатка.КоличествоОстаток);
			ДобавитьДвижение("РегистрНакопленияНоменклатуры", ВидДвиженияНакопления.Расход, СтрокаОстатка.Магазин, СтрокаТовара.Номенклатура, Списать);
			ДобавитьДвижение("РезервНоменклатуры", ВидДвиженияНакопления.Приход, СтрокаОстатка.Магазин, СтрокаТовара.Номенклатура, Списать);
			СтрокаОстатка.КоличествоОстаток = СтрокаОстатка.КоличествоОстаток - Списать;
			Нужно = Нужно - Списать;
			Если Нужно = 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Нужно > 0 Тогда
			Отказ = Истина;
			СообщитьПользователю(СтрШаблон("Не удалось зарезервировать %1.", СтрокаТовара.Номенклатура));
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьВидКонтрагента(Отказ)
	ДопустимыйВид = ВидКонтрагента = Перечисления.ВидКонтрагента.ЮридическоеЛицо
		Или ВидКонтрагента = Перечисления.ВидКонтрагента.ФизическоеЛицо;
	Если НЕ ДопустимыйВид Тогда
		Отказ = Истина;
		СообщитьПользователю("Укажите вид контрагента: физическое или юридическое лицо.");
		Возврат;
	КонецЕсли;
	Если ВидКонтрагента = Перечисления.ВидКонтрагента.ЮридическоеЛицо
		И НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Отказ = Истина;
		СообщитьПользователю("Для юридического лица заполните контрагента.");
	КонецЕсли;
КонецПроцедуры

Процедура ПересчитатьСуммы()
	СуммаДокумента = 0;
	Для Каждого СтрокаТовара Из Товары Цикл
		СтрокаТовара.Сумма = СтрокаТовара.Количество * СтрокаТовара.Цена;
		СуммаДокумента = СуммаДокумента + СтрокаТовара.Сумма;
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьДвижение(ИмяРегистра, ВидДвижения, Магазин, Номенклатура, Количество)
	Движение = Движения[ИмяРегистра].Добавить();
	Движение.Период = Дата;
	Движение.ВидДвижения = ВидДвижения;
	Движение.Номенклатура = Номенклатура;
	Движение.Магазин = Магазин;
	Движение.Контрагент = Контрагент;
	Движение.Количество = Количество;
КонецПроцедуры

Функция НехваткаПоВсемСкладам()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	СУММА(Остатки.КоличествоОстаток) КАК КоличествоОстаток
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрНакопления.РегистрНакопленияНоменклатуры.Остатки(&Момент, ) КАК Остатки
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	СУММА(Товары.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТТовары
	|ИЗ
	|	Документ.Продажа.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	Товары.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТТовары.Номенклатура КАК Номенклатура,
	|	ВТТовары.Количество КАК Количество,
	|	ЕСТЬNULL(ВТОстатки.КоличествоОстаток, 0) КАК Остаток
	|ИЗ
	|	ВТТовары КАК ВТТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстатки КАК ВТОстатки
	|		ПО ВТТовары.Номенклатура = ВТОстатки.Номенклатура
	|ГДЕ
	|	ВТТовары.Количество > ЕСТЬNULL(ВТОстатки.КоличествоОстаток, 0)";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Момент", Новый Граница(МоментВремени(), ВидГраницы.Исключая));
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ОстаткиПоСкладам()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Магазин КАК Магазин,
	|	Остатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.РегистрНакопленияНоменклатуры.Остатки(&Момент, Номенклатура В (&Номенклатура)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура,
	|	Магазин";
	Запрос.УстановитьПараметр("Момент", Новый Граница(МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Номенклатура", Товары.ВыгрузитьКолонку("Номенклатура"));
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура СообщитьПользователю(ТекстСообщения)
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
КонецПроцедуры

#КонецОбласти

#КонецЕсли
