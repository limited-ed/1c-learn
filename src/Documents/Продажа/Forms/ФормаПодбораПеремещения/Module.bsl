
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	АдресТоваров = Параметры.АдресТоваров;
	ДокументПродажа = Параметры.ДокументПродажа;
	Дата = Параметры.Дата;
	Склад = Параметры.Магазин;
	Товары = ПолучитьИзВременногоХранилища(АдресТоваров);
	Анализ = Документы.Продажа.АнализОбеспечения(
		Параметры.Склад, Товары, Параметры.Дата, Параметры.ДокументПродажа);
	Если НЕ Анализ.ДостаточноВсего Или НЕ Анализ.НужноПеремещение Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаПодбора Из Анализ.Подбор Цикл
		ЗаполнитьЗначенияСвойств(Запасы.Добавить(), СтрокаПодбора);
	КонецЦикла;
	Текст = Новый Массив;
	Текст.Добавить("Укажите количество к перемещению. По каждой номенклатуре его должно хватить для продажи.");
	Для Каждого Позиция Из Анализ.Позиции Цикл
		Если Позиция.Нехватка <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Текст.Добавить(СтрШаблон("%1 — нужно переместить %2.", Позиция.Номенклатура, Позиция.Нехватка));
	КонецЦикла;
	Элементы.Пояснение.Заголовок = СтрСоединить(Текст, Символы.ПС);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Переместить(Команда)
	ТекстОшибки = ТекстОшибкиНаСервере();
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;
	Закрыть(ВыбранныеСтроки());
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ТекстОшибкиНаСервере()
	Товары = ПолучитьИзВременногоХранилища(АдресТоваров);
	Возврат Документы.Продажа.ТекстОшибкиПодбора(
		Склад, Дата, ДокументПродажа, Товары, Запасы.Выгрузить());
КонецФункции

&НаСервере
Функция ВыбранныеСтроки()
	Результат = Новый Массив;
	Для Каждого СтрокаЗапаса Из Запасы Цикл
		Если СтрокаЗапаса.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Новый Структура("Номенклатура, Магазин, Количество",
			СтрокаЗапаса.Номенклатура, СтрокаЗапаса.Магазин, СтрокаЗапаса.Количество));
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти
