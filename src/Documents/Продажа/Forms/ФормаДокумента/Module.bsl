&НаКлиенте
Перем СозданныеПеремещения;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(Объект.Ссылка) И Не ЗначениеЗаполнено(Объект.Работник) Тогда
		Объект.Работник = Документы.Продажа.РаботникТекущегоПользователя();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если ПропуститьПроверкуПеремещения Тогда
		ПропуститьПроверкуПеремещения = Ложь;
		Возврат;
	КонецЕсли;
	Если Не ДокументПроводится(ПараметрыЗаписи) Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	ПодготовитьПеремещения(ПараметрыЗаписи);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Если Не ДокументПроводится(ПараметрыЗаписи) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Перемещение Из СозданныеПеремещения Цикл
		Перемещение.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	
КонецПроцедуры
#КонецОбласти
#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	СтрокаТовара = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТовара = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТовара.Цена = ЦенаНоменклатурыНаСервере(СтрокаТовара.Номенклатура, Объект.Дата);
	ПересчитатьСтроку(СтрокаТовара);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	ПересчитатьСтроку(Элементы.Товары.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	ПересчитатьСтроку(Элементы.Товары.ТекущиеДанные);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура ПечатьСчета(Команда)
	ДокументыДляПечати = ПечатьСчетаНаСервере(Объект.Ссылка);
	МодульПечати.ВывестиДокументы(ДокументыДляПечати);
КонецПроцедуры
#КонецОбласти
#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПересчитатьСтроку(СтрокаТовара)
	Если СтрокаТовара = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТовара.Сумма = СтрокаТовара.Количество * СтрокаТовара.Цена;
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма");
КонецПроцедуры
&НаСервереБезКонтекста
Функция ЦенаНоменклатурыНаСервере(Знач Номенклатура, Знач Период)
	Возврат Документы.Продажа.ЦенаНоменклатуры(Номенклатура, Период);
КонецФункции

&НаСервере
Функция ПечатьНаСервере(ИмяМакета)
	Возврат Документы.Продажа.Печать(Объект.Ссылка);
КонецФункции
&НаСервере
Функция ПечатьСчетаНаСервере(Ссылка)
	Возврат Документы.Продажа.Печать(Ссылка);
КонецФункции

&НаКлиенте
Функция ДокументПроводится(ПараметрыЗаписи)
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Объект.Проведен И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Запись;
КонецФункции

&НаКлиенте
Процедура ПодготовитьПеремещения(ПараметрыЗаписи)
	Сведения = СведенияОбОбеспеченииНаСервере();
	Если Не Сведения.ДостаточноВсего Тогда
		ПоказатьПредупреждение( , Сведения.ТекстОшибки);
		Возврат;
	КонецЕсли;
	Если Не Сведения.НужноПеремещение Тогда
		ПропуститьПроверкуПеремещения = Истина;
		Записать(ПараметрыЗаписи);
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОПеремещении", ЭтотОбъект, ПараметрыЗаписи);
	ПоказатьВопрос(Оповещение, Сведения.ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОПеремещении(Ответ, ПараметрыЗаписи) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да И Ответ <> КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Результат = СоздатьАвтоперемещенияНаСервере();
		Если ТипЗнч(Результат) = Тип("Массив") Тогда
			СозданныеПеремещения = Результат;
		ИначеЕсли ТипЗнч(Результат) = Тип("Массив") И ЗначениеЗаполнено(Результат) Тогда
			ПоказатьПредупреждение( , Результат);
			Возврат;
		КонецЕсли;
		ПропуститьПроверкуПеремещения = Истина;
		Записать(ПараметрыЗаписи);
		Возврат;
	КонецЕсли;
	ПараметрыПодбора = ПараметрыПодбораНаСервере();
	Оповещение = Новый ОписаниеОповещения("ПослеРучногоПодбора", ЭтотОбъект, ПараметрыЗаписи);
	ОткрытьФорму(
		"Документ.Продажа.Форма.ФормаПодбораПеремещения", ПараметрыПодбора, ЭтотОбъект, , , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПослеРучногоПодбора(Результат, ПараметрыЗаписи) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Результат = СоздатьПеремещенияНаСервере(Результат);
	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		СозданныеПеремещения = Результат;
	ИначеЕсли ТипЗнч(Результат) = Тип("Массив") И ЗначениеЗаполнено(Результат) Тогда
		ПоказатьПредупреждение( , Результат);
		Возврат;
	КонецЕсли;
	ПропуститьПроверкуПеремещения = Истина;
	Записать(ПараметрыЗаписи);
КонецПроцедуры

&НаСервере
Функция СведенияОбОбеспеченииНаСервере()
	Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
		Объект.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	Анализ = Документы.Продажа.АнализОбеспечения(
		Объект.Магазин, Объект.Товары.Выгрузить( , "Номенклатура, Количество"), Объект.Дата, СсылкаДокументаПродажи());
	Возврат Новый Структура("ДостаточноВсего, НужноПеремещение, ТекстОшибки, ТекстВопроса", Анализ.ДостаточноВсего,
		Анализ.НужноПеремещение, Анализ.ТекстОшибки, Анализ.ТекстВопроса);
КонецФункции

&НаСервере
Функция СоздатьАвтоперемещенияНаСервере()
	Возврат Документы.Продажа.СоздатьАвтоперемещения(
		Объект.Магазин, Объект.Дата, СсылкаДокументаПродажи(), Объект.Товары.Выгрузить( , "Номенклатура, Количество"));
КонецФункции

&НаСервере
Функция СоздатьПеремещенияНаСервере(Строки)
	Возврат Документы.Продажа.СоздатьПеремещенияПодЗаказ(
		Объект.Магазин, Объект.Дата, СсылкаДокументаПродажи(), Строки, Объект.Товары.Выгрузить( ,
		"Номенклатура, Количество"));
КонецФункции

&НаСервере
Функция ПараметрыПодбораНаСервере()
	АдресТоваров = ПоместитьВоВременноеХранилище(
		Объект.Товары.Выгрузить( , "Номенклатура, Количество"), УникальныйИдентификатор);
	Возврат Новый Структура("Магазин, Дата, ДокументПродажа, АдресТоваров", Объект.Магазин, Объект.Дата,
		СсылкаДокументаПродажи(), АдресТоваров);
КонецФункции

&НаСервере
Функция СсылкаДокументаПродажи()
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	Если ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
		Возврат ДокументОбъект.Ссылка;
	КонецЕсли;
	НоваяСсылка = ДокументОбъект.ПолучитьСсылкуНового();
	Если Не ЗначениеЗаполнено(НоваяСсылка) Тогда
		НоваяСсылка = Документы.Продажа.ПолучитьСсылку();
		ДокументОбъект.УстановитьСсылкуНового(НоваяСсылка);
		ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	КонецЕсли;
	Возврат НоваяСсылка;
КонецФункции
#КонецОбласти