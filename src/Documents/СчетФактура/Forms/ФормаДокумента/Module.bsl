#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПечатьСчетаФактуры(Команда)
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Запишите документ перед печатью.");
		Возврат;
	КонецЕсли;
	ТабличныйДокумент = ПечатьНаСервере();
	ТабличныйДокумент.Показать("Счет-фактура");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПечатьНаСервере()
	Возврат Документы.СчетФактура.Печать(Объект.Ссылка);
КонецФункции

#КонецОбласти
