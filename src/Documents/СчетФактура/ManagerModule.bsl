#Область ПрограммныйИнтерфейс

Функция НайтиПоПодтверждению(Подтверждение) Экспорт
	Если Не ЗначениеЗаполнено(Подтверждение) Тогда
		Возврат Документы.СчетФактура.ПустаяСсылка();
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СчетФактура.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетФактура КАК СчетФактура
	|ГДЕ
	|	СчетФактура.ДокументПодтверждение = &Подтверждение
	|	И НЕ СчетФактура.ПометкаУдаления";
	Запрос.УстановитьПараметр("Подтверждение", Подтверждение);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Документы.СчетФактура.ПустаяСсылка();
КонецФункции

Функция Печать(Ссылка) Экспорт
	СчетФактура = ПечатьСчетаФактуры(Ссылка.ПолучитьОбъект());
	ДокументыДляПечати = МодульПечати.СоздатьКоллекциюДокументовДляПечати();
	Документ = ДокументыДляПечати.Добавить();
	Документ.ИмяДокумента = "Счет-фактура";
	Документ.Документ = СчетФактура;
	Возврат ДокументыДляПечати;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПечатьСчетаФактуры(ДокументОбъект)
	Макет = Документы.СчетФактура.ПолучитьМакет("СчетФактура");
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Покупатель = ОписаниеПокупателя(ДокументОбъект);
	Шапка = Макет.ПолучитьОбласть("Шапка");
	Шапка.Параметры.Номер = ДокументОбъект.Номер;
	Шапка.Параметры.Дата = Формат(ДокументОбъект.Дата, "ДЛФ=D");
	Шапка.Параметры.Продавец = "Магазин электроники";
	Шапка.Параметры.АдресПродавца = "—";
	Шапка.Параметры.ИннКппПродавца = "—";
	Шапка.Параметры.Грузоотправитель = "он же";
	Шапка.Параметры.Грузополучатель = Покупатель.Наименование + ", " + Покупатель.Адрес;
	Шапка.Параметры.Покупатель = Покупатель.Наименование;
	Шапка.Параметры.АдресПокупателя = Покупатель.Адрес;
	Шапка.Параметры.ИннКппПокупателя = Покупатель.ИннКпп;
	Шапка.Параметры.Валюта = "Российский рубль, 643";
	Шапка.Параметры.ДокументПродажа = Строка(ДокументОбъект.ДокументПродажа);
	ТабличныйДокумент.Вывести(Шапка);
	ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("ШапкаТаблицы"));
	НомерСтроки = 0;
	Для Каждого СтрокаТовара Из ДокументОбъект.Товары Цикл
		НомерСтроки = НомерСтроки + 1;
		ЦенаБезНДС = 0;
		Если СтрокаТовара.Количество <> 0 Тогда
			ЦенаБезНДС = Окр(СтрокаТовара.СуммаБезНДС / СтрокаТовара.Количество, 2);
		КонецЕсли;
		ОбластьСтроки = Макет.ПолучитьОбласть("Строка");
		ОбластьСтроки.Параметры.НомерСтроки = НомерСтроки;
		ОбластьСтроки.Параметры.Номенклатура = Строка(СтрокаТовара.Номенклатура);
		ОбластьСтроки.Параметры.Количество = СтрокаТовара.Количество;
		ОбластьСтроки.Параметры.ЦенаБезНДС = Формат(ЦенаБезНДС, "ЧДЦ=2");
		ОбластьСтроки.Параметры.СуммаБезНДС = Формат(СтрокаТовара.СуммаБезНДС, "ЧДЦ=2");
		ОбластьСтроки.Параметры.Ставка = МодульФункций.ПредставлениеСтавкиНДС(СтрокаТовара.СтавкаНДС);
		ОбластьСтроки.Параметры.СуммаНДС = Формат(СтрокаТовара.СуммаНДС, "ЧДЦ=2");
		ОбластьСтроки.Параметры.Всего = Формат(СтрокаТовара.Сумма, "ЧДЦ=2");
		ТабличныйДокумент.Вывести(ОбластьСтроки);
	КонецЦикла;
	Подвал = Макет.ПолучитьОбласть("Подвал");
	Подвал.Параметры.ИтогоБезНДС = Формат(ДокументОбъект.СуммаБезНДС, "ЧДЦ=2");
	Подвал.Параметры.ИтогоНДС = Формат(ДокументОбъект.СуммаНДС, "ЧДЦ=2");
	Подвал.Параметры.Всего = Формат(ДокументОбъект.СуммаДокумента, "ЧДЦ=2");
	ТабличныйДокумент.Вывести(Подвал);
	Возврат ТабличныйДокумент;
КонецФункции

Функция ОписаниеПокупателя(ДокументОбъект)
	Результат = Новый Структура("Наименование, ИннКпп, Адрес", "Физическое лицо", "—", "—");
	Контрагент = ДокументОбъект.Контрагент;
	Если Не ЗначениеЗаполнено(Контрагент) И ЗначениеЗаполнено(ДокументОбъект.ДокументПродажа) Тогда
		Контрагент = ДокументОбъект.ДокументПродажа.Контрагент;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Наименование = Строка(Контрагент);
	Инн = СокрЛП(Контрагент.ИНН);
	Кпп = СокрЛП(Контрагент.КПП);
	Если ЗначениеЗаполнено(Инн) И ЗначениеЗаполнено(Кпп) Тогда
		Результат.ИннКпп = Инн + " / " + Кпп;
	ИначеЕсли ЗначениеЗаполнено(Инн) Тогда
		Результат.ИннКпп = Инн;
	КонецЕсли;
	Если ЗначениеЗаполнено(Контрагент.ЮридическийАдрес) Тогда
		Результат.Адрес = Контрагент.ЮридическийАдрес;
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

#КонецЕсли