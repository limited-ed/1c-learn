#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Продажа") Тогда
		ЗаполнитьПоПродаже(ДанныеЗаполнения, Документы.ПодтверждениеОплаты.ПустаяСсылка());
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПодтверждениеОплаты") Тогда
		ЗаполнитьПоПродаже(ДанныеЗаполнения.ДокументОснование, ДанныеЗаполнения);
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	ПересчитатьИтоги();
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьПоПродаже(Продажа, Подтверждение) Экспорт
	ДокументПродажа = Продажа;
	ДокументПодтверждение = Подтверждение;
	Если ЗначениеЗаполнено(Продажа) Тогда
		Контрагент = Продажа.Контрагент;
	КонецЕсли;
	Ставка = МодульФункций.ПолучитьНДС();
	Если ТипЗнч(Ставка) <> Тип("Число") Тогда
		Ставка = 0;
	КонецЕсли;
	СтавкаНДС = Ставка;
	Товары.Очистить();
	Если НЕ ЗначениеЗаполнено(Продажа) Тогда
		ПересчитатьИтоги();
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаПродажи Из Продажа.Товары Цикл
		НоваяСтрока = Товары.Добавить();
		НоваяСтрока.Номенклатура = СтрокаПродажи.Номенклатура;
		НоваяСтрока.Количество = СтрокаПродажи.Количество;
		НоваяСтрока.Цена = СтрокаПродажи.Цена;
		НоваяСтрока.СтавкаНДС = Ставка;
	КонецЦикла;
	ПересчитатьИтоги();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПересчитатьИтоги()
	СуммаДокумента = 0;
	СуммаНДС = 0;
	СуммаБезНДС = 0;
	Для Каждого СтрокаТовара Из Товары Цикл
		СтрокаТовара.Сумма = СтрокаТовара.Количество * СтрокаТовара.Цена;
		СтрокаТовара.СуммаНДС = МодульФункций.СуммаНДС(СтрокаТовара.Сумма, СтрокаТовара.СтавкаНДС);
		СтрокаТовара.СуммаБезНДС = СтрокаТовара.Сумма - СтрокаТовара.СуммаНДС;
		СуммаДокумента = СуммаДокумента + СтрокаТовара.Сумма;
		СуммаНДС = СуммаНДС + СтрокаТовара.СуммаНДС;
		СуммаБезНДС = СуммаБезНДС + СтрокаТовара.СуммаБезНДС;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#КонецЕсли
