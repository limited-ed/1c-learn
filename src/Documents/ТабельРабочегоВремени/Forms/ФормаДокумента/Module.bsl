// @strict-types
#Область ОписаниеПеременных

#КонецОбласти

#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	МассивРеквизитов = Новый Массив;
	Для День = 1 По 31 Цикл
		НовыйРеквизит = Новый РеквизитФормы("День_" + Формат(День, "ЧЦ=2;"), Новый ОписаниеТипов("Число"),
			"ТабельГоризонтальный", "День_" + Формат(День, "ЧЦ=2;"), Ложь);
		МассивРеквизитов.Добавить(НовыйРеквизит);
	КонецЦикла;
	ИзменитьРеквизиты(МассивРеквизитов);

	Для День = 1 По 31 Цикл
		Элем = Элементы.Добавить(
			"ТабельДень_" + Формат(День, "ЧЦ=2;"), Тип("ПолеФормы"), Элементы.ТабельГоризонтальный);
		Элем.Заголовок = Формат(День, "ЧЦ=2;");
		Элем.Вид = ВидПоляФормы.ПолеВвода;
		Элем.ПутьКДанным = "ТабельГоризонтальный.День_" + Формат(День, "ЧЦ=2;");
		//Элем.РастягиватьПоГоризонтали = Ложь;
		Элем.Ширина = 5;
	КонецЦикла;

	Если ЗначениеЗаполнено(Объект.ПериодТабеля) Тогда
		Дней = День(КонецМесяца(Объект.ПериодТабеля));
		Если Дней < 31 Тогда
			Для Д = Дней + 1 По 31 Цикл
				Элем = Элементы.Найти("ТабельДень_" + Формат(Д, "ЧЦ=2;"));
				Если Элем <> Неопределено Тогда
					Элем.Видимость = Ложь;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Иначе
		Элементы.ТабельГоризонтальный.Видимость = Ложь;
	КонецЕсли;
	СформироватьТабель();

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Отказ = ЗаписатьТабель(ТекущийОбъект);
КонецПроцедуры
&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	a=1;
КонецПроцедуры
#КонецОбласти
#Область ОбработчикиСобытийЭлементовШапкиФормы
&НаКлиенте
Процедура ПериодТабеляПриИзменении(Элемент)
	ПериодТабеляПриИзмененииНаСервере();
КонецПроцедуры
#КонецОбласти
#Область ОбработчикиСобытийЭлементовТаблицыФормыТабельГоризонтальный
&НаКлиенте
Процедура ТабельГоризонтальныйСотрудникНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьСотрудника(Команда)
	
	Если Не ПроверитьПериод() Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные = Элементы.ТабельГоризонтальный.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Сотрудник) Тогда
		ПоказатьПредупреждение(, "Выберите строку сотрудника.");
		Возврат;
	КонецЕсли;
	ЗаполнитьСтрокуНаСервере(ТекущиеДанные.ПолучитьИдентификатор());
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВсех(Команда)
	
	Если Не ПроверитьПериод() Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Магазин) Тогда
		ПоказатьПредупреждение(, "Укажите магазин.");
		Возврат;
	КонецЕсли;
	ЗаполнитьВсехНаСервере();
	Модифицированность = Истина;
	Элементы.ТабельГоризонтальный.Видимость = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьТабель()

	Если Объект.Ссылка = Документы.ТабельРабочегоВремени.ПустаяСсылка() Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ТабельРабочегоВремени.Сотрудник КАК Сотрудник,
	|	ТабельРабочегоВремени.Дата КАК Дата,
	|	ТабельРабочегоВремени.Часы КАК Часы
	|ИЗ
	|	Документ.ТабельРабочегоВремени.Табель КАК ТабельРабочегоВремени
	|ГДЕ
	|	ТабельРабочегоВремени.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТабельРабочегоВремени.Сотрудник.Наименование");

	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Данные=Запрос.Выполнить().Выгрузить();

	Строка=Неопределено;

	Для Каждого Запись Из Данные Цикл
		Если Строка = Неопределено Или Строка.Сотрудник <> Запись.Сотрудник Тогда
			Строка = ТабельГоризонтальный.Добавить();
			Строка.Сотрудник = Запись.Сотрудник;
		КонецЕсли;
		Д = День(Запись.Дата);
		Строка["День_" + Формат(Д, "ЧЦ=2;")] = Запись.Часы;
	КонецЦикла;

КонецПроцедуры

// Параметры:
// Документ - ДокументОбъект.ТабельРабочегоВремени
&НаСервере
Функция ЗаписатьТабель(Документ)
	Документ.Табель.Очистить();
	Дней = День(КонецМесяца(Объект.ПериодТабеля));

	Для Каждого Строка Из ТабельГоризонтальный Цикл
		Для Д = 1 По Дней Цикл
			Если Строка["День_" + Формат(Д, "ЧЦ=2;")] > 0 Тогда
				ЗаписьТабеля = Документ.Табель.Добавить();
				ЗаписьТабеля.Сотрудник = Строка["Сотрудник"];
				ЗаписьТабеля.Дата = Дата(Год(Объект.ПериодТабеля), Месяц(Объект.ПериодТабеля), Д);
				Если Строка["День_" + Формат(Д, "ЧЦ=2;")] < 25 Тогда
					ЗаписьТабеля.Часы = Строка["День_" + Формат(Д, "ЧЦ=2;")];
				Иначе
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Неверное ко-во часов";
					ИндексСтроки = ТабельГоризонтальный.Индекс(Строка);
					Сообщение.Поле = "ТабельГоризонтальный[" + Формат(ИндексСтроки, "ЧГ=0") + "].День_"+ Формат(Д, "ЧЦ=2;");
					Сообщение.УстановитьДанные(ТабельГоризонтальный);
					Сообщение.Сообщить();
					Возврат Истина;
				КонецЕсли;

			КонецЕсли;

		КонецЦикла;
	КонецЦикла;

КонецФункции

&НаСервере
Процедура ПериодТабеляПриИзмененииНаСервере()
	Дней = День(КонецМесяца(Объект.ПериодТабеля));
	Для Д = 28 По Дней Цикл
		Элем = Элементы.Найти("ТабельДень_" + Формат(Д, "ЧЦ=2;"));
		Если Элем <> Неопределено Тогда
			Элем.Видимость = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Дней < 31 Тогда
		Для Д = Дней + 1 По 31 Цикл
			Элем = Элементы.Найти("ТабельДень_" + Формат(Д, "ЧЦ=2;"));
			Если Элем <> Неопределено Тогда
				Элем.Видимость = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Элементы.ТабельГоризонтальный.Видимость = Истина;
КонецПроцедуры

&НаКлиенте
Функция ПроверитьПериод()
	
	Если ЗначениеЗаполнено(Объект.ПериодТабеля) Тогда
		Возврат Истина;
	КонецЕсли;
	ПоказатьПредупреждение(, "Укажите период табеля.");
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСтрокуНаСервере(ИдентификаторСтроки)
	
	СтрокаТабеля = ТабельГоризонтальный.НайтиПоИдентификатору(ИдентификаторСтроки);
	ЗаполнитьСтрокуПоГрафику(СтрокаТабеля);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВсехНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Сотрудник
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	НЕ Сотрудники.ПометкаУдаления
	|	И Сотрудники.Подразделение = &Магазин
	|	И Сотрудники.Должность.ГрафикРаботы <> ЗНАЧЕНИЕ(Справочник.ГрафикиРаботы.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудники.Наименование";
	Запрос.УстановитьПараметр("Магазин", Объект.Магазин);
	
	ТабельГоризонтальный.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаТабеля = ТабельГоризонтальный.Добавить();
		СтрокаТабеля.Сотрудник = Выборка.Сотрудник;
		ЗаполнитьСтрокуПоГрафику(СтрокаТабеля);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокуПоГрафику(СтрокаТабеля)
	
	График = СтрокаТабеля.Сотрудник.Должность.ГрафикРаботы;
	Если Не ЗначениеЗаполнено(График) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "У должности сотрудника " + Строка(СтрокаТабеля.Сотрудник) + " не задан график работы.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Дней = День(КонецМесяца(Объект.ПериодТабеля));
	Для День = 1 По 31 Цикл
		СтрокаТабеля["День_" + Формат(День, "ЧЦ=2;")] = 0;
	КонецЦикла;
	
	РабочиеДаты = Справочники.ГрафикиРаботы.РабочиеДатыПредыдущегоМесяца(
		СтрокаТабеля.Сотрудник, Объект.ПериодТабеля, Объект.Ссылка);
	Начало = НачалоМесяца(Объект.ПериодТабеля);
	Для День = 1 По Дней Цикл
		ДатаДня = Начало + (День - 1) * 86400;
		Часы = Справочники.ГрафикиРаботы.ЧасыНаДату(График, ДатаДня, РабочиеДаты);
		СтрокаТабеля["День_" + Формат(День, "ЧЦ=2;")] = Часы;
		Если Часы > 0 Тогда
			РабочиеДаты.Вставить(НачалоДня(ДатаДня), Истина);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти