// @strict-types


#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) <> Тип("ДокументСсылка.Перемещение") Тогда
		Возврат;
	КонецЕсли;
	ДокументОснование = ДанныеЗаполнения;
	Склад = ДанныеЗаполнения.Получатель;
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	СписокНоменклатуры.Очистить();
	Для Каждого СтрокаОснования Из ДанныеЗаполнения.СписокНоменклатуры Цикл
		НоваяСтрока = СписокНоменклатуры.Добавить();
		НоваяСтрока.Номенклатура = СтрокаОснования.Номенклатура;
		НоваяСтрока.Количество = СтрокаОснования.Количество;
	КонецЦикла;
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	ИндексКонтрагента = ПроверяемыеРеквизиты.Найти("Контрагент");
	Если ИндексКонтрагента <> Неопределено Тогда
		ПроверяемыеРеквизиты.Удалить(ИндексКонтрагента);
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		ПровестиПоступлениеПоПеремещению(Отказ);
	Иначе
		ПровестиПоступлениеНаСклад();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПровестиПоступлениеНаСклад()
	Движения.НакопленияНоменклатуры.Записывать = Истина;
	Для Каждого Строка Из СписокНоменклатуры Цикл
		Движение = Движения.НакопленияНоменклатуры.Добавить();
		Движение.Период = Дата;
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Магазин = Склад;
		Движение.Контрагент = Контрагент;
		Движение.Номенклатура = Строка.Номенклатура;
		Движение.Количество = Строка.Количество;
	КонецЦикла;
КонецПроцедуры

Процедура ПровестиПоступлениеПоПеремещению(Отказ)
	Если НЕ ДокументОснование.Проведен Тогда
		Отказ = Истина;
		СообщитьПользователю("Сначала проведите документ перемещения.");
		Возврат;
	КонецЕсли;
	Если Дата < ДокументОснование.Дата Тогда
		Отказ = Истина;
		СообщитьПользователю("Дата прихода не может быть раньше даты перемещения.");
		Возврат;
	КонецЕсли;
	Если Склад <> ДокументОснование.Получатель Тогда
		Отказ = Истина;
		СообщитьПользователю("Склад прихода должен совпадать со складом-получателем перемещения.");
		Возврат;
	КонецЕсли;
	Если СписокНоменклатуры.Количество() = 0 Тогда
		Отказ = Истина;
		СообщитьПользователю("Заполните список номенклатуры.");
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаТовара Из СписокНоменклатуры Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Или СтрокаТовара.Количество <= 0 Тогда
			Отказ = Истина;
			СообщитьПользователю("В каждой строке укажите номенклатуру и количество больше нуля.");
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Нехватка = НехваткаВПеремещении();
	Если Нехватка.Количество() > 0 Тогда
		Отказ = Истина;
		Для Каждого СтрокаНехватки Из Нехватка Цикл
			СообщитьПользователю(СтрШаблон(
				"По номенклатуре %1 в перемещении остаток %2, к поступлению %3.",
				СтрокаНехватки.Номенклатура,
				СтрокаНехватки.Остаток,
				СтрокаНехватки.Количество));
		КонецЦикла;
		Возврат;
	КонецЕсли;

	Движения.ПеремещениеНоменклатуры.Записывать = Истина;
	Движения.НакопленияНоменклатуры.Записывать = Истина;
	Для Каждого СтрокаТовара Из СписокНоменклатуры Цикл
		ДвижениеРасход = Движения.ПеремещениеНоменклатуры.Добавить();
		ДвижениеРасход.Период = Дата;
		ДвижениеРасход.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвижениеРасход.Номенклатура = СтрокаТовара.Номенклатура;
		ДвижениеРасход.ДокументПеремещение = ДокументОснование;
		ДвижениеРасход.Магазин = ДокументОснование.Получатель;
		ДвижениеРасход.Количество = СтрокаТовара.Количество;

		ДвижениеПриход = Движения.НакопленияНоменклатуры.Добавить();
		ДвижениеПриход.Период = Дата;
		ДвижениеПриход.ВидДвижения = ВидДвиженияНакопления.Приход;
		ДвижениеПриход.Магазин = Склад;
		ДвижениеПриход.Номенклатура = СтрокаТовара.Номенклатура;
		ДвижениеПриход.Количество = СтрокаТовара.Количество;
	КонецЦикла;
КонецПроцедуры

Функция НехваткаВПеремещении()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Количество КАК Количество
	|ПОМЕСТИТЬ ВТТоварыДокумента
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТТоварыДокумента.Номенклатура КАК Номенклатура,
	|	СУММА(ВТТоварыДокумента.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТТовары
	|ИЗ
	|	ВТТоварыДокумента КАК ВТТоварыДокумента
	|СГРУППИРОВАТЬ ПО
	|	ВТТоварыДокумента.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТТовары.Номенклатура КАК Номенклатура,
	|	ВТТовары.Количество КАК Количество,
	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Остаток
	|ИЗ
	|	ВТТовары КАК ВТТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПеремещениеНоменклатуры.Остатки(
	|			&Момент,
	|			ДокументПеремещение = &ДокументПеремещение
	|				И Магазин = &Магазин) КАК Остатки
	|		ПО ВТТовары.Номенклатура = Остатки.Номенклатура
	|ГДЕ
	|	ВТТовары.Количество > ЕСТЬNULL(Остатки.КоличествоОстаток, 0)";
	Запрос.УстановитьПараметр("Товары", СписокНоменклатуры.Выгрузить(, "Номенклатура, Количество"));
	Запрос.УстановитьПараметр("Момент", Новый Граница(МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ДокументПеремещение", ДокументОснование);
	Запрос.УстановитьПараметр("Магазин", ДокументОснование.Получатель);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура СообщитьПользователю(ТекстСообщения)
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
КонецПроцедуры

#КонецОбласти

#КонецЕсли
