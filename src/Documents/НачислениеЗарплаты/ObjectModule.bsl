#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьРасчет() Экспорт
	
	Начисления.Очистить();
	Удержания.Очистить();
	Если Не ЗначениеЗаполнено(Сотрудник) Или Не ЗначениеЗаполнено(ПериодРегистрации) Тогда
		Возврат;
	КонецЕсли;
	Ведомость = РасчетЗарплаты.РассчитатьСотрудника(Сотрудник, ПериодРегистрации, Ссылка);
	Для Каждого СтрокаНачисления Из Ведомость.Начисления Цикл
		ЗаполнитьЗначенияСвойств(Начисления.Добавить(), СтрокаНачисления);
	КонецЦикла;
	Для Каждого СтрокаУдержания Из Ведомость.Удержания Цикл
		ЗаполнитьЗначенияСвойств(Удержания.Добавить(), СтрокаУдержания);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Не ЗначениеЗаполнено(Сотрудник) Или Не ЗначениеЗаполнено(ПериодРегистрации) Тогда
		Возврат;
	КонецЕсли;
	Существующий = Документы.НачислениеЗарплаты.НайтиПоСотруднику(Сотрудник, ПериодРегистрации);
	Если ЗначениеЗаполнено(Существующий) И Существующий <> Ссылка Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Начисление этому сотруднику за " + Формат(ПериодРегистрации, "ДФ='MMMM yyyy'") + " уже есть.";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Или РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ПериодРегистрации) Тогда
		ПериодРегистрации = НачалоМесяца(ПериодРегистрации);
		Дата = ПериодРегистрации;
	КонецЕсли;
	//ЗаполнитьРасчет();
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.Начисления.Записывать = Истина;
	Движения.Удержания.Записывать = Истина;
	Начало = НачалоМесяца(ПериодРегистрации);
	Конец = КонецМесяца(ПериодРегистрации);
	
	Для Каждого СтрокаНачисления Из Начисления Цикл
		Движение = Движения.Начисления.Добавить();
		Движение.ВидРасчета = СтрокаНачисления.ВидРасчета;
		Движение.Сотрудник = Сотрудник;
		Движение.Результат = СтрокаНачисления.Результат;
		Движение.ОтработаноЧасов = СтрокаНачисления.ОтработаноЧасов;
		Движение.Тариф = СтрокаНачисления.Тариф;
		Движение.ПериодДействияНачало = Начало;
		Движение.ПериодДействияКонец = Конец;
		Движение.ПериодРегистрации=Начало;
		Движение.БазовыйПериодНачало = Начало;
		Движение.БазовыйПериодКонец = Конец;
	КонецЦикла;
	
	Оплачено = РасчетЗарплаты.ОплачиваемыеЧасы(Сотрудник, ПериодРегистрации);
	РасчетЗарплаты.ЗаписатьГрафик(Сотрудник, ПериодРегистрации, Оплачено.ПоДням);
	Движения.Начисления.Записать();
	Попытка
		ДанныеГрафика = Движения.Начисления.ПолучитьДанныеГрафика(
			Новый Массив, ВидПериодаРегистраРасчета.ФактическийПериодДействия);
		Для Каждого СтрокаГрафика Из ДанныеГрафика Цикл
			Движение = Движения.Начисления[СтрокаГрафика.НомерСтроки - 1];
			Если Движение.ВидРасчета <> ПланыВидовРасчета.Начисления.ОсновноеНачисление Тогда
				Продолжить;
			КонецЕсли;
			Движение.ОтработаноЧасов = СтрокаГрафика.ЧасыФактическийПериодДействия;
			Движение.Результат = Окр(Движение.ОтработаноЧасов * Движение.Тариф, 2);
		КонецЦикла;
	Исключение
		// Сумма уже посчитана как часы табеля на тариф.
	КонецПопытки;
	
	Начислено = 0;
	Для Каждого Движение Из Движения.Начисления Цикл
		Начислено = Начислено + Движение.Результат;
	КонецЦикла;
	База = Начислено + РасчетЗарплаты.СуммаНачислений(Сотрудник, ПериодРегистрации, Ссылка);
	Для Каждого СтрокаУдержания Из РасчетЗарплаты.УдержанияСотрудника(Сотрудник, База, РасчетЗарплаты.СтавкаНДФЛ()) Цикл
		Движение = Движения.Удержания.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, СтрокаУдержания);
		Движение.Сотрудник = Сотрудник;
		Движение.ПериодРегистрации = Начало;
		Движение.БазовыйПериодНачало = Начало;
		Движение.БазовыйПериодКонец = Конец;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
