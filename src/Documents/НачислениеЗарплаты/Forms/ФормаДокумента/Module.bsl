#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Рассчитать(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Сотрудник) Или Не ЗначениеЗаполнено(Объект.ПериодРегистрации) Тогда
		ПоказатьПредупреждение(, "Укажите сотрудника и месяц.");
		Возврат;
	КонецЕсли;
	РассчитатьНаСервере();
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура РассчитатьНаСервере()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ПериодРегистрации = НачалоМесяца(ДокументОбъект.ПериодРегистрации);
	ДокументОбъект.ЗаполнитьРасчет();
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
КонецПроцедуры

#КонецОбласти
