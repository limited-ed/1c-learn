#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция НайтиПоСотруднику(Сотрудник, Период) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Начисление.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.НачислениеЗарплаты КАК Начисление
	|ГДЕ
	|	Начисление.Сотрудник = &Сотрудник
	|	И НАЧАЛОПЕРИОДА(Начисление.ПериодРегистрации, МЕСЯЦ) = &Период
	|	И НЕ Начисление.ПометкаУдаления";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Период", НачалоМесяца(Период));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Документы.НачислениеЗарплаты.ПустаяСсылка();
	
КонецФункции

Функция СоздатьЗаМесяц(Период, Магазин) Экспорт
	
	Начало = НачалоМесяца(Период);
	Создано = 0;
	Обновлено = 0;
	Ошибки = Новый Массив;
	Для Каждого Сотрудник Из Сотрудники(Магазин) Цикл
		Существующий = Документы.НачислениеЗарплаты.ПустаяСсылка();
		Попытка
			Существующий = НайтиПоСотруднику(Сотрудник, Начало);
			Если ЗначениеЗаполнено(Существующий) Тогда
				ДокументОбъект = Существующий.ПолучитьОбъект();
				Обновлено = Обновлено + 1;
			Иначе
				ДокументОбъект = Документы.НачислениеЗарплаты.СоздатьДокумент();
				ДокументОбъект.Сотрудник = Сотрудник;
				Создано = Создано + 1;
			КонецЕсли;
			ДокументОбъект.ПериодРегистрации = Начало;
			ДокументОбъект.Дата = Начало;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Ошибки.Добавить(Строка(Сотрудник) + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Если ЗначениеЗаполнено(Существующий) Тогда
				Обновлено = Обновлено - 1;
			Иначе
				Создано = Создано - 1;
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
	Возврат Новый Структура("Создано, Обновлено, Ошибки", Создано, Обновлено, Ошибки);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Сотрудники(Магазин)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Сотрудник
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	НЕ Сотрудники.ПометкаУдаления
	|	И (&БезМагазина
	|		ИЛИ Сотрудники.Подразделение = &Магазин)
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудники.Наименование";
	Запрос.УстановитьПараметр("Магазин", Магазин);
	Запрос.УстановитьПараметр("БезМагазина", Не ЗначениеЗаполнено(Магазин));
	Сотрудники = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Сотрудники.Добавить(Выборка.Сотрудник);
	КонецЦикла;
	Возврат Сотрудники;
	
КонецФункции

#КонецОбласти

#КонецЕсли
