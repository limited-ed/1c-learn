#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) <> Тип("ДокументСсылка.Продажа") Тогда
		Возврат;
	КонецЕсли;
	ДокументОснование = ДанныеЗаполнения;
	ЗаполнитьПоОснованию();
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		Отказ = Истина;
		СообщитьПользователю("Укажите документ продажи.");
		Возврат;
	КонецЕсли;
	ПереместитьРезерв(Отказ);

	Если Не Документы.ВыдачаТовара.ЕстьВыдачаПоПродаже(ДокументОснование) Тогда
		СоздатьВыдачу(Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	СоздатьСчетФактуру(Отказ);
КонецПроцедуры

Процедура СоздатьВыдачу(Отказ)
	Выдача = Документы.ВыдачаТовара.СоздатьДокумент();
	Выдача.Дата = Дата;
	Выдача.ДокументПродажа = ДокументОснование;
	Для Каждого СтрокаТовара Из ДокументОснование.Товары Цикл
		НоваяСтрока = Выдача.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовара);
	КонецЦикла;
	Попытка
		Выдача.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Отказ = Истина;
		СообщитьПользователю("Не удалось создать выдачу товара.");
	КонецПопытки;
КонецПроцедуры

Процедура СоздатьСчетФактуру(Отказ)
	Если ЗначениеЗаполнено(Документы.СчетФактура.НайтиПоПодтверждению(Ссылка)) Тогда
		Возврат;
	КонецЕсли;
	СчетФактура = Документы.СчетФактура.СоздатьДокумент();
	СчетФактура.Дата = Дата;
	СчетФактура.ЗаполнитьПоПродаже(ДокументОснование, Ссылка);
	Попытка
		СчетФактура.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Отказ = Истина;
		СообщитьПользователю("Не удалось создать счет-фактуру: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

Процедура ПереместитьРезерв(Отказ)
	Движения.РезервНоменклатуры.Записывать = Истина;
	Движения.ВыдачаНоменклатуры.Записывать = Истина;
	Движения.НакопленияНоменклатуры.Записывать = Истина;
	
	Для Каждого Элемент Из ДокументОснование.Товары Цикл
		ДвижениеНакопления = Движения.НакопленияНоменклатуры.Добавить();
		ДвижениеНакопления.Период = Дата;
		ДвижениеНакопления.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвижениеНакопления.Магазин = ДокументОснование.Магазин;
		ДвижениеНакопления.Номенклатура = Элемент.Номенклатура;
		ДвижениеНакопления.Количество=Элемент.Количество;
		
		ДвижениеРезерв = Движения.РезервНоменклатуры.Добавить();
		ДвижениеРезерв.Период = Дата;
		ДвижениеРезерв.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвижениеРезерв.Магазин = ДокументОснование.Магазин;
		ДвижениеРезерв.Номенклатура = Элемент.Номенклатура;
		ДвижениеРезерв.Количество = Элемент.Количество;

		ДвижениеВыдача = Движения.ВыдачаНоменклатуры.Добавить();
		ДвижениеВыдача.Период = Дата;
		ДвижениеВыдача.ВидДвижения = ВидДвиженияНакопления.Приход;
		ДвижениеВыдача.Магазин = ДокументОснование.Магазин;
		ДвижениеВыдача.Номенклатура = Элемент.Номенклатура;
		ДвижениеВыдача.Количество = Элемент.Количество;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПоОснованию()
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	Сумма = ДокументОснование.СуммаДокумента;
	Если Не ЗначениеЗаполнено(ДатаОплаты) Тогда
		ДатаОплаты = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
КонецПроцедуры

Процедура СообщитьПользователю(ТекстСообщения)
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
КонецПроцедуры

#КонецОбласти

#КонецЕсли