#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ПечатнаяФорма(Ссылка) Экспорт
	
	ДокументОбъект = Ссылка.ПолучитьОбъект();
	ТабличныйДокумент = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет("ФормаТ1");
	Область = Макет.ПолучитьОбласть("Приказ");
	Область.Параметры.Заполнить(ДокументОбъект);
	Область.Параметры.Организация = "Магазин электроники";
	Область.Параметры.Номер = ДокументОбъект.Номер;
	Область.Параметры.Дата = Формат(ДокументОбъект.Дата, "ДЛФ=D");
	Область.Параметры.ДатаПриема = Формат(ДокументОбъект.ДатаПриема, "ДЛФ=D");
	Область.Параметры.ДатаРождения = Формат(ДокументОбъект.ДатаРождения, "ДЛФ=D");
	Область.Параметры.Подразделение = ДокументОбъект.Подразделение;
	Область.Параметры.Должность = ДокументОбъект.Должность;
	Область.Параметры.Оклад = Формат(ДокументОбъект.Оклад, "ЧДЦ=2");
	Если ЗначениеЗаполнено(ДокументОбъект.Сотрудник) Тогда
		Область.Параметры.ТабельныйНомер = ДокументОбъект.Сотрудник.Код;
	КонецЕсли;
	ТабличныйДокумент.Вывести(Область);
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#КонецЕсли
