#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

//Параметры:
// Ссылка - ДокументСсылка.ПриказПрием
Функция ПечатнаяФорма(Ссылка) Экспорт

	ДокументОбъект = Ссылка.ПолучитьОбъект();
	ТабличныйДокумент = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет("ФормаТ1");
	Область = Макет.ПолучитьОбласть("Приказ");
	Область.Параметры.ФИО = ДокументОбъект.ФИО;
	Область.Параметры.ТабельныйНомер = ДокументОбъект.ТабельныйНомер;
	Область.Параметры.Организация = Константы.НаименованиеОрганизации.Получить();
	Область.Параметры.Номер = ДокументОбъект.Номер;
	Область.Параметры.Дата = Формат(ДокументОбъект.Дата, "ДЛФ=D");
	Область.Параметры.ДатаПриема = Формат(ДокументОбъект.ДатаПриема, "ДЛФ=D");
	Если ЗначениеЗаполнено(ДокументОбъект.ДатаОкончания) Тогда
		Область.Параметры.ДатаОкончания = Формат(ДокументОбъект.ДатаОкончания, "ДЛФ=D");
	КонецЕсли;

	Область.Параметры.Подразделение = ДокументОбъект.Подразделение.Наименование;
	Область.Параметры.Должность = ДокументОбъект.Должность;
	Если ЗначениеЗаполнено(ДокументОбъект.Условия) Тогда
		Область.Параметры.Условия = ДокументОбъект.Условия;
	КонецЕсли;

	Область.Параметры.ТарифРуб = Формат(ДокументОбъект.Должность.ТарифЧас, "ЧЦ=6;");
	Область.Параметры.ТарифКоп = Формат(ДокументОбъект.Должность.ТарифЧас - Цел(ДокументОбъект.Должность.ТарифЧас),
		"ЧН=00;");
	Если ЗначениеЗаполнено(ДокументОбъект.Надбавка) Тогда
		Область.Параметры.НадбавкаРуб = Формат(ДокументОбъект.Должность.ТарифЧас, "ЧЦ=6;");
		Область.Параметры.НадбавкаКоп = Формат(ДокументОбъект.Должность.ТарифЧас - Цел(
			ДокументОбъект.Должность.ТарифЧас), "ЧН=00;");
	КонецЕсли;
	Если ЗначениеЗаполнено(ДокументОбъект.ИспытательныйСрок) Тогда
		Область.Параметры.ИспытательныйСрок = ДокументОбъект.ИспытательныйСрок + "( " + ЧислоПрописью(
			ДокументОбъект.ИспытательныйСрок) + ")";
	КонецЕсли;
	ДатаСост = СтрРазделить(Формат(ДокументОбъект.ДатаДоговора, "ДЛФ=DD;"), " ");
	Область.Параметры.ДЧисло = ДатаСост[0];
	Область.Параметры.ДМесяц = ДатаСост[1];
	Область.Параметры.ДГод = Сред(ДатаСост[2], 3, 2);
	Область.Параметры.ДНомер = ДокументОбъект.НомерДоговора;

	Руководитель = Справочники.Сотрудники.НайтиПоРеквизиту("Руководитель", Истина);
	Если ЗначениеЗаполнено(Руководитель) Тогда
		Область.Параметры.РуководительДолжность = Руководитель.Должность.Наименование;
		Область.Параметры.РуководительФио = Руководитель.Наименование;
	КонецЕсли;

	ДатаСост = СтрРазделить(Формат(ДокументОбъект.Дата, "ДЛФ=DD;"), " ");
	Область.Параметры.ОзЧисло = ДатаСост[0];
	Область.Параметры.ОзМесяц = ДатаСост[1];
	Область.Параметры.ОзГод = Сред(ДатаСост[2], 3, 2);
	ТабличныйДокумент.Вывести(Область);
	Возврат ТабличныйДокумент;

КонецФункции

#КонецОбласти

#КонецЕсли