#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(ДатаПриема) Тогда
		ДатаПриема = ТекущаяДатаСеанса();
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		СотрудникОбъект = Сотрудник.ПолучитьОбъект();
	Иначе
		СотрудникОбъект = Справочники.Сотрудники.СоздатьЭлемент();
	КонецЕсли;
	
	СотрудникОбъект.Наименование = ФИО;
	СотрудникОбъект.ДатаРождения = ДатаРождения;
	СотрудникОбъект.Телефон = Телефон;
	СотрудникОбъект.Адрес = Адрес;
	СотрудникОбъект.Подразделение = Подразделение;
	СотрудникОбъект.Должность = Должность;
	СотрудникОбъект.Статус = Перечисления.СтатусыСотрудников.ПринятНаРаботу;
	СотрудникОбъект.Записать();
	Сотрудник = СотрудникОбъект.Ссылка;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
