#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(ДатаПриема) Тогда
		ДатаПриема = ТекущаяДатаСеанса();
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Сотрудник = Справочники.Сотрудники.НайтиПоРеквизиту("ТабельныйНомер", ТабельныйНомер );
	
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		СотрудникОбъект = Сотрудник.ПолучитьОбъект();
	Иначе
		СотрудникОбъект = Справочники.Сотрудники.СоздатьЭлемент();
	КонецЕсли;

	СотрудникОбъект.Наименование = ФИО;
	СотрудникОбъект.ДатаРождения = ДатаРождения;
	СотрудникОбъект.Телефон = Телефон;
	СотрудникОбъект.Адрес = Адрес;
	СотрудникОбъект.Подразделение = Подразделение;
	СотрудникОбъект.Должность = Должность;
	СотрудникОбъект.Статус = Перечисления.СтатусыСотрудников.ПринятНаРаботу;
	СотрудникОбъект.ТабельныйНомер = ТабельныйНомер;
	СотрудникОбъект.ПриказНаПрием = Номер;
	СотрудникОбъект.Записать();

	Договор = Справочники.ТрудовыеДоговора.НайтиПоКоду(НомерДоговора);
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Договор = Справочники.ТрудовыеДоговора.СоздатьЭлемент();
		Договор.Код = НомерДоговора;
		Договор.Дата = ДатаДоговора;
		Договор.Сотрудник = Сотрудник.Ссылка;
		Договор.Записать();
	КонецЕсли;


КонецПроцедуры


Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если Не ЗначениеЗаполнено(ТабельныйНомер) Тогда
			ТабельныйНомер = Формат(Подразделение.Код, "ЧЦ=3;") + "-" + СгенерироватьУникальныйТабельныйНомер();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
Функция СгенерироватьУникальныйТабельныйНомер(ДлинаНомера = 6)

	ГСЧ = Новый ГенераторСлучайныхЧисел;
	МинЗначение = Pow(10, ДлинаНомера - 1);
	МаксЗначение = Pow(10, ДлинаНомера) - 1;

	Пока Истина Цикл
		СлучайноеЧисло = ГСЧ.СлучайноеЧисло(МинЗначение, МаксЗначение);
		НовыйКод = Формат(СлучайноеЧисло, "ЧГ=0"); 
		
		// Проверяем, свободен ли код в справочнике Сотрудники
		Если Не ЗначениеЗаполнено(Справочники.Сотрудники.НайтиПоКоду(НовыйКод)) Тогда
			Возврат НовыйКод;
		КонецЕсли;
	КонецЦикла;

КонецФункции

#КонецЕсли