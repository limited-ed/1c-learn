#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Печать(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Перед печатью запишите документ.");
		Возврат;
	КонецЕсли;
	
	Коллекция = МодульПечати.СоздатьКоллекциюДокументовДляПечати();
	СтрокаПечати = Коллекция.Добавить();
	СтрокаПечати.ИмяДокумента = "Приказ о приеме на работу (форма № Т-1)";
	СтрокаПечати.Документ = ПечатнаяФормаНаСервере();
	МодульПечати.ВывестиДокументы(Коллекция);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПечатнаяФормаНаСервере()
	Возврат Документы.ПриказПрием.ПечатнаяФорма(Объект.Ссылка);
КонецФункции

#КонецОбласти
