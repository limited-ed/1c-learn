#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Сумма <= 0 Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Сумма удержания должна быть больше нуля.";
		Сообщение.Поле = "Сумма";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.Удержания.Записывать = Истина;
	Движение = Движения.Удержания.Добавить();
	Движение.ВидРасчета = ПланыВидовРасчета.Удержания.ПорчаТоваров;
	Движение.Сотрудник = Сотрудник;
	Движение.Результат = Сумма;
	Движение.База = Сумма;
	Движение.ПериодРегистрации = НачалоМесяца(Дата);
	Движение.БазовыйПериодНачало = НачалоМесяца(Дата);
	Движение.БазовыйПериодКонец = КонецМесяца(Дата);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
