#Область ПрограммныйИнтерфейс

Функция ПечатнаяФорма(Ссылка) Экспорт
	
	ДокументОбъект = Ссылка.ПолучитьОбъект();
	Макет = Документы.УдержаниеЗаПорчу.ПолучитьМакет("Акт");
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	Область = Макет.ПолучитьОбласть("Акт");
	Область.Параметры.Номер = ДокументОбъект.Номер;
	Область.Параметры.Дата = Формат(ДокументОбъект.Дата, "ДЛФ=D");
	Область.Параметры.Сотрудник = Строка(ДокументОбъект.Сотрудник);
	Область.Параметры.Подразделение = Строка(ДокументОбъект.Сотрудник.Подразделение);
	Область.Параметры.Номенклатура = Строка(ДокументОбъект.Номенклатура);
	Область.Параметры.Количество = Формат(ДокументОбъект.Количество, "ЧДЦ=3");
	Область.Параметры.Сумма = Формат(ДокументОбъект.Сумма, "ЧДЦ=2");
	Область.Параметры.Причина = ДокументОбъект.Причина;
	ТабличныйДокумент.Вывести(Область);
	Возврат ТабличныйДокумент;
	
КонецФункции

