// @strict-types


#Область ОписаниеПеременных

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.ГруппаФотографии.Видимость = Не Объект.ЭтоГруппа;
	Если ТолькоПросмотр Тогда
		Элементы.КнопкаДобавитьФото.Доступность = Ложь;
		Элементы.КнопкаУдалитьФото.Доступность = Ложь;
		Элементы.КнопкаСделатьОсновным.Доступность = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПоказатьТекущееФото();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

&НаКлиенте
Процедура ФотографииПриАктивизацииСтроки(Элемент)

	ПоказатьТекущееФото();

КонецПроцедуры

&НаКлиенте
Процедура ФотографииПослеУдаления(Элемент)

	НазначитьОсновноеФотоЕслиНет();
	ПоказатьТекущееФото();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьФото(Команда)

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = НСтр("ru = 'Выбор фотографий'");
	ПараметрыДиалога.Фильтр = НСтр("ru = 'Изображения (*.jpg;*.jpeg;*.png;*.gif;*.bmp)|*.jpg;*.jpeg;*.png;*.gif;*.bmp'");
	ПараметрыДиалога.МножественныйВыбор = Истина;

	ОписаниеОповещения = Новый ОписаниеОповещения("ДобавитьФотоЗавершение", ЭтотОбъект);
	НачатьПомещениеФайловНаСервер(ОписаниеОповещения, , , ПараметрыДиалога, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура СделатьОсновным(Команда)

	ТекущиеДанные = Элементы.Фотографии.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СделатьОсновнымНаСервере(ТекущиеДанные.ПолучитьИдентификатор());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ДобавитьФотоЗавершение(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт

	Если ПомещенныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОписанияФайлов = Новый Массив;
	Для Каждого ПомещенныйФайл Из ПомещенныеФайлы Цикл
		Если ПомещенныйФайл.ПомещениеФайлаОтменено Тогда
			Продолжить;
		КонецЕсли;
		ОписанияФайлов.Добавить(Новый Структура("Адрес, ИмяФайла", ПомещенныйФайл.Адрес, ПомещенныйФайл.СсылкаНаФайл.Имя));
	КонецЦикла;

	Если ОписанияФайлов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторСтроки = ДобавитьФотоНаСервере(ОписанияФайлов);
	Если ИдентификаторСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Элементы.Фотографии.ТекущаяСтрока = ИдентификаторСтроки;
	ПоказатьТекущееФото();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьТекущееФото()

	ТекущиеДанные = Элементы.Фотографии.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		АдресКартинки = "";
		Возврат;
	КонецЕсли;

	АдресКартинки = АдресФотографии(ТекущиеДанные.ПолучитьИдентификатор());

КонецПроцедуры

&НаСервере
Функция ДобавитьФотоНаСервере(ОписанияФайлов)

	ИдентификаторПоследнейСтроки = Неопределено;
	Ошибки = Новый Массив;
	ЕстьОсновное = Объект.Фотографии.НайтиСтроки(Новый Структура("Основное", Истина)).Количество() > 0;
	МаксимальныйРазмер = 10 * 1024 * 1024;

	Для Каждого ОписаниеФайла Из ОписанияФайлов Цикл

		ДвоичныеДанные = ПолучитьИзВременногоХранилища(ОписаниеФайла.Адрес);
		УдалитьИзВременногоХранилища(ОписаниеФайла.Адрес);
		Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Или ДвоичныеДанные.Размер() = 0 Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = '%1: не удалось прочитать файл.'"), ОписаниеФайла.ИмяФайла));
			Продолжить;
		КонецЕсли;

		Если ДвоичныеДанные.Размер() > МаксимальныйРазмер Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = '%1: размер больше 10 МБ.'"), ОписаниеФайла.ИмяФайла));
			Продолжить;
		КонецЕсли;

		Если Не ЭтоДопустимоеИзображение(ДвоичныеДанные) Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = '%1: допустимы файлы JPG, PNG, GIF и BMP.'"), ОписаниеФайла.ИмяФайла));
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Объект.Фотографии.Добавить();
		НоваяСтрока.Фото = Новый ХранилищеЗначения(ДвоичныеДанные, Новый СжатиеДанных(9));
		НоваяСтрока.ИмяФайла = ОписаниеФайла.ИмяФайла;
		Если Не ЕстьОсновное Тогда
			НоваяСтрока.Основное = Истина;
			ЕстьОсновное = Истина;
		КонецЕсли;

		ИдентификаторПоследнейСтроки = НоваяСтрока.ПолучитьИдентификатор();

	КонецЦикла;

	Если ИдентификаторПоследнейСтроки <> Неопределено Тогда
		Модифицированность = Истина;
	КонецЕсли;

	Если Ошибки.Количество() > 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрСоединить(Ошибки, Символы.ПС);
		Сообщение.Сообщить();
	КонецЕсли;

	Возврат ИдентификаторПоследнейСтроки;

КонецФункции

&НаСервере
Функция АдресФотографии(ИдентификаторСтроки)

	СтрокаФото = Объект.Фотографии.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаФото = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ДвоичныеДанные = СтрокаФото.Фото.Получить();
	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		Возврат "";
	КонецЕсли;

	Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецФункции

&НаСервере
Процедура СделатьОсновнымНаСервере(ИдентификаторСтроки)

	СтрокаФото = Объект.Фотографии.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаФото = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаТаблицы Из Объект.Фотографии Цикл
		СтрокаТаблицы.Основное = Ложь;
	КонецЦикла;

	СтрокаФото.Основное = Истина;
	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Процедура НазначитьОсновноеФотоЕслиНет()

	Если Объект.Фотографии.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если Объект.Фотографии.НайтиСтроки(Новый Структура("Основное", Истина)).Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	Объект.Фотографии[0].Основное = Истина;
	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Функция ЭтоДопустимоеИзображение(ДвоичныеДанные)

	Формат = ФорматКартинки.НеизвестныйФормат;

	Попытка
		КартинкаФайла = Новый Картинка(ДвоичныеДанные);
		Формат = КартинкаФайла.Формат();
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат Формат = ФорматКартинки.JPEG
		Или Формат = ФорматКартинки.PNG
		Или Формат = ФорматКартинки.GIF
		Или Формат = ФорматКартинки.BMP;

КонецФункции

#КонецОбласти
