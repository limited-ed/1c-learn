// @strict-types
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Характеристики.Параметры.УстановитьЗначениеПараметра(
		"Номенклатура", Справочники.Номенклатура.ПустаяСсылка());

КонецПроцедуры

#КонецОбласти
#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура Следуещее(Команда)
	НомерФото = НомерФото + 1;
	Если НомерФото = Фотографии.Количество() - 1 Тогда
		Элементы.Следующее.Доступность = Ложь;
	КонецЕсли;
	Элементы.Предыдущее.Доступность = Истина;
	АдресКартинки = УстановитьФото(НомерФото, УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура Предыдущее(Команда)
	НомерФото = НомерФото - 1;
	Если НомерФото = 0 Тогда
		Элементы.Предыдущее.Доступность = Ложь;
	КонецЕсли;
	Элементы.Следующее.Доступность = Истина;
	АдресКартинки = УстановитьФото(НомерФото, УникальныйИдентификатор);
КонецПроцедуры
#КонецОбласти
#Область ОбработчикиСобытийЭлементовТаблицыФормы

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	Номенклатура = Элементы.Список.ТекущаяСтрока; // Тип: СправочникСсылка.Номенклатура

	Если Номенклатура.ЭтоГруппа Тогда
		Элементы.Следующее.Доступность = Ложь;
		Элементы.Предыдущее.Доступность = Ложь;
		Возврат;
	КонецЕсли;

	Характеристики.Параметры.УстановитьЗначениеПараметра("Номенклатура", Номенклатура);

	Запрос = Новый Запрос("ВЫБРАТЬ
						  |	Фотографии.Фото КАК Фото
						  |ИЗ
						  |	Справочник.Номенклатура.Фотографии КАК Фотографии
						  |ГДЕ
						  |	Фотографии.Ссылка = &Номенклатура");
	Запрос.Параметры.Вставить("Номенклатура", Номенклатура);
	Результат = Запрос.Выполнить().Выгрузить();
	Фотографии.Очистить();
	Для Каждого СтрокаИсточник Из Результат Цикл
		НоваяСтрока = Фотографии.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточник);
	КонецЦикла;
	Если Фотографии.Количество() > 0 Тогда
		НомерФото = 0;
		АдресКартинки = УстановитьФото(НомерФото, УникальныйИдентификатор);
		Если Фотографии.Количество() > 1 Тогда
			Элементы.Следующее.Доступность = Истина;
			Элементы.Предыдущее.Доступность = Ложь;
		КонецЕсли;
	Иначе
		АдресКартинки = "";
		Элементы.Следующее.Доступность = Ложь;
		Элементы.Предыдущее.Доступность = Ложь;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры:
// Номер - Число
// УникальныйИдентификатор - УникальныйИдентификатор
Функция УстановитьФото(Номер, УникальныйИдентификатор)

	ДвоичныеДанные = Фотографии[Номер].Фото.Получить();
	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		Возврат "";
	КонецЕсли;

	Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецФункции

#КонецОбласти