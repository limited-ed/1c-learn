#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Часы по графику на дату. Для графика 2 через 2 фаза цикла продолжается
// с рабочих дней из РабочиеДаты (обычно предыдущий месяц и уже рассчитанные дни).
//
// Параметры:
//  График - СправочникСсылка.ГрафикиРаботы
//  Дата - Дата
//  РабочиеДаты - Соответствие - ключ НачалоДня, значение Истина
//
// Возвращаемое значение:
//  Число - часы, 0 если выходной. Неопределено, если график не задан.
Функция ЧасыНаДату(График, Дата, РабочиеДаты) Экспорт
	
	Если Не ЗначениеЗаполнено(График) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Описание = ОписаниеГрафика(График);
	Если Описание.Вид = Перечисления.ВидГрафикаРаботы.ДваЧерезДва Тогда
		Фаза = ФазаДваЧерезДва(Дата, Описание.Якорь, РабочиеДаты);
		Если Фаза < 2 Тогда
			Возврат Описание.Часы;
		КонецЕсли;
		Возврат 0;
	КонецЕсли;
	
	Если ДеньНедели(Дата) <= 5 Тогда
		Возврат Описание.Часы;
	КонецЕсли;
	Возврат 0;
	
КонецФункции

Функция РабочиеДатыПредыдущегоМесяца(Сотрудник, Период, ТекущийДокумент) Экспорт
	
	НачалоПредыдущего = НачалоМесяца(ДобавитьМесяц(Период, -1));
	КонецПредыдущего = КонецМесяца(НачалоПредыдущего);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Табель.Дата КАК Дата
	|ИЗ
	|	Документ.ТабельРабочегоВремени.Табель КАК Табель
	|ГДЕ
	|	Табель.Сотрудник = &Сотрудник
	|	И Табель.Дата МЕЖДУ &Начало И &Конец
	|	И Табель.Часы > 0
	|	И НЕ Табель.Ссылка.ПометкаУдаления
	|	И Табель.Ссылка <> &ТекущийДокумент";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Начало", НачалоПредыдущего);
	Запрос.УстановитьПараметр("Конец", КонецПредыдущего);
	Запрос.УстановитьПараметр("ТекущийДокумент", ТекущийДокумент);
	
	РабочиеДаты = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		РабочиеДаты.Вставить(НачалоДня(Выборка.Дата), Истина);
	КонецЦикла;
	Возврат РабочиеДаты;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОписаниеГрафика(График)
	
	Вид = График.ВидГрафика;
	Если Не ЗначениеЗаполнено(Вид) Тогда
		Если График = Справочники.ГрафикиРаботы.Пятидневка Тогда
			Вид = Перечисления.ВидГрафикаРаботы.Пятидневка;
		ИначеЕсли График = Справочники.ГрафикиРаботы.ДваЧерезДва Тогда
			Вид = Перечисления.ВидГрафикаРаботы.ДваЧерезДва;
		Иначе
			Вид = Перечисления.ВидГрафикаРаботы.Пятидневка;
		КонецЕсли;
	КонецЕсли;
	
	Часы = График.ЧасыРаботы;
	Если Часы = 0 Тогда
		Если Вид = Перечисления.ВидГрафикаРаботы.ДваЧерезДва Тогда
			Часы = 12;
		Иначе
			Часы = 8;
		КонецЕсли;
	КонецЕсли;
	
	Якорь = График.ДатаНачалаЦикла;
	Если Не ЗначениеЗаполнено(Якорь) Тогда
		Якорь = Дата(2024, 1, 1);
	КонецЕсли;
	
	Возврат Новый Структура("Вид, Часы, Якорь", Вид, Часы, Якорь);
	
КонецФункции

Функция ФазаДваЧерезДва(Дата, Якорь, РабочиеДаты)
	
	ПоследнийРабочий = Неопределено;
	Для Каждого КлючИЗначение Из РабочиеДаты Цикл
		День = НачалоДня(КлючИЗначение.Ключ);
		Если День < НачалоДня(Дата) И (ПоследнийРабочий = Неопределено Или День > ПоследнийРабочий) Тогда
			ПоследнийРабочий = День;
		КонецЕсли;
	КонецЦикла;
	
	Если ПоследнийРабочий = Неопределено Тогда
		Возврат ФазаОтЯкоря(Дата, Якорь);
	КонецЕсли;
	
	ФазаПоследнего = 0;
	Если РабочиеДаты.Получить(ПоследнийРабочий - 86400) <> Неопределено Тогда
		ФазаПоследнего = 1;
	КонецЕсли;
	
	Сдвиг = (НачалоДня(Дата) - ПоследнийРабочий) / 86400;
	Возврат НормализоватьФазу(ФазаПоследнего + Сдвиг);
	
КонецФункции

Функция ФазаОтЯкоря(Дата, Якорь)
	
	Сдвиг = (НачалоДня(Дата) - НачалоДня(Якорь)) / 86400;
	Возврат НормализоватьФазу(Сдвиг);
	
КонецФункции

Функция НормализоватьФазу(Сдвиг)
	
	Фаза = Сдвиг - Цел(Сдвиг / 4) * 4;
	Пока Фаза < 0 Цикл
		Фаза = Фаза + 4;
	КонецЦикла;
	Возврат Фаза;
	
КонецФункции

#КонецОбласти

#КонецЕсли
