// @strict-types
#Область ОписаниеПеременных

#КонецОбласти

#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтотОбъект.Уволенные = Ложь;
	Список.Параметры.УстановитьЗначениеПараметра("Статус", Перечисления.СтатусыСотрудников.ПринятНаРаботу);
КонецПроцедуры
#КонецОбласти
#Область ОбработчикиСобытийЭлементовШапкиФормы
&НаКлиенте
Процедура УволенныеПриИзменении(Элемент)
	УволенныеПриИзмененииНаСервере();
КонецПроцедуры
#КонецОбласти
#Область ОбработчикиКомандФормы

// Код процедур и функций

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
&НаСервере
Процедура УволенныеПриИзмененииНаСервере()
	Если ЭтотОбъект.Уволенные Тогда
		Список.Параметры.УстановитьЗначениеПараметра("Статус", Перечисления.СтатусыСотрудников.Уволен);
	Иначе
		Список.Параметры.УстановитьЗначениеПараметра("Статус", Перечисления.СтатусыСотрудников.ПринятНаРаботу);
	КонецЕсли;
КонецПроцедуры
#КонецОбласти