    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	Сотрудники.Ссылка КАК Ссылка,
	Сотрудники.ПометкаУдаления КАК ПометкаУдаления,
	Сотрудники.Код КАК Код,
	Сотрудники.Наименование КАК Наименование,
	Сотрудники.ТабельныйНомер КАК ТабельныйНомер,
	Сотрудники.Должность КАК Должность,
	Сотрудники.ДатаРождения КАК ДатаРождения,
	Сотрудники.Телефон КАК Телефон,
	Сотрудники.Адрес КАК Адрес,
	Сотрудники.Подразделение КАК Подразделение,
	Сотрудники.ИдентификаторПользователяИБ КАК ИдентификаторПользователяИБ,
	Сотрудники.Роль КАК Роль,
	Сотрудники.ПроцентОтПродаж КАК ПроцентОтПродаж,
	Сотрудники.ПроцентАлиментов КАК ПроцентАлиментов,
	Сотрудники.Статус КАК Статус,
	Сотрудники.Руководитель КАК Руководитель,
	Сотрудники.ПриказНаПрием КАК ПриказНаПрием,
	Сотрудники.Дети.*,
	Сотрудники.Предопределенный КАК Предопределенный,
	Сотрудники.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
ИЗ
	Справочник.Сотрудники КАК Сотрудники
ГДЕ
	Сотрудники.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСотрудников.ПринятНаРаботу)
	ИЛИ Сотрудники.Статус = &amp;Статус</queryText>
      <mainTable>Catalog.Сотрудники</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
