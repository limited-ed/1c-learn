
Перем РК;

Функция РасчитатьСтоимость(А, Б)

	Перем КвадратА, КвадратБ, Рез;
	
	Если ТипЗнч(А) <> Тип("Число") и ТипЗнч(Б) <> Тип("Число") Тогда
		ВызватьИсключение "Значения должны быть числами";
	КонецЕсли;
	
	КвадратА = А*А;
	КвадратБ = Б*Б;
	Рез = КвадратА - КвадратБ;
	Возврат Рез;
КонецФункции

Процедура ПоказатьДеньНедели()
	НомерДня = ДеньНедели(ТекущаяДата());
	Сообщить("Сегодня "+НомерДня+" день недели");
	ДоКонца = 7 - НомерДня;
	
	Если НомерДня <> 7 Тогда
		Сообщить("До конца недели - " + ДоКонца );
	КонецЕсли;
	
	Если НомерДня = 1 Тогда
		Сообщить("Понедельник");
	ИначеЕсли НомерДня=3 Тогда 
		Сообщить("Середина");
	ИначеЕсли НомерДня=5 Тогда 
		Сообщить("Тяпница");
	ИначеЕсли НомерДня=7 Тогда 
		Сообщить("Конец недели Сегодня");
	КонецЕсли
	
КонецПроцедуры


РК=РасчитатьСтоимость(10, 5);
Сообщить("Разность: "+РК);

ПоказатьДеньНедели();
