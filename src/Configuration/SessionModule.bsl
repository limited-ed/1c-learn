// @strict-types



#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий
Процедура УстановкаПараметровСеанса(ТребуемыеПараметры)
	Если ТребуемыеПараметры <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВыбранноеИмяСтиля = ХранилищеОбщихНастроек.Загрузить("ус_Стиль", "ус_ИмяСтиля");
	Если ЗначениеЗаполнено(ВыбранноеИмяСтиля) И НайтиСтильВБиблиотеке(ВыбранноеИмяСтиля) Тогда
		ГлавныйСтиль = БиблиотекаСтилей[ВыбранноеИмяСтиля];
	КонецЕсли;

КонецПроцедуры
#КонецОбласти


#Область СлужебныеПроцедурыИФункции

// Код процедур и функций
Функция НайтиСтильВБиблиотеке(ИмяСтиля)
    Если Метаданные.Стили.Найти(ИмяСтиля) <> Неопределено Тогда
    	Возврат Истина;
    Иначе
    	Возврат Ложь;
    КонецЕсли;
КонецФункции
#КонецОбласти

#КонецЕсли
