<?xml version="1.0" encoding="UTF-8"?>
<hpwa:HomePageWorkArea xmlns:hpwa="http://g5.1c.ru/v8/dt/hpwa">
  <workingAreaTemplate>OneColumn</workingAreaTemplate>
  <columns>
    <items>
      <form>CommonForm.НачальнаяСтраницаАдминистратора</form>
      <height>10</height>
      <visibility>
        <common>false</common>
        <for>
          <value>true</value>
          <role>Role.Администратор</role>
        </for>
      </visibility>
    </items>
    <items>
      <form>CommonForm.НачальнаяСтраницаБухгалтера</form>
      <height>10</height>
      <visibility>
        <common>true</common>
        <for>
          <value>false</value>
          <role>Role.Администратор</role>
        </for>
        <for>
          <role>Role.КадровыйОтдел</role>
        </for>
        <for>
          <role>Role.Кладовщик</role>
        </for>
        <for>
          <role>Role.МенеджерПоПродажам</role>
        </for>
      </visibility>
    </items>
    <items>
      <form>CommonForm.НачальнаяСтраницаКадровыйОтдел</form>
      <height>10</height>
      <visibility>
        <common>true</common>
        <for>
          <value>true</value>
          <role>Role.КадровыйОтдел</role>
        </for>
        <for>
          <value>false</value>
          <role>Role.Администратор</role>
        </for>
      </visibility>
    </items>
    <items>
      <form>CommonForm.НачальнаяСтраницаКладовщика</form>
      <height>10</height>
      <visibility>
        <common>true</common>
        <for>
          <value>true</value>
          <role>Role.Кладовщик</role>
        </for>
        <for>
          <value>false</value>
          <role>Role.Администратор</role>
        </for>
      </visibility>
    </items>
    <items>
      <form>CommonForm.НачальнаяСтраницаМенеджераПоПродажам</form>
      <height>10</height>
      <visibility>
        <common>true</common>
        <for>
          <value>true</value>
          <role>Role.МенеджерПоПродажам</role>
        </for>
        <for>
          <value>false</value>
          <role>Role.Администратор</role>
        </for>
      </visibility>
    </items>
  </columns>
</hpwa:HomePageWorkArea>
