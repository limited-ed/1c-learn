#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(Объект.Период) Тогда
		Объект.Период = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьИзExcel(Команда)
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = "Книга Excel (*.xlsx)|*.xlsx|Книга Excel 97 (*.xls)|*.xls";
	Диалог.Заголовок = "Файл цен";
	Диалог.Показать(Новый ОписаниеОповещения("ЗагрузитьИзExcelПослеВыбораФайла", ЭтотОбъект));
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзExcelПослеВыбораФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ДополнительныеПараметры = Новый Структура("ИмяФайла", ВыбранныеФайлы[0]);
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузитьИзExcelПослеПомещенияФайла", ЭтотОбъект, ДополнительныеПараметры);
	НачатьПомещениеФайлаНаСервер(ОписаниеОповещения, , , , ВыбранныеФайлы[0], УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзExcelПослеПомещенияФайла(ОписаниеПомещенногоФайла, ДополнительныеПараметры) Экспорт
	Если ОписаниеПомещенногоФайла = Неопределено Или ОписаниеПомещенногоФайла.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;
	ПозицияТочки = СтрНайти(ДополнительныеПараметры.ИмяФайла, ".", НаправлениеПоиска.СКонца);
	Расширение = "xlsx";
	Если ПозицияТочки > 0 Тогда
		Расширение = НРег(Сред(ДополнительныеПараметры.ИмяФайла, ПозицияТочки + 1));
	КонецЕсли;
	Итог = ЗагрузитьЦеныНаСервере(ОписаниеПомещенногоФайла.Адрес, Расширение);
	ПоказатьОповещениеПользователя("Загрузка цен", ,
		СтрШаблон("Записано: %1, пропущено: %2", Итог.Записано, Итог.Пропущено));
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВExcel(Команда)
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Фильтр = "Книга Excel (*.xlsx)|*.xlsx";
	Диалог.ПолноеИмяФайла = "Номенклатура.xlsx";
	Диалог.Заголовок = "Сохранить номенклатуру";
	Диалог.Показать(Новый ОписаниеОповещения("ВыгрузитьВExcelПослеВыбораФайла", ЭтотОбъект));
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВExcelПослеВыбораФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Адрес = ВыгрузитьНоменклатуруНаСервере();
	НачатьПолучениеФайлаССервера(Новый ОписаниеОповещения("ВыгрузитьВExcelЗавершение", ЭтотОбъект), Адрес, ВыбранныеФайлы[0]);
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВExcelЗавершение(ПолученныйФайл, ДополнительныеПараметры) Экспорт
	Если ПолученныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПоказатьОповещениеПользователя("Выгрузка номенклатуры", , "Файл сохранен");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗагрузитьЦеныНаСервере(АдресФайла, Расширение)
	Обработка = РеквизитФормыВЗначение("Объект");
	Итог = Обработка.ЗагрузитьЦены(АдресФайла, Расширение);
	Результат.Очистить();
	Для Каждого СтрокаИтога Из Итог.Строки Цикл
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), СтрокаИтога);
	КонецЦикла;
	Возврат Новый Структура("Записано, Пропущено", Итог.Записано, Итог.Пропущено);
КонецФункции

&НаСервере
Функция ВыгрузитьНоменклатуруНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ВыгрузитьНоменклатуру(УникальныйИдентификатор);
КонецФункции

#КонецОбласти
