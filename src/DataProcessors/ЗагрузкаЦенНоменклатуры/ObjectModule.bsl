#Область ПрограммныйИнтерфейс

Функция ЗагрузитьЦены(АдресФайла, РасширениеФайла = "xlsx") Экспорт
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ДвоичныеДанные = Неопределено Тогда
		ВызватьИсключение "Не удалось прочитать файл.";
	КонецЕсли;
	
	Расширение = НРег(СокрЛП(РасширениеФайла));
	Если ПустаяСтрока(Расширение) Тогда
		Расширение = "xlsx";
	КонецЕсли;
	
	ИмяФайла = ПолучитьИмяВременногоФайла(Расширение);
	ТабличныйДокумент = Новый ТабличныйДокумент;
	Попытка
		ДвоичныеДанные.Записать(ИмяФайла);
		ТабличныйДокумент.Прочитать(ИмяФайла, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	Исключение
		УдалитьФайлы(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьФайлы(ИмяФайла);
	
	ДатаЦены = ?(ЗначениеЗаполнено(Период), НачалоДня(Период), НачалоДня(ТекущаяДатаСеанса()));
	Строки = Новый Массив;
	Записано = 0;
	Пропущено = 0;
	ПерваяСтрока = 1;
	Если ЭтоСтрокаЗаголовка(ТабличныйДокумент) Тогда
		ПерваяСтрока = 2;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		Для НомерСтроки = ПерваяСтрока По ТабличныйДокумент.ВысотаТаблицы Цикл
			Код = ТекстКода(ТабличныйДокумент, НомерСтроки);
			Наименование = ТекстНаименования(ТабличныйДокумент, НомерСтроки);
			Если ПустаяСтрока(Код) И ПустаяСтрока(Наименование) Тогда
				Продолжить;
			КонецЕсли;
			
			ОписаниеСтроки = Новый Структура("Код, Наименование, Цена, Статус, Причина", Код, Наименование, 0, "Пропущено", "");
			Цена = 0;
			Причина = "";
			Номенклатура = Неопределено;
			Если Не СтрокаПодходитДляЗаписи(Код, Наименование, ТабличныйДокумент, НомерСтроки, Цена, Номенклатура, Причина) Тогда
				ОписаниеСтроки.Цена = Цена;
				ОписаниеСтроки.Причина = Причина;
				Пропущено = Пропущено + 1;
			Иначе
				ЗаписатьЦену(Номенклатура, ДатаЦены, Цена);
				ОписаниеСтроки.Цена = Цена;
				ОписаниеСтроки.Статус = "Записано";
				Записано = Записано + 1;
			КонецЕсли;
			Строки.Добавить(ОписаниеСтроки);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Новый Структура("Записано, Пропущено, Строки", Записано, Пропущено, Строки);
	
КонецФункции

Функция ВыгрузитьНоменклатуру(УникальныйИдентификаторФормы) Экспорт
	
	ДатаСреза = ?(ЗначениеЗаполнено(Период), КонецДня(Период), КонецДня(ТекущаяДатаСеанса()));
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", ДатаСреза);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НоменклатураТаблица.Код КАК Код,
	|	НоменклатураТаблица.Наименование КАК Наименование,
	|	ЕСТЬNULL(Цены.Цена, 0) КАК Цена
	|ИЗ
	|	Справочник.Номенклатура КАК НоменклатураТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Период,) КАК Цены
	|		ПО НоменклатураТаблица.Ссылка = Цены.Номенклатура
	|ГДЕ
	|	НЕ НоменклатураТаблица.ЭтоГруппа
	|	И НЕ НоменклатураТаблица.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	НоменклатураТаблица.Наименование";
	
	Выборка = Запрос.Выполнить().Выбрать();
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Область(1, 1).Текст = "Код";
	ТабличныйДокумент.Область(1, 2).Текст = "Номенклатура";
	ТабличныйДокумент.Область(1, 3).Текст = "Цена";
	НомерСтроки = 1;
	Пока Выборка.Следующий() Цикл
		НомерСтроки = НомерСтроки + 1;
		ТабличныйДокумент.Область(НомерСтроки, 1).Текст = СокрЛП(Выборка.Код);
		ТабличныйДокумент.Область(НомерСтроки, 2).Текст = СокрЛП(Выборка.Наименование);
		ТабличныйДокумент.Область(НомерСтроки, 3).Текст = Формат(Выборка.Цена, "ЧГ=0; ЧДЦ=2; ЧРД=,");
	КонецЦикла;
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xlsx");
	Попытка
		ТабличныйДокумент.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
		ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайла);
	Исключение
		УдалитьФайлы(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьФайлы(ИмяФайла);
	
	Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификаторФормы);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СтрокаПодходитДляЗаписи(Код, Наименование, ТабличныйДокумент, НомерСтроки, Цена, Номенклатура, Причина)
	
	Если ПустаяСтрока(Код) Тогда
		Причина = "Не заполнен код";
		Возврат Ложь;
	КонецЕсли;
	Если ПустаяСтрока(Наименование) Тогда
		Причина = "Не заполнено наименование";
		Возврат Ложь;
	КонецЕсли;
	Если Не ЦенаЯчейки(ТабличныйДокумент, НомерСтроки, Цена) Тогда
		Причина = "Не удалось прочитать цену";
		Возврат Ложь;
	КонецЕсли;
	Если Цена < 0 Тогда
		Причина = "Цена меньше нуля";
		Возврат Ложь;
	КонецЕсли;
	
	Номенклатура = Справочники.Номенклатура.НайтиПоКоду(Код);
	Если Номенклатура.Пустая() Тогда
		Причина = "Номенклатура с таким кодом не найдена";
		Возврат Ложь;
	КонецЕсли;
	Если Номенклатура.ЭтоГруппа Тогда
		Причина = "Код принадлежит группе";
		Возврат Ложь;
	КонецЕсли;
	Если Номенклатура.ПометкаУдаления Тогда
		Причина = "Номенклатура помечена на удаление";
		Возврат Ложь;
	КонецЕсли;
	Если НормализоватьНаименование(Номенклатура.Наименование) <> НормализоватьНаименование(Наименование) Тогда
		Причина = "Наименование не совпадает с карточкой";
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ЗаписатьЦену(Номенклатура, ДатаЦены, Цена)
	
	Запись = РегистрыСведений.ЦеныНоменклатуры.СоздатьМенеджерЗаписи();
	Запись.Период = ДатаЦены;
	Запись.Номенклатура = Номенклатура;
	Запись.Цена = Цена;
	Запись.Записать();
	
КонецПроцедуры

Функция ЭтоСтрокаЗаголовка(ТабличныйДокумент)
	
	Если ТабличныйДокумент.ВысотаТаблицы = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстПервойЯчейки = ВРег(ТекстКода(ТабличныйДокумент, 1));
	Возврат СтрНайти(ТекстПервойЯчейки, "КОД") > 0;
	
КонецФункции

Функция ТекстКода(ТабличныйДокумент, НомерСтроки)
	
	Область = ТабличныйДокумент.Область(НомерСтроки, 1);
	Если ТипЗнч(Область.Текст) = Тип("Число") Тогда
		Возврат Формат(Область.Текст, "ЧГ=0; ЧДЦ=0");
	КонецЕсли;
	ТекстЗначения = СокрЛП(Строка(Область.Текст));
	Если ЗначениеЗаполнено(ТекстЗначения) Тогда
		Возврат ТекстЗначения;
	КонецЕсли;
	Возврат СокрЛП(Область.Текст);
	
КонецФункции

Функция ТекстНаименования(ТабличныйДокумент, НомерСтроки)
	
	Область = ТабличныйДокумент.Область(НомерСтроки, 2);
	Если ТипЗнч(Область.Текст) = Тип("Строка") И ЗначениеЗаполнено(СокрЛП(Область.Текст)) Тогда
		Возврат СокрЛП(Область.Текст);
	КонецЕсли;
	Возврат СокрЛП(Область.Текст);
	
КонецФункции

Функция ЦенаЯчейки(ТабличныйДокумент, НомерСтроки, Цена)
	
	Область = ТабличныйДокумент.Область(НомерСтроки, 3);
	Если ТипЗнч(Область.Текст) = Тип("Число") Тогда
		Цена = Область.Текст;
		Возврат Истина;
	КонецЕсли;
	Текст = СокрЛП(Область.Текст);
	Если ПустаяСтрока(Текст) Тогда
		Текст = СокрЛП(Строка(Область.Текст));
	КонецЕсли;
	Возврат РазобратьЦену(Текст, Цена);
	
КонецФункции

Функция РазобратьЦену(Текст, Цена)
	
	Нормализованный = СтрЗаменить(Текст, " ", "");
	Нормализованный = СтрЗаменить(Нормализованный, Символы.НПП, "");
	Нормализованный = СтрЗаменить(Нормализованный, ".", ",");
	Если ПустаяСтрока(Нормализованный) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РазделительНайден = Ложь;
	Для Индекс = 1 По СтрДлина(Нормализованный) Цикл
		Символ = Сред(Нормализованный, Индекс, 1);
		Если Символ = "," Тогда
			Если РазделительНайден Или Индекс = 1 Или Индекс = СтрДлина(Нормализованный) Тогда
				Возврат Ложь;
			КонецЕсли;
			РазделительНайден = Истина;
		ИначеЕсли СтрНайти("0123456789", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	ОписаниеЧисла = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
	Цена = ОписаниеЧисла.ПривестиЗначение(Нормализованный);
	Возврат Истина;
	
КонецФункции

Функция НормализоватьНаименование(Текст)
	
	Результат = СокрЛП(СтрЗаменить(Строка(Текст), Символы.НПП, " "));
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	Возврат ВРег(Результат);
	
КонецФункции

#КонецОбласти

#КонецЕсли
