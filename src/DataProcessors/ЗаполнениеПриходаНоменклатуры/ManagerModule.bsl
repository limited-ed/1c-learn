Функция ОписаниеСклада(Наименование, Адрес)
	Возврат Новый Структура("Наименование, Адрес", Наименование, Адрес);
КонецФункции

Функция ОбеспечитьСклады()
	Ссылки = Новый Массив;
	Добавлено = 0;
	УжеБыли = 0;
	Для Каждого Описание Из ДанныеСкладов() Цикл
		Ссылка = Справочники.Магазины.НайтиПоНаименованию(Описание.Наименование, Истина);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			УжеБыли = УжеБыли + 1;
		Иначе
			Склад = Справочники.Магазины.СоздатьЭлемент();
			Склад.Наименование = Описание.Наименование;
			Склад.Адрес = Описание.Адрес;
			Склад.Записать();
			Ссылка = Склад.Ссылка;
			Добавлено = Добавлено + 1;
		КонецЕсли;
		Ссылки.Добавить(Ссылка);
	КонецЦикла;
	Возврат Новый Структура("Ссылки, Добавлено, УжеБыли", Ссылки, Добавлено, УжеБыли);
КонецФункции

Функция НоменклатураДляПрихода()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ЭтоГруппа
	|	И НЕ Номенклатура.ПометкаУдаления";
	Номенклатура = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Номенклатура.Добавить(Выборка.Ссылка);
	КонецЦикла;
	Возврат Номенклатура;
КонецФункции

Функция ПоставщикиДляПрихода()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Поставщик
	|	И НЕ Контрагенты.ПометкаУдаления";
	Поставщики = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Поставщики.Добавить(Выборка.Ссылка);
	КонецЦикла;
	Возврат Поставщики;
КонецФункции

Функция КоличествоДокументовЗаполнения()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Документ.Приход КАК Приход
	|ГДЕ
	|	Приход.Комментарий = &Комментарий
	|	И НЕ Приход.ПометкаУдаления";
	Запрос.УстановитьПараметр("Комментарий", КомментарийЗаполнения());
	Возврат Запрос.Выполнить().Выгрузить()[0].Количество;
КонецФункции

Функция КомментарийЗаполнения()
	Возврат "Заполнение прихода";
КонецФункции

Функция РаспределитьПоСкладам(ЧислоСкладов, ВсегоДокументов, Генератор)
	Количества = Новый Массив;
	Для Индекс = 1 По ЧислоСкладов Цикл
		Количества.Добавить(1);
	КонецЦикла;
	Остаток = ВсегоДокументов - ЧислоСкладов;
	Пока Остаток > 0 Цикл
		Индекс = Генератор.СлучайноеЧисло(0, ЧислоСкладов - 1);
		Количества[Индекс] = Количества[Индекс] + 1;
		Остаток = Остаток - 1;
	КонецЦикла;
	Возврат Количества;
КонецФункции

Функция ЗаписатьПриход(Склад, Поставщики, Номенклатура, Номер, Генератор)
	ДокументОбъект = Документы.Приход.СоздатьДокумент();
	ДокументОбъект.Дата = ДатаДокумента(Номер, Генератор);
	ДокументОбъект.Магазин = Склад;
	ДокументОбъект.Контрагент = Поставщики[Генератор.СлучайноеЧисло(0, Поставщики.ВГраница())];
	ДокументОбъект.Комментарий = КомментарийЗаполнения();
	Позиции = СлучайныеПозиции(Номенклатура, Генератор);
	Для Каждого Позиция Из Позиции Цикл
		Строка = ДокументОбъект.СписокНоменклатуры.Добавить();
		Строка.Номенклатура = Позиция;
		Строка.Количество = Генератор.СлучайноеЧисло(1, 10);
	КонецЦикла;
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Позиции.Количество();
КонецФункции

Функция ДатаДокумента(Номер, Генератор)
	ДатаПрихода = НачалоДня(ТекущаяДатаСеанса()) - (100 - Номер) * 24 * 60 * 60;
	Возврат ДатаПрихода + Генератор.СлучайноеЧисло(9, 17) * 60 * 60;
КонецФункции

Функция СлучайныеПозиции(Номенклатура, Генератор)
	Копия = Новый Массив;
	Для Каждого Ссылка Из Номенклатура Цикл
		Копия.Добавить(Ссылка);
	КонецЦикла;
	Для Индекс = Копия.ВГраница() По 1 Цикл
		Позиция = Генератор.СлучайноеЧисло(0, Индекс);
		Временная = Копия[Индекс];
		Копия[Индекс] = Копия[Позиция];
		Копия[Позиция] = Временная;
	КонецЦикла;
	ВерхняяГраница = Мин(30, Копия.Количество());
	ЧислоПозиций = Генератор.СлучайноеЧисло(20, ВерхняяГраница);
	Позиции = Новый Массив;
	Для Индекс = 0 По ЧислоПозиций - 1 Цикл
		Позиции.Добавить(Копия[Индекс]);
	КонецЦикла;
	Возврат Позиции;
КонецФункции

#КонецОбласти

