#Область ПрограммныйИнтерфейс

Функция ТекстОписания() Экспорт
	Строки = Новый Массив;
	Строки.Добавить("Заполнение справочника «Склады» и документов «Приход».");
	Строки.Добавить("Создается 10 складов. Уже записанные наименования пропускаются.");
	Строки.Добавить("Создается 100 проведенных документов прихода. Число документов на Магазин выбирается случайно, в сумме получается 100, каждому складу достается хотя бы один.");
	Строки.Добавить("В документе 20–30 разных позиций номенклатуры. Количество в строке — от 1 до 10.");
	Строки.Добавить("Контрагент документа — случайный поставщик. Нужны элементы номенклатуры (не группы) и хотя бы один поставщик.");
	Строки.Добавить("Повторный запуск не создает вторую сотню: документы помечаются комментарием «Заполнение прихода».");
	Строки.Добавить("");
	Для Каждого Склад Из ДанныеСкладов() Цикл
		Строки.Добавить(СтрШаблон("%1 — %2", Склад.Наименование, Склад.Адрес));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

Функция ЗаполнитьПриход() Экспорт
	Номенклатура = НоменклатураДляПрихода();
	Если Номенклатура.Количество() < 20 Тогда
		Возврат "В справочнике номенклатуры меньше 20 элементов (без групп). Сначала выполните заполнение номенклатуры.";
	КонецЕсли;
	Поставщики = ПоставщикиДляПрихода();
	Если Поставщики.Количество() = 0 Тогда
		Возврат "Нет контрагентов с признаком «Поставщик». Сначала выполните заполнение контрагентов.";
	КонецЕсли;
	УжеДокументов = КоличествоДокументовЗаполнения();
	ДобавленоДокументов = 0;
	ВсегоСтрок = 0;
	Сводка = Новый Массив;
	НачатьТранзакцию();
	Попытка
		ИтогСкладов = ОбеспечитьСклады();
		Склады = ИтогСкладов.Ссылки;
		ДобавленоСкладов = ИтогСкладов.Добавлено;
		УжеСкладов = ИтогСкладов.УжеБыли;
		Если УжеДокументов = 0 Тогда
			Генератор = Новый ГенераторСлучайныхЧисел();
			Количества = РаспределитьПоСкладам(Склады.Количество(), 100, Генератор);
			Номер = 0;
			Для ИндексСклада = 0 По Склады.ВГраница() Цикл
				Для Счетчик = 1 По Количества[ИндексСклада] Цикл
					Номер = Номер + 1;
					ВсегоСтрок = ВсегоСтрок + ЗаписатьПриход(Склады[ИндексСклада], Поставщики, Номенклатура, Номер, Генератор);
					ДобавленоДокументов = ДобавленоДокументов + 1;
				КонецЦикла;
				Сводка.Добавить(СтрШаблон("%1 — %2", Строка(Склады[ИндексСклада]), Количества[ИндексСклада]));
			КонецЦикла;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Возврат "Запись отменена: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Если УжеДокументов > 0 Тогда
		Возврат СтрШаблон(
			"Складов добавлено: %1, уже были: %2. Документы прихода этой обработки уже есть (%3), новые не созданы.",
			ДобавленоСкладов,
			УжеСкладов,
			УжеДокументов);
	КонецЕсли;
	Возврат СтрШаблон(
		"Складов добавлено: %1, уже были: %2. Проведено документов: %3, строк: %4. По складам: %5.",
		ДобавленоСкладов,
		УжеСкладов,
		ДобавленоДокументов,
		ВсегоСтрок,
		СтрСоединить(Сводка, "; "));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

