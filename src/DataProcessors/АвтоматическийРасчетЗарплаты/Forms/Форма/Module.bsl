#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Рассчитать(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ПериодРегистрации) Тогда
		ПоказатьПредупреждение(, "Укажите месяц расчета.");
		Возврат;
	КонецЕсли;
	Результат = РассчитатьНаСервере();
	Текст = "Создано документов: " + Результат.Создано + ", обновлено: " + Результат.Обновлено + ".";
	Если Результат.Ошибки.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + СтрСоединить(Результат.Ошибки, Символы.ПС);
	КонецЕсли;
	ПоказатьПредупреждение(, Текст);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция РассчитатьНаСервере()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ВыполнитьРасчет();
	
КонецФункции

#КонецОбласти
