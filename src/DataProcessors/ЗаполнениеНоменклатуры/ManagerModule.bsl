#Область ПрограммныйИнтерфейс

Функция ТекстОписания() Экспорт
	Данные = ПрочитатьДанные();
	Строки = Новый Массив;
	Строки.Добавить("Заполнение справочника «Номенклатура».");
	Строки.Добавить("Сначала записываются группы и подгруппы, затем элементы справочника «Типы номенклатуры» с теми же именами.");
	Строки.Добавить("Товар создается в подгруппе. Бренд — в реквизит Бренд, торговое имя модели — в наименование, короткий код — в реквизит Модель.");
	Строки.Добавить("Для подгруппы задано 5–6 свойств. Значения пишутся в регистр «Значение свойств номенклатуры».");
	Строки.Добавить("Цена — розница в рублях на текущую дату, регистр «Цены номенклатуры».");
	Строки.Добавить("Повторный запуск не создает дубли: совпадение наименования в той же группе пропускается.");
	Строки.Добавить("");
	Всего = 0;
	Для Каждого Группа Из Данные.Получить("groups") Цикл
		Строки.Добавить(Группа.Получить("name"));
		Для Каждого Подгруппа Из Группа.Получить("subgroups") Цикл
			Товары = Подгруппа.Получить("items");
			Всего = Всего + Товары.Количество();
			Строки.Добавить(СтрШаблон(
				"  %1 — %2 поз., свойства: %3",
				Подгруппа.Получить("name"),
				Товары.Количество(),
				СтрСоединить(Подгруппа.Получить("properties"), ", ")));
		КонецЦикла;
	КонецЦикла;
	Строки.Добавить("");
	Строки.Добавить(СтрШаблон("Всего товаров: %1.", Всего));
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

Функция ЗаполнитьНоменклатуру() Экспорт
	Данные = ПрочитатьДанные();
	Кэш = НовыйКэш();
	ДобавленоТоваров = 0;
	ПропущеноТоваров = 0;
	ДобавленоГрупп = 0;
	ДобавленоТипов = 0;
	НачатьТранзакцию();
	Попытка
		Для Каждого Группа Из Данные.Получить("groups") Цикл
			ИмяГруппы = Группа.Получить("name");
			Если ОбеспечитьТип(ИмяГруппы, Кэш) Тогда
				ДобавленоТипов = ДобавленоТипов + 1;
			КонецЕсли;
			ГруппаНоменклатуры = ОбеспечитьГруппуНоменклатуры(ИмяГруппы, Справочники.Номенклатура.ПустаяСсылка(), Кэш);
			Если ГруппаНоменклатуры.Создана Тогда
				ДобавленоГрупп = ДобавленоГрупп + 1;
			КонецЕсли;
			Для Каждого Подгруппа Из Группа.Получить("subgroups") Цикл
				ИмяПодгруппы = Подгруппа.Получить("name");
				Если ОбеспечитьТип(ИмяПодгруппы, Кэш) Тогда
					ДобавленоТипов = ДобавленоТипов + 1;
				КонецЕсли;
				ГруппаПодгруппы = ОбеспечитьГруппуНоменклатуры(ИмяПодгруппы, ГруппаНоменклатуры.Ссылка, Кэш);
				Если ГруппаПодгруппы.Создана Тогда
					ДобавленоГрупп = ДобавленоГрупп + 1;
				КонецЕсли;
				ТипНоменклатуры = Кэш.Типы.Получить(ИмяПодгруппы);
				Свойства = ОбеспечитьСвойства(Подгруппа.Получить("properties"), Кэш);
				Для Каждого Товар Из Подгруппа.Получить("items") Цикл
					Если Кэш.Товары.Получить(КлючНоменклатуры(ГруппаПодгруппы.Ссылка, Товар.Получить("name"), Ложь)) <> Неопределено Тогда
						ПропущеноТоваров = ПропущеноТоваров + 1;
						Продолжить;
					КонецЕсли;
					ЗаписатьТовар(Товар, ГруппаПодгруппы.Ссылка, ТипНоменклатуры, Свойства, Кэш);
					ДобавленоТоваров = ДобавленоТоваров + 1;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Возврат "Запись отменена: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат СтрШаблон(
		"Добавлено групп: %1, типов: %2, товаров: %3. Пропущено товаров, уже есть в группе: %4.",
		ДобавленоГрупп,
		ДобавленоТипов,
		ДобавленоТоваров,
		ПропущеноТоваров);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьДанные()
	Макет = Обработки.ЗаполнениеНоменклатуры.ПолучитьМакет("ДанныеЗаполнения");
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Макет.ПолучитьТекст());
	Возврат ПрочитатьJSON(Чтение, Истина);
КонецФункции

Функция НовыйКэш()
	Кэш = Новый Структура;
	Кэш.Вставить("Группы", Новый Соответствие);
	Кэш.Вставить("Товары", Новый Соответствие);
	Кэш.Вставить("Типы", Новый Соответствие);
	Кэш.Вставить("Свойства", Новый Соответствие);
	Кэш.Вставить("Значения", Новый Соответствие);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Наименование КАК Наименование,
	|	Номенклатура.Родитель КАК Родитель,
	|	Номенклатура.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = КлючНоменклатуры(Выборка.Родитель, Выборка.Наименование, Выборка.ЭтоГруппа);
		Если Выборка.ЭтоГруппа Тогда
			Кэш.Группы.Вставить(Ключ, Выборка.Ссылка);
		Иначе
			Кэш.Товары.Вставить(Ключ, Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Типы.Ссылка КАК Ссылка,
	|	Типы.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ТипыНоменклатуры КАК Типы
	|ГДЕ
	|	НЕ Типы.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Кэш.Типы.Вставить(Выборка.Наименование, Выборка.Ссылка);
	КонецЦикла;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Свойства.Ссылка КАК Ссылка,
	|	Свойства.Наименование КАК Наименование
	|ИЗ
	|	ПланВидовХарактеристик.ДополнительныеСвойстваНоменклатуры КАК Свойства
	|ГДЕ
	|	НЕ Свойства.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Кэш.Свойства.Вставить(Выборка.Наименование, Выборка.Ссылка);
	КонецЦикла;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Значения.Ссылка КАК Ссылка,
	|	Значения.Владелец КАК Владелец,
	|	Значения.Наименование КАК Наименование
	|ИЗ
	|	Справочник.СвойстваНоменклатуры КАК Значения
	|ГДЕ
	|	НЕ Значения.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Кэш.Значения.Вставить(КлючЗначения(Выборка.Владелец, Выборка.Наименование), Выборка.Ссылка);
	КонецЦикла;
	Возврат Кэш;
КонецФункции

Функция КлючНоменклатуры(Родитель, Наименование, ЭтоГруппа)
	Возврат Строка(Родитель.УникальныйИдентификатор()) + "|" + ?(ЭтоГруппа, "1", "0") + "|" + Наименование;
КонецФункции

Функция КлючЗначения(Владелец, Наименование)
	Возврат Строка(Владелец.УникальныйИдентификатор()) + "|" + Наименование;
КонецФункции

Функция ОбеспечитьТип(Наименование, Кэш)
	Существующий = Кэш.Типы.Получить(Наименование);
	Если Существующий <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Элемент = Справочники.ТипыНоменклатуры.СоздатьЭлемент();
	Элемент.Наименование = Наименование;
	Элемент.Записать();
	Кэш.Типы.Вставить(Наименование, Элемент.Ссылка);
	Возврат Истина;
КонецФункции

Функция ОбеспечитьГруппуНоменклатуры(Наименование, Родитель, Кэш)
	Ключ = КлючНоменклатуры(Родитель, Наименование, Истина);
	Существующая = Кэш.Группы.Получить(Ключ);
	Если Существующая <> Неопределено Тогда
		Возврат Новый Структура("Ссылка, Создана", Существующая, Ложь);
	КонецЕсли;
	Группа = Справочники.Номенклатура.СоздатьГруппу();
	Группа.Наименование = Наименование;
	Группа.Родитель = Родитель;
	Группа.Записать();
	Кэш.Группы.Вставить(Ключ, Группа.Ссылка);
	Возврат Новый Структура("Ссылка, Создана", Группа.Ссылка, Истина);
КонецФункции

Функция ОбеспечитьСвойства(Имена, Кэш)
	Результат = Новый Соответствие;
	ОписаниеТипа = Новый ОписаниеТипов("СправочникСсылка.СвойстваНоменклатуры");
	Для Каждого Имя Из Имена Цикл
		Ссылка = Кэш.Свойства.Получить(Имя);
		Если Ссылка = Неопределено Тогда
			Свойство = ПланыВидовХарактеристик.ДополнительныеСвойстваНоменклатуры.СоздатьЭлемент();
			Свойство.Наименование = Имя;
			Свойство.ТипЗначения = ОписаниеТипа;
			Свойство.Записать();
			Ссылка = Свойство.Ссылка;
			Кэш.Свойства.Вставить(Имя, Ссылка);
		КонецЕсли;
		Результат.Вставить(Имя, Ссылка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ЗаписатьТовар(Товар, Родитель, ТипНоменклатуры, Свойства, Кэш)
	Наименование = Обрезать(Товар.Получить("name"), 150);
	Элемент = Справочники.Номенклатура.СоздатьЭлемент();
	Элемент.Наименование = Наименование;
	Элемент.Родитель = Родитель;
	Элемент.Бренд = Обрезать(Товар.Получить("brand"), 20);
	Элемент.Модель = Обрезать(Товар.Получить("model"), 20);
	Элемент.ТипНоменклатуры = ТипНоменклатуры;
	Элемент.Записать();
	Кэш.Товары.Вставить(КлючНоменклатуры(Родитель, Наименование, Ложь), Элемент.Ссылка);
	ЗаписьЦены = РегистрыСведений.ЦеныНоменклатуры.СоздатьМенеджерЗаписи();
	ЗаписьЦены.Период = НачалоДня(ТекущаяДатаСеанса());
	ЗаписьЦены.Номенклатура = Элемент.Ссылка;
	ЗаписьЦены.Цена = Товар.Получить("price");
	ЗаписьЦены.Записать();
	Значения = Товар.Получить("properties");
	Для Каждого КлючИЗначение Из Свойства Цикл
		ТекстЗначения = Обрезать(Значения.Получить(КлючИЗначение.Ключ), 50);
		ЗначениеСсылка = ОбеспечитьЗначениеСвойства(КлючИЗначение.Значение, ТекстЗначения, Кэш);
		ЗаписьСвойства = РегистрыСведений.ЗначениеСвойстНоменклатуры.СоздатьМенеджерЗаписи();
		ЗаписьСвойства.Номенклатура = Элемент.Ссылка;
		ЗаписьСвойства.Свойство = КлючИЗначение.Значение;
		ЗаписьСвойства.Значение = ЗначениеСсылка;
		ЗаписьСвойства.Записать();
	КонецЦикла;
КонецПроцедуры

Функция ОбеспечитьЗначениеСвойства(Свойство, Наименование, Кэш)
	Ключ = КлючЗначения(Свойство, Наименование);
	Существующее = Кэш.Значения.Получить(Ключ);
	Если Существующее <> Неопределено Тогда
		Возврат Существующее;
	КонецЕсли;
	Элемент = Справочники.СвойстваНоменклатуры.СоздатьЭлемент();
	Элемент.Владелец = Свойство;
	Элемент.Наименование = Наименование;
	Элемент.Записать();
	Кэш.Значения.Вставить(Ключ, Элемент.Ссылка);
	Возврат Элемент.Ссылка;
КонецФункции

Функция Обрезать(Значение, Длина)
	Текст = СокрЛП(Строка(Значение));
	Если СтрДлина(Текст) <= Длина Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, Длина);
КонецФункции

#КонецОбласти

