#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	КодОбработки = Обработки.ЗаполнениеКонтрагентов.ТекстКода();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьЗавершение", ЭтотОбъект);
	ПоказатьВопрос(
		Оповещение,
		"Добавить 5 поставщиков и 20 покупателей с договорами?",
		РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ЗаполнитьНаСервере();
	Сообщение.Сообщить();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаполнитьНаСервере()
	Возврат Обработки.ЗаполнениеКонтрагентов.ЗаполнитьКонтрагентов();
КонецФункции

#КонецОбласти
