#Область ПрограммныйИнтерфейс

Функция ТекстКода() Экспорт
	Строки = Новый Массив;
	Строки.Добавить("Код обработки «Заполнение контрагентов».");
	Строки.Добавить("Будет записано 5 поставщиков и 20 покупателей.");
	Строки.Добавить("Для каждого контрагента создается один договор.");
	Строки.Добавить("Поставщику — договор с поставщиком, покупателю — договор с покупателем.");
	Строки.Добавить("Дата заключения — день 2026 года. Срок действия — от 1 до 3 лет.");
	Строки.Добавить("Валюта расчетов — российский рубль.");
	Строки.Добавить("Уже существующие наименования пропускаются.");
	Строки.Добавить("");
	Для Каждого Элемент Из ПодготовитьДанные() Цикл
		Роль = ?(Элемент.Поставщик, "поставщик", "покупатель");
		Строки.Добавить(СтрШаблон(
			"%1; %2; ИНН %3; договор %4; %5 — %6",
			Элемент.Наименование,
			Роль,
			Элемент.ИНН,
			Элемент.НомерДоговора,
			Элемент.ДатаЗаключения,
			Элемент.ДатаДействия));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

Функция ЗаполнитьКонтрагентов() Экспорт
	Валюта = Справочники.Валюты.Рубль;
	Если НЕ ЗначениеЗаполнено(Валюта) Тогда
		Валюта = Справочники.Валюты.НайтиПоКоду("643");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Валюта) Тогда
		Возврат "Не найден российский рубль в справочнике валют. Запись отменена.";
	КонецЕсли;
	Добавлено = 0;
	Пропущено = 0;
	НачатьТранзакцию();
	Попытка
		Для Каждого Элемент Из ПодготовитьДанные() Цикл
			Если ЗначениеЗаполнено(Справочники.Контрагенты.НайтиПоНаименованию(Элемент.Наименование, Истина)) Тогда
				Пропущено = Пропущено + 1;
				Продолжить;
			КонецЕсли;
			ЗаписатьКонтрагента(Элемент, Валюта);
			Добавлено = Добавлено + 1;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Возврат "Запись отменена: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат СтрШаблон("Добавлено контрагентов: %1. Пропущено, уже есть в справочнике: %2.", Добавлено, Пропущено);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьКонтрагента(Элемент, Валюта)
	Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
	Контрагент.Наименование = Элемент.Наименование;
	Контрагент.ВидКонтрагента = ВидКонтрагента(Элемент.Вид);
	Контрагент.ИНН = Элемент.ИНН;
	Контрагент.КПП = Элемент.КПП;
	Контрагент.ОГРН = Элемент.ОГРН;
	Контрагент.КодПоОКПО = Элемент.ОКПО;
	Контрагент.ЮридическийАдрес = Элемент.ЮридическийАдрес;
	Контрагент.ФактическийАдрес = Элемент.ФактическийАдрес;
	Контрагент.ПочтовыйАдрес = Элемент.ПочтовыйАдрес;
	Контрагент.РасчетныйСчет = Элемент.РасчетныйСчет;
	Контрагент.БИК = Элемент.БИК;
	Контрагент.НаименованиеБанка = Элемент.НаименованиеБанка;
	Контрагент.КорреспондентскийСчет = Элемент.КорреспондентскийСчет;
	Контрагент.Покупатель = НЕ Элемент.Поставщик;
	Контрагент.Поставщик = Элемент.Поставщик;
	Контрагент.ПрочиеОтношения = Ложь;
	Контрагент.ФИОРуководителя = Элемент.ФИОРуководителя;
	Контрагент.Записать();
	Договор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	Договор.Владелец = Контрагент.Ссылка;
	Договор.Наименование = СтрШаблон("Договор %1 от %2", Элемент.НомерДоговора, Элемент.ДатаЗаключения);
	Договор.ВидДоговора = ?(Элемент.Поставщик, Перечисления.ВидДоговора.СПоставщиком, Перечисления.ВидДоговора.СПокупателем);
	Договор.ВалютаРасчетов = Валюта;
	Договор.НомерДоговора = Элемент.НомерДоговора;
	Договор.ДатаЗаключения = Элемент.ДатаЗаключения;
	Договор.ДатаДействия = Элемент.ДатаДействия;
	Договор.Записать();
	Контрагент.ОсновнойДоговор = Договор.Ссылка;
	Контрагент.Записать();
КонецПроцедуры

Функция ВидКонтрагента(КодВида)
	Если КодВида = "ИП" Тогда
		Возврат Перечисления.ВидКонтрагента.ИндивидуальныйПредприниматель;
	ИначеЕсли КодВида = "ФЛ" Тогда
		Возврат Перечисления.ВидКонтрагента.ФизическоеЛицо;
	КонецЕсли;
	Возврат Перечисления.ВидКонтрагента.ЮридическоеЛицо;
КонецФункции

