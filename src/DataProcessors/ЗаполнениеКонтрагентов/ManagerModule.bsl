Функция ЭлементДанных(Поставщик, Наименование, Вид, ИНН, КПП, ОГРН, ОКПО, ЮридическийАдрес, ФактическийАдрес, ПочтовыйАдрес, РасчетныйСчет, НомерБанка, ФИОРуководителя, НомерДоговора, ДатаЗаключения, ДатаДействия)
	Банк = БанкПоНомеру(НомерБанка);
	Результат = Новый Структура;
	Результат.Вставить("Поставщик", Поставщик);
	Результат.Вставить("Наименование", Наименование);
	Результат.Вставить("Вид", Вид);
	Результат.Вставить("ИНН", ИНН);
	Результат.Вставить("КПП", КПП);
	Результат.Вставить("ОГРН", ОГРН);
