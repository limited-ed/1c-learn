Процедура ВозвратИзРезерва() Экспорт
	ТекущаяДата = ТекущаяДата();
	
	РезервЗапрос = Новый Запрос("ВЫБРАТЬ
	|	РезервНоменклатуры.ДокументПродажа КАК ДокументПродажа
	|ИЗ
	|	РегистрНакопления.РезервНоменклатуры КАК РезервНоменклатуры
	|СГРУППИРОВАТЬ ПО
	|	РезервНоменклатуры.ДокументПродажа");
	
	Результат = РезервЗапрос.Выполнить().Выгрузить();
	
	Для Каждого Резерв Из Результат Цикл
		ДокументПродажа = Резерв.ДокументПродажа;
	   Если ДокументПродажа.СрокРезерва < ТекущаяДата() Тогда
	   		ДокументПродажа.ПолучитьОбъект().Записать(РежимЗаписиДокумента.ОтменаПроведения); 
	   КонецЕсли;	
	КонецЦикла;
	

	
КонецПроцедуры

