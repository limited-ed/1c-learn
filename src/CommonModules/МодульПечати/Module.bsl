// @strict-types


#Область ПрограммныйИнтерфейс

// Код процедур и функций
// Параметры:
// ДокументДляПечати - ТабличныйДокумент
&НаКлиенте
Процедура ВывестиДокумент(ДокументДляПечати, ИмяДокумента) Экспорт
	ДокументыДляПечати = СоздатьКоллекциюДокументовДляПечати();
	Строка = ДокументыДляПечати.Добавить();
	Строка.ИмяДокумента = ИмяДокумента;
	Строка.Документ = ДокументДляПечати;
	Форма = ПолучитьФорму("ОбщаяФорма.ПечатьДокументов");
	Форма.СписокДокументов = ДокументДляПечати;
	Форма.Открыть();
КонецПроцедуры


// Параметры:
// ДокументыДляПечати - ТаблицаЗначений
&НаКлиенте
Процедура ВывестиДокументы(ДокументыДляПечати) Экспорт
	Форма = ПолучитьФорму("ОбщаяФорма.ПечатьДокументов");
	Для Каждого СтрокаИсточника Из ДокументыДляПечати Цикл
		НоваяСтрока = Форма.СписокДокументов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточника);
	КонецЦикла;
	Форма.Открыть();
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Код процедур и функций

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Код процедур и функций
// Возвращаемое значение:
// ТаблицаЗначений
Функция СоздатьКоллекциюДокументовДляПечати() Экспорт
	ДокументыДляПечати = Новый ТаблицаЗначений();
	ДокументыДляПечати.Колонки.Добавить("ИмяДокумента", Новый ОписаниеТипов("Строка"));
	ДокументыДляПечати.Колонки.Добавить("Документ");
	
	Возврат ДокументыДляПечати;
КонецФункции

#КонецОбласти
