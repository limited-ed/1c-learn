#Область ПрограммныйИнтерфейс

Функция ПолучитьНДС() Экспорт
	Режим = Константы.РежимНалогообложения.Получить();
	Если Режим = Перечисления.РежимНалогооблажения.БезНДС Тогда
		Возврат 0;
	ИначеЕсли Режим = Перечисления.РежимНалогооблажения.НДС5 Тогда
		Возврат 5;
	ИначеЕсли Режим = Перечисления.РежимНалогооблажения.НДС10 Тогда
		Возврат 10;
	ИначеЕсли Режим = Перечисления.РежимНалогооблажения.НДС22 Тогда
		Возврат 22;
	КонецЕсли;
	Возврат 0;
КонецФункции

Функция СуммаНДС(СуммаСНДС, Ставка = Неопределено) Экспорт
	Если Ставка = Неопределено Тогда
		Ставка = ПолучитьНДС();
	КонецЕсли;
	Если ТипЗнч(Ставка) <> Тип("Число") Или Ставка <= 0 Или ТипЗнч(СуммаСНДС) <> Тип("Число") Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Окр(СуммаСНДС * Ставка / (100 + Ставка), 2);
КонецФункции

Функция ПредставлениеСтавкиНДС(Ставка) Экспорт
	Если ТипЗнч(Ставка) <> Тип("Число") Или Ставка <= 0 Тогда
		Возврат "без НДС";
	КонецЕсли;
	Возврат Формат(Ставка, "ЧГ=0") + "%";
КонецФункции

#КонецОбласти

