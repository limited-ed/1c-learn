#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция СтавкаНДФЛ() Экспорт
	
	Ставка = Константы.СтавкаНДФЛ.Получить();
	Если Ставка = 0 Тогда
		Возврат 13;
	КонецЕсли;
	Возврат Ставка;
	
КонецФункции

Функция РассчитатьСотрудника(Сотрудник, Период, Регистратор) Экспорт
	
	Если Не ЗначениеЗаполнено(Регистратор) Тогда
		Регистратор = Документы.НачислениеЗарплаты.ПустаяСсылка();
	КонецЕсли;
	
	Начисления = Новый Массив;
	Удержания = Новый Массив;
	Оплачено = ОплачиваемыеЧасы(Сотрудник, Период);
	Тариф = ТарифЧаса(Сотрудник);
	СуммаОсновного = Окр(Оплачено.Факт * Тариф, 2);
	Начисления.Добавить(Новый Структура(
		"ВидРасчета, ОтработаноЧасов, Тариф, Результат",
		ПланыВидовРасчета.Начисления.ОсновноеНачисление,
		Оплачено.Факт,
		Тариф,
		СуммаОсновного));
	
	Процент = Сотрудник.ПроцентОтПродаж;
	СуммаПроцента = Окр(СуммаПродаж(Сотрудник, Период) * Процент / 100, 2);
	Если Процент <> 0 Тогда
		Начисления.Добавить(Новый Структура(
			"ВидРасчета, ОтработаноЧасов, Тариф, Результат",
			ПланыВидовРасчета.Начисления.ПроцентОтПродаж,
			0,
			Процент,
			СуммаПроцента));
	КонецЕсли;
	
	База = СуммаОсновного + СуммаПроцента + СуммаНачислений(Сотрудник, Период, Регистратор);
	Для Каждого СтрокаУдержания Из УдержанияСотрудника(Сотрудник, База, СтавкаНДФЛ()) Цикл
		Удержания.Добавить(СтрокаУдержания);
	КонецЦикла;
	Возврат Новый Структура("Начисления, Удержания", Начисления, Удержания);
	
КонецФункции

Функция РассчитатьОтпуск(Сотрудник, НачалоОтпуска, КонецОтпуска) Экспорт
	
	Дней = КалендарныхДней(НачалоОтпуска, КонецОтпуска);
	ПредыдущийМесяц = ДобавитьМесяц(НачалоМесяца(НачалоОтпуска), -1);
	База = СуммаНачислений(Сотрудник, ПредыдущийМесяц, Документы.ПриказОтпуск.ПустаяСсылка());
	ДнейБазы = ОтработанныеДни(Сотрудник, ПредыдущийМесяц);
	Если ДнейБазы = 0 Тогда
		ДнейБазы = НормаДней(Сотрудник, ПредыдущийМесяц);
	КонецЕсли;
	
	Средний = 0;
	Если ДнейБазы > 0 Тогда
		Если База = 0 Тогда
			НормаЧасов = НормаЧасов(Сотрудник, ПредыдущийМесяц);
			Средний = ТарифЧаса(Сотрудник) * НормаЧасов / ДнейБазы;
		Иначе
			Средний = База / ДнейБазы;
		КонецЕсли;
	КонецЕсли;
	Возврат Новый Структура(
		"Дней, СреднийДневнойЗаработок, Сумма",
		Дней,
		Окр(Средний, 2),
		Окр(Средний * Дней, 2));
	
КонецФункции

Функция ОплачиваемыеЧасы(Сотрудник, Период) Экспорт
	
	Начало = НачалоМесяца(Период);
	Конец = КонецМесяца(Период);
	ФактПоДням = ЧасыТабеля(Сотрудник, Начало, Конец);
	Отсутствия = ДатыОтсутствия(Сотрудник, Начало, Конец);
	ПоДням = Новый Соответствие;
	Факт = 0;
	Дней = День(Конец);
	Для НомерДня = 1 По Дней Цикл
		ДатаДня = Дата(Год(Начало), Месяц(Начало), НомерДня);
		Часы = ФактПоДням.Получить(ДатаДня);
		Если Часы = Неопределено Или Отсутствия.Получить(ДатаДня) <> Неопределено Тогда
			Часы = 0;
		КонецЕсли;
		ПоДням.Вставить(ДатаДня, Часы);
		Факт = Факт + Часы;
	КонецЦикла;
	Возврат Новый Структура("ПоДням, Факт", ПоДням, Факт);
	
КонецФункции

Процедура ЗаписатьГрафик(Сотрудник, Период, ПоДням) Экспорт
	
	Начало = НачалоМесяца(Период);
	Дней = День(КонецМесяца(Период));
	Для НомерДня = 1 По Дней Цикл
		ДатаДня = Дата(Год(Начало), Месяц(Начало), НомерДня);
		Часы = ПоДням.Получить(ДатаДня);
		Если Часы = Неопределено Тогда
			Часы = 0;
		КонецЕсли;
		Запись = РегистрыСведений.ДанныеГрафикаРаботы.СоздатьМенеджерЗаписи();
		Запись.Сотрудник = Сотрудник;
		Запись.Дата = ДатаДня;
		Запись.Часы = Часы;
		Запись.Записать();
	КонецЦикла;
	
КонецПроцедуры

Функция СуммаНачислений(Сотрудник, Период, Регистратор) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Начисления.Результат), 0) КАК Сумма
	|ИЗ
	|	РегистрРасчета.Начисления КАК Начисления
	|ГДЕ
	|	Начисления.Сотрудник = &Сотрудник
	|	И Начисления.ПериодРегистрации = &Период
	|	И Начисления.Регистратор <> &Регистратор";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Период", НачалоМесяца(Период));
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Сумма;
	КонецЕсли;
	Возврат 0;
	
КонецФункции

Функция УдержанияСотрудника(Сотрудник, Начислено, Ставка) Экспорт
	
	Удержания = Новый Массив;
	Если Начислено = 0 Тогда
		Возврат Удержания;
	КонецЕсли;
	СуммаНДФЛ = Окр(Начислено * Ставка / 100, 2);
	Удержания.Добавить(Новый Структура(
		"ВидРасчета, Результат, База",
		ПланыВидовРасчета.Удержания.НДФЛ,
		СуммаНДФЛ,
		Начислено));
	ПроцентАлиментов = Сотрудник.ПроцентАлиментов;
	Если ПроцентАлиментов = 0 Тогда
		Возврат Удержания;
	КонецЕсли;
	БазаАлиментов = Начислено - СуммаНДФЛ;
	Если БазаАлиментов < 0 Тогда
		БазаАлиментов = 0;
	КонецЕсли;
	Удержания.Добавить(Новый Структура(
		"ВидРасчета, Результат, База",
		ПланыВидовРасчета.Удержания.Алименты,
		Окр(БазаАлиментов * ПроцентАлиментов / 100, 2),
		БазаАлиментов));
	Возврат Удержания;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТарифЧаса(Сотрудник)
	
	Если Не ЗначениеЗаполнено(Сотрудник) Или Не ЗначениеЗаполнено(Сотрудник.Должность) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Сотрудник.Должность.ТарифЧас;
	
КонецФункции

Функция График(Сотрудник)
	
	Если Не ЗначениеЗаполнено(Сотрудник) Или Не ЗначениеЗаполнено(Сотрудник.Должность) Тогда
		Возврат Справочники.ГрафикиРаботы.ПустаяСсылка();
	КонецЕсли;
	Возврат Сотрудник.Должность.ГрафикРаботы;
	
КонецФункции

Функция НормаЧасов(Сотрудник, Период)
	
	Возврат ЧасыГрафика(Сотрудник, Период).Часы;
	
КонецФункции

Функция НормаДней(Сотрудник, Период)
	
	Возврат ЧасыГрафика(Сотрудник, Период).Дни;
	
КонецФункции

Функция ЧасыГрафика(Сотрудник, Период)
	
	ГрафикСотрудника = График(Сотрудник);
	Часы = 0;
	Дни = 0;
	Если Не ЗначениеЗаполнено(ГрафикСотрудника) Тогда
		Возврат Новый Структура("Часы, Дни", Часы, Дни);
	КонецЕсли;
	Начало = НачалоМесяца(Период);
	ДнейМесяца = День(КонецМесяца(Период));
	РабочиеДаты = Справочники.ГрафикиРаботы.РабочиеДатыПредыдущегоМесяца(
		Сотрудник, Начало, Документы.ТабельРабочегоВремени.ПустаяСсылка());
	Для НомерДня = 1 По ДнейМесяца Цикл
		ДатаДня = Дата(Год(Начало), Месяц(Начало), НомерДня);
		ЧасыДня = Справочники.ГрафикиРаботы.ЧасыНаДату(ГрафикСотрудника, ДатаДня, РабочиеДаты);
		Если ЧасыДня = Неопределено Тогда
			ЧасыДня = 0;
		КонецЕсли;
		Часы = Часы + ЧасыДня;
		Если ЧасыДня > 0 Тогда
			Дни = Дни + 1;
			РабочиеДаты.Вставить(НачалоДня(ДатаДня), Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Часы, Дни", Часы, Дни);
	
КонецФункции

Функция ЧасыТабеля(Сотрудник, Начало, Конец)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Табель.Дата КАК Дата,
	|	СУММА(Табель.Часы) КАК Часы
	|ИЗ
	|	Документ.ТабельРабочегоВремени.Табель КАК Табель
	|ГДЕ
	|	Табель.Ссылка.Проведен
	|	И Табель.Сотрудник = &Сотрудник
	|	И Табель.Дата МЕЖДУ &Начало И &Конец
	|СГРУППИРОВАТЬ ПО
	|	Табель.Дата";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	ЧасыПоДням = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЧасыПоДням.Вставить(НачалоДня(Выборка.Дата), Выборка.Часы);
	КонецЦикла;
	Возврат ЧасыПоДням;
	
КонецФункции

Функция ДатыОтсутствия(Сотрудник, Начало, Конец)
	
	Даты = Новый Соответствие;
	ДобавитьИнтервалы(Даты, ИнтервалыБольничных(Сотрудник, Начало, Конец));
	ДобавитьИнтервалы(Даты, ИнтервалыОтпусков(Сотрудник, Начало, Конец));
	Возврат Даты;
	
КонецФункции

Функция ИнтервалыБольничных(Сотрудник, Начало, Конец)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Больничный.ДатаНачала КАК ДатаНачала,
	|	Больничный.ДатаОкончания КАК ДатаОкончания
	|ИЗ
	|	Документ.БольничныйЛист КАК Больничный
	|ГДЕ
	|	Больничный.Проведен
	|	И Больничный.Сотрудник = &Сотрудник
	|	И Больничный.ДатаНачала <= &Конец
	|	И Больничный.ДатаОкончания >= &Начало";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ИнтервалыОтпусков(Сотрудник, Начало, Конец)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Отпуск.НачалоПериода КАК ДатаНачала,
	|	Отпуск.КонецПериода КАК ДатаОкончания
	|ИЗ
	|	Документ.ПриказОтпуск КАК Отпуск
	|ГДЕ
	|	Отпуск.Проведен
	|	И Отпуск.Сотрудник = &Сотрудник
	|	И Отпуск.НачалоПериода <= &Конец
	|	И Отпуск.КонецПериода >= &Начало";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ДобавитьИнтервалы(Даты, Интервалы)
	
	Для Каждого Интервал Из Интервалы Цикл
		ДеньИнтервала = НачалоДня(Интервал.ДатаНачала);
		ПоследнийДень = НачалоДня(Интервал.ДатаОкончания);
		Пока ДеньИнтервала <= ПоследнийДень Цикл
			Даты.Вставить(ДеньИнтервала, Истина);
			ДеньИнтервала = НачалоДня(ДеньИнтервала + 86400);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция СуммаПродаж(Сотрудник, Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Продажа.СуммаДокумента), 0) КАК Сумма
	|ИЗ
	|	Документ.Продажа КАК Продажа
	|ГДЕ
	|	Продажа.Проведен
	|	И Продажа.Работник = &Сотрудник
	|	И Продажа.Дата МЕЖДУ &Начало И &Конец";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Начало", НачалоМесяца(Период));
	Запрос.УстановитьПараметр("Конец", КонецМесяца(Период));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Сумма;
	КонецЕсли;
	Возврат 0;
	
КонецФункции

Функция ОтработанныеДни(Сотрудник, Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Табель.Дата) КАК Дней
	|ИЗ
	|	Документ.ТабельРабочегоВремени.Табель КАК Табель
	|ГДЕ
	|	Табель.Ссылка.Проведен
	|	И Табель.Сотрудник = &Сотрудник
	|	И Табель.Дата МЕЖДУ &Начало И &Конец
	|	И Табель.Часы > 0";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Начало", НачалоМесяца(Период));
	Запрос.УстановитьПараметр("Конец", КонецМесяца(Период));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Дней;
	КонецЕсли;
	Возврат 0;
	
КонецФункции

Функция КалендарныхДней(НачалоОтпуска, КонецОтпуска)
	
	Если Не ЗначениеЗаполнено(НачалоОтпуска) Или Не ЗначениеЗаполнено(КонецОтпуска) Тогда
		Возврат 0;
	КонецЕсли;
	Если НачалоДня(КонецОтпуска) < НачалоДня(НачалоОтпуска) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат (НачалоДня(КонецОтпуска) - НачалоДня(НачалоОтпуска)) / 86400 + 1;
	
КонецФункции

#КонецОбласти

#КонецЕсли
