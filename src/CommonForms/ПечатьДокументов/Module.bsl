// @strict-types
#Область ОписаниеПеременных

#КонецОбласти

#Область ОбработчикиСобытийФормы
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если СписокДокументов.Количество() = 1 Тогда
		Элементы.СписокДокументов.ТекущаяСтрока = СписокДокументов.Получить(0);
		Элементы.СписокДокументов.Видимость = Ложь;
		Элементы.ФормаПечать.Видимость = Ложь;
		Элементы.ФормаПечатьТекущего.Заголовок = "Печать";
		ТекущийДокумент = СписокДокументов.Получить(0).Документ;
	Иначе
		Элементы.СписокДокументов.Видимость = Истина;;
		Элементы.ФормаПечать.Видимость = Истина;;
		Элементы.ФормаПечатьТекущего.Заголовок = "Печать текущего";		
	КонецЕсли;
КонецПроцедуры
#КонецОбласти
#Область ОбработчикиСобытийЭлементовШапкиФормы

// Код процедур и функций

#КонецОбласти
#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокДокументов
&НаКлиенте
Процедура СписокДокументовПриАктивизацииСтроки(Элемент)
	Если Элементы.СписокДокументов.ТекущиеДанные <> Неопределено Тогда
		ТекущийДокумент = Элементы.СписокДокументов.ТекущиеДанные.Документ;
	КонецЕсли;
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Печать(Команда)
	ПакетПечати = Новый ПакетОтображаемыхДокументов;
	Для Каждого Док Из СписокДокументов Цикл
		ЭлементПакета = ПакетПечати.Состав.Добавить();
		ЭлементПакета.Данные = ПоместитьВоВременноеХранилище(Док.Документ);
	КонецЦикла;
	ПакетПечати.Напечатать(РежимИспользованияДиалогаПечати.Использовать);

КонецПроцедуры

&НаКлиенте
Процедура ПечатьТекущего(Команда)
	ТекущийДокумент.Напечатать(РежимИспользованияДиалогаПечати.Использовать);
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВФайл(Команда)
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Выберите файл для сохранения";
	Если Элементы.СписокДокументов.ТекущаяСтрока <> Неопределено Тогда
		Диалог.ПолноеИмяФайла = Элементы.СписокДокументов.ТекущаяСтрока.ИмяДокумента;
	Иначе
		Сообщить("Выберите документ для сохранения");
	КонецЕсли;

     // Можно задать имя по умолчанию
	Диалог.Фильтр = "Microsoft Excel 2007(*.xlsx)|*.xlsx|Adobe PDF|*.pdf|Microsoft Word|*.docx";
	Диалог.МножественныйВыбор = Ложь;

	Если Диалог.Выбрать() Тогда
		ПутьКФайлу = Диалог.ПолноеИмяФайла;
		ФайлОбъект = Новый Файл(ПутьКФайлу);
		Расширение = ФайлОбъект.Расширение;
		Формат = ТипФайлаТабличногоДокумента.XLSX;
		Если НРег(Расширение) = ".pdf" Тогда
			Формат = ТипФайлаТабличногоДокумента.PDF;
		ИначеЕсли НРег(Диалог.Расширение) = ".docx" Тогда
			Формат = ТипФайлаТабличногоДокумента.DOCX;
		КонецЕсли;
		ТекущийДокумент.Записать(ПутьКФайлу, Формат);
        
        // Здесь код записи данных в файл по пути ПутьКФайлу
        // Например: ЗаписьТекста = Новый ЗаписьТекста(ПутьКФайлу);

	Иначе
		Возврат;
	КонецЕсли;
КонецПроцедуры
#КонецОбласти
#Область СлужебныеПроцедурыИФункции

// Код процедур и функций

#КонецОбласти