// @strict-types

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПолеГруппировки = Сотрудники.Группировка.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("Подразделение");
	ПолеГруппировки.Использование = Истина;
	ОчиститьПанельПользователя();
	
КонецПроцедуры

&НаКлиенте
Процедура СотрудникиПриАктивизацииСтроки(Элемент)
	ОбновитьПользователяИБ();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПривязатьПользователя(Команда)
	
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		ПоказатьПредупреждение(, "Выберите сотрудника.");
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПривязатьПользователяЗавершение", ЭтотОбъект);
	ОткрытьФорму(
		"ОбщаяФорма.ФормаВыбораПользователяИБ",
		,
		ЭтотОбъект,
		,
		,
		,
		Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПривязатьПользователяЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("УникальныйИдентификатор") Тогда
		Возврат;
	КонецЕсли;
	
	ПривязатьПользователяНаСервере(Результат);
	Элементы.Сотрудники.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПользователяИБ(Команда)
	СоздатьПользователяИБНаСервере();
	Элементы.Сотрудники.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура СменитьПароль(Команда)
	СменитьПарольНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРоль(Команда)
	
	СписокРолей = СписокРолейДляДобавления();
	Если СписокРолей.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Все роли конфигурации уже добавлены.");
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ДобавитьРольЗавершение", ЭтотОбъект);
	ПоказатьВыборИзСписка(Оповещение, СписокРолей, Элементы.Роли);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРольЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьРольНаСервере(ВыбранныйЭлемент.Значение);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьРоль(Команда)
	
	ТекущиеДанные = Элементы.Роли.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите роль, которую нужно удалить.");
		Возврат;
	КонецЕсли;
	
	УдалитьРольНаСервере(ТекущиеДанные.Роль);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьПользователяИБ()
	
	ТекущаяСтрока = Элементы.Сотрудники.ТекущаяСтрока;
	Если ТипЗнч(ТекущаяСтрока) <> Тип("СправочникСсылка.Сотрудники") Тогда
		Сотрудник = Справочники.Сотрудники.ПустаяСсылка();
		ОчиститьПанельПользователя();
		Возврат;
	КонецЕсли;
	
	Сотрудник = ТекущаяСтрока;
	Элементы.ГруппаПользовательИБ.Доступность = Истина;
	ЗаполнитьДанныеПользователяИБ();
	Если ПустаяСтрока(ИмяПользователя) Тогда
		ИмяПользователя = ИмяПользователяПоФИО(Сотрудник.Наименование);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьПользователяИБНаСервере()
	
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		СообщитьПользователю("Выберите сотрудника.");
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сотрудник.ИдентификаторПользователяИБ) Тогда
		СообщитьПользователю("Пользователь информационной базы уже привязан к сотруднику.");
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ИмяПользователя) Тогда
		ИмяПользователя = ИмяПользователяПоФИО(Сотрудник.Наименование);
	КонецЕсли;
	
	Если ПустаяСтрока(ИмяПользователя) Тогда
		СообщитьПользователю("Укажите ФИО сотрудника: из него составляется имя пользователя.");
		Возврат;
	КонецЕсли;
	
	Если Не ПарольПодтвержден() Тогда
		Возврат;
	КонецЕсли;
	
	Если ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя) <> Неопределено Тогда
		СообщитьПользователю("Пользователь с именем """ + ИмяПользователя + """ уже есть в информационной базе.");
		Возврат;
	КонецЕсли;
	
	ПользовательИБ = ПользователиИнформационнойБазы.СоздатьПользователя();
	ПользовательИБ.Имя = ИмяПользователя;
	ПользовательИБ.ПолноеИмя = Сотрудник.Наименование;
	ПользовательИБ.АутентификацияСтандартная = Истина;
	ПользовательИБ.ПоказыватьВСпискеВыбора = Истина;
	ПользовательИБ.Пароль = Пароль;
	НазначитьРолиПользователю(ПользовательИБ);
	
	Попытка
		ПользовательИБ.Записать();
	Исключение
		СообщитьПользователю("Не удалось создать пользователя. Нужны права администратора информационной базы.");
		Возврат;
	КонецПопытки;
	
	СотрудникОбъект = Сотрудник.ПолучитьОбъект();
	СотрудникОбъект.ИдентификаторПользователяИБ = ПользовательИБ.УникальныйИдентификатор;
	СотрудникОбъект.Записать();
	ОчиститьПароль();
	ЗаполнитьДанныеПользователяИБ();
	СообщитьПользователю("Создан пользователь " + ПользовательИБ.Имя + " и привязан к сотруднику.");
	
КонецПроцедуры

&НаСервере
Процедура ПривязатьПользователяНаСервере(ИдентификаторПользователя)
	
	СотрудникОбъект = Сотрудник.ПолучитьОбъект();
	СотрудникОбъект.ИдентификаторПользователяИБ = ИдентификаторПользователя;
	СотрудникОбъект.Записать();
	ЗаполнитьДанныеПользователяИБ();
	
КонецПроцедуры

&НаСервере
Процедура СменитьПарольНаСервере()
	
	ПользовательИБ = ТекущийПользовательИБ();
	Если ПользовательИБ = Неопределено Тогда
		СообщитьПользователю("Сначала создайте или привяжите пользователя информационной базы.");
		Возврат;
	КонецЕсли;
	
	Если Не ПарольПодтвержден() Тогда
		Возврат;
	КонецЕсли;
	
	ПользовательИБ.Пароль = Пароль;
	Попытка
		ПользовательИБ.Записать();
	Исключение
		СообщитьПользователю("Не удалось сменить пароль. Нужны права администратора информационной базы.");
		Возврат;
	КонецПопытки;
	
	ОчиститьПароль();
	СообщитьПользователю("Пароль пользователя " + ПользовательИБ.Имя + " изменен.");
	
КонецПроцедуры

&НаСервере
Функция СписокРолейДляДобавления()
	
	СписокРолей = Новый СписокЗначений;
	УжеДобавленные = Новый Соответствие;
	Для Каждого СтрокаРоли Из Роли Цикл
		УжеДобавленные.Вставить(СтрокаРоли.Роль, Истина);
	КонецЦикла;
	
	Для Каждого РольКонфигурации Из Метаданные.Роли Цикл
		Если УжеДобавленные.Получить(РольКонфигурации.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Представление = РольКонфигурации.Синоним;
		Если ПустаяСтрока(Представление) Тогда
			Представление = РольКонфигурации.Имя;
		КонецЕсли;
		СписокРолей.Добавить(РольКонфигурации.Имя, Представление);
	КонецЦикла;
	
	Возврат СписокРолей;
	
КонецФункции

&НаСервере
Процедура ДобавитьРольНаСервере(ИмяРоли)
	
	Если ПустаяСтрока(ИмяРоли) Тогда
		Возврат;
	КонецЕсли;
	
	Если Роли.НайтиСтроки(Новый Структура("Роль", ИмяРоли)).Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	РольМетаданных = Метаданные.Роли.Найти(ИмяРоли);
	Если РольМетаданных = Неопределено Тогда
		СообщитьПользователю("Роль """ + ИмяРоли + """ не найдена в конфигурации.");
		Возврат;
	КонецЕсли;
	
	ПользовательИБ = ТекущийПользовательИБ();
	Если ПользовательИБ <> Неопределено Тогда
		Если Не ПользовательИБ.Роли.Содержит(РольМетаданных) Тогда
			ПользовательИБ.Роли.Добавить(РольМетаданных);
			Попытка
				ПользовательИБ.Записать();
			Исключение
				СообщитьПользователю("Не удалось добавить роль. Нужны права администратора информационной базы.");
				Возврат;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	СтрокаРоли = Роли.Добавить();
	СтрокаРоли.Роль = ИмяРоли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьРольНаСервере(ИмяРоли)
	
	ПользовательИБ = ТекущийПользовательИБ();
	Если ПользовательИБ <> Неопределено Тогда
		РольМетаданных = Метаданные.Роли.Найти(ИмяРоли);
		Если РольМетаданных <> Неопределено И ПользовательИБ.Роли.Содержит(РольМетаданных) Тогда
			ПользовательИБ.Роли.Удалить(РольМетаданных);
			Попытка
				ПользовательИБ.Записать();
			Исключение
				СообщитьПользователю("Не удалось удалить роль. Нужны права администратора информационной базы.");
				Возврат;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	НайденныеСтроки = Роли.НайтиСтроки(Новый Структура("Роль", ИмяРоли));
	Для Каждого СтрокаРоли Из НайденныеСтроки Цикл
		Роли.Удалить(СтрокаРоли);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПользователяИБ()
	
	Роли.Очистить();
	ОчиститьПароль();
	ПользовательИБ = ТекущийПользовательИБ();
	ПоказатьПривязанногоПользователя(ПользовательИБ);
	УстановитьДоступностьСозданияПользователя();
	Если ПользовательИБ = Неопределено Тогда
		ИмяПользователя = "";
		Возврат;
	КонецЕсли;
	
	ИмяПользователя = ПользовательИБ.Имя;
	Для Каждого РольПользователя Из ПользовательИБ.Роли Цикл
		СтрокаРоли = Роли.Добавить();
		СтрокаРоли.Роль = РольПользователя.Имя;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьПривязанногоПользователя(ПользовательИБ)
	
	Если Не ЗначениеЗаполнено(Сотрудник.ИдентификаторПользователяИБ) Тогда
		ПривязанныйПользователь = "Не привязан";
		Возврат;
	КонецЕсли;
	
	Идентификатор = Строка(Сотрудник.ИдентификаторПользователяИБ);
	Если ПользовательИБ = Неопределено Тогда
		ПривязанныйПользователь = "Не найден, " + Идентификатор;
		Возврат;
	КонецЕсли;
	
	ПривязанныйПользователь = ПользовательИБ.Имя + ", " + Идентификатор;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьСозданияПользователя()
	
	Элементы.СоздатьПользователяИБ.Доступность = ЗначениеЗаполнено(Сотрудник)
		И Не ЗначениеЗаполнено(Сотрудник.ИдентификаторПользователяИБ);
	
КонецПроцедуры

&НаСервере
Функция ТекущийПользовательИБ()
	
	Если Не ЗначениеЗаполнено(Сотрудник.ИдентификаторПользователяИБ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Сотрудник.ИдентификаторПользователяИБ);
	
КонецФункции

&НаСервере
Процедура НазначитьРолиПользователю(ПользовательИБ)
	
	Для Каждого СтрокаРоли Из Роли Цикл
		РольМетаданных = Метаданные.Роли.Найти(СтрокаРоли.Роль);
		Если РольМетаданных <> Неопределено И Не ПользовательИБ.Роли.Содержит(РольМетаданных) Тогда
			ПользовательИБ.Роли.Добавить(РольМетаданных);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИмяПользователяПоФИО(ФИО)
	
	ЧастиФИО = СтрРазделить(СокрЛП(ФИО), " ", Ложь);
	Если ЧастиФИО.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяУчетнойЗаписи = ЧастиФИО[0];
	Если ЧастиФИО.Количество() > 1 Тогда
		ИмяУчетнойЗаписи = ИмяУчетнойЗаписи + Лев(ЧастиФИО[1], 1);
	КонецЕсли;
	Если ЧастиФИО.Количество() > 2 Тогда
		ИмяУчетнойЗаписи = ИмяУчетнойЗаписи + Лев(ЧастиФИО[2], 1);
	КонецЕсли;
	
	Возврат ИмяУчетнойЗаписи;
	
КонецФункции

&НаСервере
Функция ПарольПодтвержден()
	
	Если ПустаяСтрока(Пароль) Тогда
		СообщитьПользователю("Введите пароль.");
		Возврат Ложь;
	КонецЕсли;
	
	Если Пароль <> ПодтверждениеПароля Тогда
		СообщитьПользователю("Пароль и подтверждение не совпадают.");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ОчиститьПароль()
	
	Пароль = "";
	ПодтверждениеПароля = "";
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьПанельПользователя()
	
	Роли.Очистить();
	ИмяПользователя = "";
	ПривязанныйПользователь = "";
	ОчиститьПароль();
	Элементы.ГруппаПользовательИБ.Доступность = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура СообщитьПользователю(ТекстСообщения)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();
	
КонецПроцедуры

#КонецОбласти
