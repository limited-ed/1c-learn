#Область ОбработчикиСобытийФормы
 &НаСервере
 Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ЭтаФорма.Элементы.СтильКонфигурации.СписокВыбора.Очистить();
 	Для Каждого Стиль Из Метаданные.Стили Цикл
 		ЭтаФорма.Элементы.СтильКонфигурации.СписокВыбора.Добавить(Стиль.Имя, Стиль.Имя);
 	КонецЦикла;
 КонецПроцедуры
#КонецОбласти
 
  
&НаКлиенте
Процедура Перезапустить1С(Команда) 
	
	Если ЗначениеЗаполнено(СтильКонфигурации) Тогда	
		СохранитьСтильСервер();
		ЗавершитьРаботуСистемы(Истина, Истина,); 		
	КонецЕсли;	
	
КонецПроцедуры 

&НаСервере
Процедура СохранитьСтильСервер()

	ХранилищеОбщихНастроек.Сохранить("ус_Стиль", "ус_ИмяСтиля", СтильКонфигурации,, ПользователиИнформационнойБазы.ТекущийПользователь().Имя);

КонецПроцедуры


&НаСервере
Процедура СохранитьНаСервере()

	ХранилищеОбщихНастроек.Сохранить("ус_Стиль", "ус_ИмяСтиля", СтильКонфигурации,, ПользователиИнформационнойБазы.ТекущийПользователь().Имя);

КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда) 
	
	Если Модифицированность Тогда	
		Модифицированность = Ложь;		
	КонецЕсли; 
	
	СохранитьНаСервере();   
	
КонецПроцедуры


&НаСервере
Процедура СтильКонфигурацииПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(СтильКонфигурации) Тогда
		КартинкаСтиля = БиблиотекаКартинок[СтильКонфигурации];	
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура СтильКонфигурацииПриИзменении(Элемент)  
	
	СтильКонфигурацииПриИзмененииНаСервере();  
	
КонецПроцедуры
