// @strict-types

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьДиаграммуПродаж();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьДиаграммуПродаж()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Оплаты.Номенклатура КАК Номенклатура,
	|	Оплаты.Количество КАК Количество
	|ИЗ
	|	(ВЫБРАТЬ ПЕРВЫЕ 10
	|		ПродажаТовары.Номенклатура КАК Номенклатура,
	|		СУММА(ПродажаТовары.Количество) КАК Количество
	|	ИЗ
	|		Документ.Продажа.Товары КАК ПродажаТовары
	|	ГДЕ
	|		ПродажаТовары.Ссылка В
	|			(ВЫБРАТЬ
	|				ПодтверждениеОплаты.ДокументОснование
	|			ИЗ
	|				Документ.ПодтверждениеОплаты КАК ПодтверждениеОплаты
	|			ГДЕ
	|				ПодтверждениеОплаты.Проведен
	|				И НЕ ПодтверждениеОплаты.ПометкаУдаления)
	|		И ПродажаТовары.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	СГРУППИРОВАТЬ ПО
	|		ПродажаТовары.Номенклатура
	|	УПОРЯДОЧИТЬ ПО
	|		Количество УБЫВ) КАК Оплаты
	|УПОРЯДОЧИТЬ ПО
	|	Количество";

	Диаграмма = ДиаграммаПродаж;
	Диаграмма.Очистить();
	Диаграмма.Обновление = Ложь;
	Диаграмма.ТипДиаграммы = ТипДиаграммы.ГистограммаГоризонтальная;
	Диаграмма.ОтображатьЗаголовок = Истина;
	Диаграмма.ОбластьЗаголовка.Текст = "10 самых продаваемых товаров";
	Диаграмма.ОтображатьЛегенду = Ложь;
	Диаграмма.ВидПодписей = ВидПодписейКДиаграмме.Значение;

	Серия = Диаграмма.Серии.Добавить();
	Серия.Текст = "Количество";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Точка = Диаграмма.Точки.Добавить();
		Точка.Текст = Строка(Выборка.Номенклатура);
		Диаграмма.УстановитьЗначение(Точка, Серия, Выборка.Количество);
	КонецЦикла;

	Диаграмма.Обновление = Истина;

КонецПроцедуры

#КонецОбласти
