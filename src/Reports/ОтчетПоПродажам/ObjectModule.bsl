// @strict-types


#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	УстановитьПараметр(Настройки, "ОтборПоПродавцам", ЗаданСписокПродавцов(Настройки));
	УстановитьВидимостьДеталей(Настройки.Структура, ПоказыватьДетали(Настройки));
	КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаданСписокПродавцов(Настройки)

	ПараметрПродавцы = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Продавцы"));
	Если ПараметрПродавцы = Неопределено Или Не ПараметрПродавцы.Использование Тогда
		Возврат Ложь;
	КонецЕсли;

	ЗначениеПродавцов = ПараметрПродавцы.Значение;
	Возврат ТипЗнч(ЗначениеПродавцов) = Тип("СписокЗначений") И ЗначениеПродавцов.Количество() > 0;

КонецФункции

Функция ПоказыватьДетали(Настройки)

	ПараметрДетали = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДеталиПоПродавцу"));
	Если ПараметрДетали = Неопределено Или Не ПараметрДетали.Использование Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ПараметрДетали.Значение = Истина;

КонецФункции

Процедура УстановитьПараметр(Настройки, ИмяПараметра, ЗначениеПараметра)

	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(ИмяПараметра));
	Если Параметр = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Параметр.Значение = ЗначениеПараметра;
	Параметр.Использование = Истина;

КонецПроцедуры

Процедура УстановитьВидимостьДеталей(КоллекцияГруппировок, ПоказыватьДетали)

	Для Каждого ЭлементСтруктуры Из КоллекцияГруппировок Цикл
		Если ТипЗнч(ЭлементСтруктуры) <> Тип("ГруппировкаКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		Если ЭлементСтруктуры.Имя = "Детали" Тогда
			ЭлементСтруктуры.Использование = ПоказыватьДетали;
		КонецЕсли;
		УстановитьВидимостьДеталей(ЭлементСтруктуры.Структура, ПоказыватьДетали);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
