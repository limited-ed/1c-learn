#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция Сформировать() Экспорт
	
	Период = НачалоМесяца(ПериодРегистрации);
	Сотрудники = СотрудникиОтчета();
	Макет = ПолучитьМакет("РасчетныйЛист");
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.КлючПараметровПечати = "РасчетныйЛист";
	Если Сотрудники.Количество() = 0 Тогда
		ТабличныйДокумент.Область(1, 1).Текст = "Нет сотрудников по заданному отбору.";
		Возврат ТабличныйДокумент;
	КонецЕсли;
	Начисления = ДвиженияНачислений(Период, Сотрудники);
	Удержания = ДвиженияУдержаний(Период, Сотрудники);
	
	Первый = Истина;
	Для Каждого СтрокаСотрудника Из Сотрудники Цикл
		Если Не Первый Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		Первый = Ложь;
		ВывестиЛист(ТабличныйДокумент, Макет, СтрокаСотрудника, Период, Начисления, Удержания);
	КонецЦикла;
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СотрудникиОтчета()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Сотрудник,
	|	Сотрудники.Должность КАК Должность,
	|	Сотрудники.Подразделение КАК Подразделение
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	НЕ Сотрудники.ПометкаУдаления
	|	И (&ВсеРаботники
	|		ИЛИ Сотрудники.Ссылка = &Работник)
	|	И (&ВсеМагазины
	|		ИЛИ Сотрудники.Подразделение = &Магазин)
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудники.Наименование";
	Запрос.УстановитьПараметр("Работник", Работник);
	Запрос.УстановитьПараметр("ВсеРаботники", Не ЗначениеЗаполнено(Работник));
	Запрос.УстановитьПараметр("Магазин", Магазин);
	Запрос.УстановитьПараметр("ВсеМагазины", ЗначениеЗаполнено(Работник) Или Не ЗначениеЗаполнено(Магазин));
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ДвиженияНачислений(Период, Сотрудники)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Начисления.Сотрудник КАК Сотрудник,
	|	Начисления.ВидРасчета КАК ВидРасчета,
	|	Начисления.ОтработаноЧасов КАК Часы,
	|	Начисления.Результат КАК Сумма
	|ИЗ
	|	РегистрРасчета.Начисления КАК Начисления
	|ГДЕ
	|	Начисления.ПериодРегистрации = &Период
	|	И Начисления.Сотрудник В (&Сотрудники)
	|УПОРЯДОЧИТЬ ПО
	|	Начисления.Сотрудник,
	|	Начисления.ВидРасчета";
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Сотрудники", Сотрудники.ВыгрузитьКолонку("Сотрудник"));
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ДвиженияУдержаний(Период, Сотрудники)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Удержания.Сотрудник КАК Сотрудник,
	|	Удержания.ВидРасчета КАК ВидРасчета,
	|	Удержания.Результат КАК Сумма
	|ИЗ
	|	РегистрРасчета.Удержания КАК Удержания
	|ГДЕ
	|	Удержания.ПериодРегистрации = &Период
	|	И Удержания.Сотрудник В (&Сотрудники)
	|УПОРЯДОЧИТЬ ПО
	|	Удержания.Сотрудник,
	|	Удержания.ВидРасчета";
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Сотрудники", Сотрудники.ВыгрузитьКолонку("Сотрудник"));
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ВывестиЛист(ТабличныйДокумент, Макет, Сотрудник, Период, Начисления, Удержания)
	
	Шапка = Макет.ПолучитьОбласть("Шапка");
	Шапка.Параметры.Сотрудник = Строка(Сотрудник.Сотрудник);
	Шапка.Параметры.Должность = Строка(Сотрудник.Должность);
	Шапка.Параметры.Подразделение = Строка(Сотрудник.Подразделение);
	Шапка.Параметры.Период = Формат(Период, "ДФ='MMMM yyyy'");
	ТабличныйДокумент.Вывести(Шапка);
	
	Отбор = Новый Структура("Сотрудник", Сотрудник.Сотрудник);
	СтрокиНачислений = Начисления.НайтиСтроки(Отбор);
	СтрокиУдержаний = Удержания.НайтиСтроки(Отбор);
	СуммаНачислено = 0;
	СуммаУдержано = 0;
	КоличествоСтрок = Макс(СтрокиНачислений.Количество(), СтрокиУдержаний.Количество());
	Для Индекс = 0 По КоличествоСтрок - 1 Цикл
		ОбластьСтроки = Макет.ПолучитьОбласть("Строка");
		ОбластьСтроки.Параметры.Начисление = "";
		ОбластьСтроки.Параметры.Часы = "";
		ОбластьСтроки.Параметры.СуммаНачисления = "";
		ОбластьСтроки.Параметры.Удержание = "";
		ОбластьСтроки.Параметры.СуммаУдержания = "";
		Если Индекс < СтрокиНачислений.Количество() Тогда
			СтрокаНачисления = СтрокиНачислений[Индекс];
			ОбластьСтроки.Параметры.Начисление = Строка(СтрокаНачисления.ВидРасчета);
			Если СтрокаНачисления.Часы <> 0 Тогда
				ОбластьСтроки.Параметры.Часы = Формат(СтрокаНачисления.Часы, "ЧДЦ=2");
			КонецЕсли;
			ОбластьСтроки.Параметры.СуммаНачисления = Формат(СтрокаНачисления.Сумма, "ЧДЦ=2");
			СуммаНачислено = СуммаНачислено + СтрокаНачисления.Сумма;
		КонецЕсли;
		Если Индекс < СтрокиУдержаний.Количество() Тогда
			СтрокаУдержания = СтрокиУдержаний[Индекс];
			ОбластьСтроки.Параметры.Удержание = Строка(СтрокаУдержания.ВидРасчета);
			ОбластьСтроки.Параметры.СуммаУдержания = Формат(СтрокаУдержания.Сумма, "ЧДЦ=2");
			СуммаУдержано = СуммаУдержано + СтрокаУдержания.Сумма;
		КонецЕсли;
		ТабличныйДокумент.Вывести(ОбластьСтроки);
	КонецЦикла;
	
	Подвал = Макет.ПолучитьОбласть("Подвал");
	Подвал.Параметры.СуммаНачислено = Формат(СуммаНачислено, "ЧДЦ=2");
	Подвал.Параметры.СуммаУдержано = Формат(СуммаУдержано, "ЧДЦ=2");
	Подвал.Параметры.КВыплате = Формат(СуммаНачислено - СуммаУдержано, "ЧДЦ=2");
	ТабличныйДокумент.Вывести(Подвал);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
